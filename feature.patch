+
+describe("本人氏名の入力", () => {
+  it("前後だけtrimし、内部空白や表記は変更しない", () => {
+    const input = {
+      name: "　 Ａ子  太郎　 ",
+    };
+    expect(validateAccountNameInput(input)).toEqual({
+      success: true,
+      data: {
+        name: "Ａ子  太郎",
+      },
+    });
+    expect(input.name).toBe("　 Ａ子  太郎　 ");
+  });
+
+  it.each([
+    undefined,
+    null,
+    [],
+    "氏名",
+    {},
+    { name: undefined },
+    { name: null },
+    { name: 123 },
+    { name: "" },
+    { name: "　 \t\n " },
+    { name: new File(["個人情報"], "name.txt") },
+  ])("欠損・不正値を固定エラーにする %#", (input) => {
+    expect(validateAccountNameInput(input)).toEqual({
+      success: false,
+      fieldErrors: {
+        name: ["氏名を入力してください。"],
