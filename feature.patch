+// domain/club/account/account-types.ts
+// マイページの表示用情報と内部更新結果を、DBレコードやAuth Userから分離する。
+
+import type {
+  ClubMemberRole,
+  Grade,
+} from "@/types/prisma";
+
+import type {
+  ChildMembershipViolation,
+} from "./child-membership-policy";
+
+// 現在の子ども一覧と、本人が明示的に要求した追加候補で使う最小の表示情報。
+export type ClubAccountChildView = {
+  id: string;
+  name: string;
+  grade: Grade | null;
+};
+
+// 現在クラブの表示DTO。他クラブの所属詳細や親のIDは含めない。
+export type ClubAccountView = {
+  name: string | null;
+  authEmail: string | null;
+  appUserEmail: string | null;
+  club: {
+    name: string;
+    slug: string;
+    websiteUrl: string | null;
+    instagramUrl: string | null;
+  };
+  role: ClubMemberRole;
+  children: readonly ClubAccountChildView[];
+  canSwitchClub: boolean;
+  isPlatformAdmin: boolean;
+};
+
+export type ClubAccountReadResult =
+  | {
+      outcome: "FOUND";
+      view: ClubAccountView;
+    }
+  | {
+      outcome: "UNAVAILABLE" | "FETCH_FAILED";
+    };
+
+// 候補一覧は通常の表示DTOと分け、追加操作を開始したときだけ取得する。
+export type ClubAccountChildCandidatesResult =
+  | {
+      outcome: "FOUND";
+      children: readonly ClubAccountChildView[];
+    }
+  | {
+      outcome: "UNAVAILABLE" | "FETCH_FAILED";
+    };
+
+// 影響slugはサーバー内部の再検証用。Clientの入力やActionStateに流用しない。
+export type ClubAccountMutationResult =
+  | {
+      outcome: "UPDATED";
+      affectedClubSlugs: readonly string[];
+    }
+  | {
+      outcome: "NOT_FOUND" | "FORBIDDEN" | "CONFLICT" | "UPDATE_FAILED";
+    }
+  | {
+      outcome: "RULE_VIOLATION";
+      reason: ChildMembershipViolation;
+    };
