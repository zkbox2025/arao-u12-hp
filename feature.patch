+  it("入力にemailや親・クラブ・役割があっても成功値にコピーしない", () => {
+    const input = {
+      name: " 本人氏名 ",
+      email: "private@example.test",
+      parentId: "foreign-parent",
+      clubId: "foreign-club",
+      role: "OWNER",
+      status: "ACTIVE",
+    };
+    expect(validateAccountNameInput(input)).toEqual({
+      success: true,
+      data: {
+        name: "本人氏名",
+      },
+    });
