+// domain/club/event/event-practice-batch-policy.ts
+// F11の固定保存列を組み立て、既存の12列比較をイベントの値だけで再利用する。
+
+import {
+  buildEventMonthCopyKey, // コピー対象12列から決定的な比較値を作る関数
+  pickEventMonthCopyEvent, // コピーするイベントの必要列だけを検証・抽出する関数
+} from "./event-month-copy-policy";
+import type {
+  EventMonthCopyEvent, // コピー対象のイベント12列の型
+} from "./event-month-copy-types";
+import type {
+  EventPracticeBatchUtcDateTimes, // 終了必須の練習イベントが持つUTC日時型
+} from "./event-practice-batch-date-times";
+import {
+  validateEventPracticeBatchPreviewInput, // プレビュー準備段階の共通入力を検証・正規化する関数
+} from "./event-practice-batch-form";
+import type {
+  EventPracticeBatchCommonInput, // 検証・正規化した定期練習の共通入力値の型
+} from "./event-practice-batch-types";
+
+const INVALID_DATA_MESSAGE = "定期練習の内容を確認できません。";
+
+/**
+ * 共通入力と生成済みUTC日時からF11の比較・保存対象列を組み立て、Dateと配列を分離する。
+ * 公開状態・実行者・PDF等は含めず、genre・終日区分・本文等はサーバー側の固定値にする。
+ */
+export function buildEventPracticeBatchEvent( // F11の固定比較・保存列を組み立てる関数
+  input: EventPracticeBatchCommonInput, // 正規化した定期練習の共通入力型
+  dates: EventPracticeBatchUtcDateTimes, // 終了必須の練習イベントのUTC日時型
+): EventMonthCopyEvent { // コピー対象のイベント12列の型
+  try {
+    const validation = validateEventPracticeBatchPreviewInput(input); // 共通入力を検証・正規化する関数
+    if (!validation.success) {
+      throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+    }
+    const values = validation.data;
+    const event = pickEventMonthCopyEvent({ // コピー対象12列を検証・抽出する関数
+      title: values.title,
+      content: null,
+      genre: "PRACTICE",
+      targetRoles: values.targetRoles,
+      startAt: dates.startAt,
+      endAt: dates.endAt,
+      isAllDay: false,
+      location: values.location,
+      meetingAt: dates.meetingAt,
+      meetingLocation: values.meetingLocation,
+      belongings: null,
+      notes: null,
+    });
+    if (
+      event.endAt === null ||
+      event.endAt.getTime() <= event.startAt.getTime() // UTCミリ秒値を得るメソッド
+    ) {
+      throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+    }
+    return event;
+  } catch {
+    throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+  }
+}
+
+/**
+ * F11の生成イベントを既存イベントと比較するための内部キーを作る。Client返却・ログ用ではない。
+ * F10の候補型や複製元IDを作らず、比較対象の値だけを既存関数へ渡す。
+ */
+export function buildEventPracticeBatchKey( // F11の12列比較の内部キーを作る関数
+  input: EventPracticeBatchCommonInput, // 正規化した定期練習の共通入力型
+  dates: EventPracticeBatchUtcDateTimes, // 終了必須の練習イベントのUTC日時型
+): string { // 文字列型
+  try {
+    return buildEventMonthCopyKey(buildEventPracticeBatchEvent(input, dates)); // コピー対象12列から決定的な比較値を作る関数 / F11の固定比較・保存列を組み立てる関数
+  } catch {
+    throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+  }
+}
diff --git a/src/infrastructure/security/event-practice-batch-fingerprint.ts b/src/infrastructure/security/event-practice-batch-fingerprint.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a18f2284757971af8f1a82ce8048d8125fd056c9
--- /dev/null
+++ b/src/infrastructure/security/event-practice-batch-fingerprint.ts
@@ -0,0 +1,278 @@
+// src/infrastructure/security/event-practice-batch-fingerprint.ts
+// F11のpreviewと送信内容を、用途・版・認可scopeを分けたSHA-256へ変換する。
+
+import "server-only";
+
+import { createHash } from "node:crypto";
+import { z } from "zod";
+
+import type {
+  EventPracticeBatchDateTimeCandidate, // 現地日付と生成日時または除外理由を持つ候補型
+} from "@/domain/club/event/event-practice-batch-date-times";
+import {
+  validateEventPracticeBatchInput, // 保存段階の入力値を検証・正規化する関数
+  validateEventPracticeBatchPreviewInput, // プレビュー準備段階の共通入力を検証・正規化する関数
+} from "@/domain/club/event/event-practice-batch-form";
+import {
+  buildEventPracticeBatchKey, // F11の固定列を組み立て、12列比較の内部キーを作る関数
+} from "@/domain/club/event/event-practice-batch-policy";
+import {
+  EVENT_PRACTICE_BATCH_MAX_COUNT, // 定期練習作成の最大件数31件
+  type EventPracticeBatchCommonInput, // 検証・正規化した定期練習の共通入力値の型
+  type EventPracticeBatchExclusionReason, // 練習イベントを作成できない日時の理由の型
+  type EventPracticeBatchInput, // 共通入力に選択日と操作識別子を加えた保存入力型
+} from "@/domain/club/event/event-practice-batch-types";
+import {
+  isValidTimeZone, // タイムゾーンが正しく利用できるかを検証する関数
+} from "@/domain/shared/date-time/club-local-date-time";
+
+// 比較列・正規化・照合の意味を変更するときは、保存済み操作との互換性を確認して版を上げる。
+const FORMAT_VERSION = 1;
+const INVALID_DATA_MESSAGE = "定期練習の照合内容を確認できません。";
+const identifierSchema = z.uuid(); // UUID識別子のスキーマを作る関数
+const warningsSchema = z.array(z.literal("MEETING_AFTER_START")).max(1); // 上限を制限するメソッド / 配列のスキーマを作る関数 / 固定値のスキーマを作る関数
+const exclusionSchema = z.enum([ // 許可値のスキーマを作る関数
+  "NONEXISTENT_LOCAL_TIME",
+  "AMBIGUOUS_LOCAL_TIME",
+  "INVALID_INTERVAL",
+  "OUT_OF_RANGE",
+  "INVALID_DATE_TIME",
+]);
+
+/**
+ * 最新認可から得るクラブ・実行所属・Auth本人の識別情報。Client指定値の認可には使わない。
+ */
+export type EventPracticeBatchFingerprintScope = { // 認可済みクラブ・所属・本人の識別情報型
+  clubId: string; // 文字列型
+  membershipId: string; // 文字列型
+  userId: string; // 文字列型
+};
+
+/**
+ * 生成候補にDBで調べた既存完全一致の代表IDを加えた、サーバー内部だけの照合素材。
+ */
+export type EventPracticeBatchFingerprintCandidate = EventPracticeBatchDateTimeCandidate & { // 既存完全一致の代表IDを加えた内部候補型 / 現地日付と生成日時または除外理由の候補型
+  duplicateEventId: string | null; // 文字列型 / 未設定を表すnull型
+};
+
+/**
+ * 共通入力・現在のtimezone・全候補を認可scopeへ結び付けるpreview照合入力。
+ */
+export type EventPracticeBatchFingerprintInput = EventPracticeBatchFingerprintScope & { // scope・共通入力・timezone・全候補の照合入力型 / 認可済みクラブ・所属・本人の識別情報型
+  input: EventPracticeBatchCommonInput; // 正規化した定期練習の共通入力型
+  timezone: string; // 文字列型
+  candidates: readonly EventPracticeBatchFingerprintCandidate[]; // 既存完全一致の代表IDを加えた内部候補型
+};
+
+/**
+ * UUIDの形式を検証し、scopeと既存イベントIDの大小文字差を取り除く。
+ */
+function identifier(value: string): string { // UUIDを検証し小文字へ正規化する関数 / 文字列型
+  if (
+    typeof value !== "string" ||
+    value.length !== 36 ||
+    !identifierSchema.safeParse(value).success // 検証成功と検証エラーを結果で返すメソッド
+  ) {
+    throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+  }
+  return value.toLowerCase(); // 小文字へ変換するメソッド
+}
+
+/**
+ * 最新認可の識別子を固定順・小文字UUIDにする。
+ */
+function scopeValues(scope: EventPracticeBatchFingerprintScope): readonly string[] { // 認可scopeの識別子を固定順へ揃える関数 / 認可済みクラブ・所属・本人の識別情報型 / 文字列型
+  return [
+    identifier(scope.clubId), // UUIDを検証し小文字へ正規化する関数
+    identifier(scope.membershipId), // UUIDを検証し小文字へ正規化する関数
+    identifier(scope.userId), // UUIDを検証し小文字へ正規化する関数
+  ];
+}
+
+/**
+ * 検証・正規化した全共通fieldを固定順の値へ写し、独自toJSONや余分な入力を素材へ入れない。
+ */
+function commonValues(input: EventPracticeBatchCommonInput): readonly unknown[] { // 全共通fieldを固定順の値へ写す関数 / 正規化した定期練習の共通入力型 / 型未確定の内部素材を表す型
+  return [
+    input.targetMonth,
+    input.periodStart,
+    input.periodEnd,
+    [...input.weekdays],
+    input.title,
+    input.startTime,
+    input.endTime,
+    input.location,
+    input.meetingTime,
+    input.meetingLocation,
+    [...input.targetRoles],
+  ];
+}
+
+/**
+ * 候補IDを、入力期間内かつ選択曜日に合う実在の現地YYYY-MM-DDとして検証する。
+ * 候補集合の再生成・DB照合・認可は、保存時に後続のServiceとRepositoryが行う。
+ */
+function candidateDate( // 候補の現地日付・期間・曜日を検証する関数
+  value: string, // 文字列型
+  input: EventPracticeBatchCommonInput, // 正規化した定期練習の共通入力型
+): string { // 文字列型
+  if (
+    typeof value !== "string" ||
+    value.length !== 10 ||
+    !/^\d{4}-\d{2}-\d{2}$/.test(value) || // 正規表現との一致を検証するメソッド
+    value.slice(0, 7) !== input.targetMonth || // 文字列や配列の指定範囲を得るメソッド
+    value < input.periodStart ||
+    value > input.periodEnd
+  ) {
+    throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+  }
+  const calendar = new Date(`${value}T00:00:00.000Z`); // 日時を生成するコンストラクター
+  if (
+    !Number.isFinite(calendar.getTime()) || // 有限の数値かを確認する関数 / UTCミリ秒値を得るメソッド
+    calendar.toISOString().slice(0, 10) !== value || // 文字列や配列の指定範囲を得るメソッド / UTC ISO文字列へ変換するメソッド
+    !input.weekdays.some( // 条件に合う要素の有無を調べるメソッド
+      /**
+       * 保存用UTC日付ではなく、現地カレンダーの曜日番号と比較する。
+       */
+      (weekday) => weekday === calendar.getUTCDay(), // 検証・変換に使うコールバック / UTCカレンダーの曜日番号を得るメソッド
+    )
+  ) {
+    throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+  }
+  return value;
+}
+
+/**
+ * F11固有の用途・版・PREVIEW／INPUT区分を含む、固定順の素材からSHA-256だけを返す。
+ */
+function digest( // 用途・版を含む素材からSHA-256を計算する関数
+  kind: "PREVIEW" | "INPUT", // 用途を限定するリテラル型
+  payload: readonly unknown[], // 型未確定の内部素材を表す型
+): string { // 文字列型
+  return createHash("sha256") // SHA-256の計算器を作る関数
+    .update(JSON.stringify([ // UTF-8素材をhashへ加えるメソッド / 値を固定順のJSON文字列へ変換する関数
+      "F11_CREATE_PRACTICE_BATCH",
+      FORMAT_VERSION,
+      kind,
+      payload,
+    ]), "utf8")
+    .digest("hex"); // SHA-256を16進文字列で得るメソッド
+}
+
+/**
+ * 全候補の日時・除外・警告・既存一致を含む、現在のpreview内容のfingerprintを計算する。
+ * 既存IDと内部比較キーは返さず、認可や改ざん防止の署名の代わりにはしない。
+ */
+export function buildEventPracticeBatchFingerprint( // 全preview候補の照合hashを計算する関数
+  input: EventPracticeBatchFingerprintInput, // scope・共通入力・timezone・全候補の照合入力型
+): string { // 文字列型
+  try {
+    const common = input.input;
+    const timezone = input.timezone;
+    const candidates = input.candidates;
+    const validated = validateEventPracticeBatchPreviewInput(common); // 共通入力を検証・正規化する関数
+    if (
+      !validated.success ||
+      !isValidTimeZone(timezone) || // 利用可能なtimezoneを検証する関数
+      !Array.isArray(candidates) || // 配列かを確認する関数
+      candidates.length > EVENT_PRACTICE_BATCH_MAX_COUNT
+    ) {
+      throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+    }
+    const values = validated.data;
+    const seen = new Set<string>(); // 重複しない集合を作るコンストラクター / 文字列型
+    const rows: {
+      date: string; // 文字列型
+      value: readonly unknown[]; // 型未確定の内部素材を表す型
+    }[] = [];
+    for (const candidate of candidates) {
+      const date = candidateDate(candidate.date, values); // 候補の現地日付・期間・曜日を検証する関数
+      if (seen.has(date)) { // 集合内の有無を確認するメソッド
+        throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+      }
+      seen.add(date); // 集合へ値を記録するメソッド
+      const warnings = warningsSchema.safeParse(candidate.warnings); // 検証成功と検証エラーを結果で返すメソッド
+      if (!warnings.success) {
+        throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+      }
+      const dates = candidate.dates;
+      const reason = candidate.exclusionReason;
+      const duplicateEventId = candidate.duplicateEventId;
+      let eventKey: string | null = null; // 文字列型 / 未設定を表すnull型
+      let exclusionReason: EventPracticeBatchExclusionReason | null = null; // 練習日時を作成できない理由の型 / 未設定を表すnull型
+      if (dates === null) {
+        const exclusion = exclusionSchema.safeParse(reason); // 検証成功と検証エラーを結果で返すメソッド
+        if (
+          !exclusion.success ||
+          duplicateEventId !== null
+        ) {
+          throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+        }
+        exclusionReason = exclusion.data;
+      } else {
+        if (reason !== null) {
+          throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+        }
+        eventKey = buildEventPracticeBatchKey(values, dates); // F11の12列比較の内部キーを作る関数
+      }
+      rows.push({ // 配列へ値を加えるメソッド
+        date,
+        value: [
+          date,
+          eventKey,
+          exclusionReason,
+          warnings.data,
+          duplicateEventId === null ? null : identifier(duplicateEventId), // UUIDを検証し小文字へ正規化する関数
+        ],
+      });
+    }
+    rows.sort( // 配列を並べ替えるメソッド
+      /**
+       * 候補の取得順による差をなくし、現地日付の昇順へ揃える。
+       */
+      (left, right) => { // 候補を現地日付順で比較するコールバック
+        if (left.date === right.date) {
+          return 0;
+        }
+        return left.date < right.date ? -1 : 1;
+      },
+    );
+    return digest("PREVIEW", [ // 用途・版を含む素材からSHA-256を計算する関数
+      scopeValues(input), // 認可scopeの識別子を固定順へ揃える関数
+      commonValues(values), // 全共通fieldを固定順の値へ写す関数
+      timezone,
+      rows.map( // 各要素を変換するメソッド
+        /**
+         * サーバー内部の必要な値だけをhashへ渡す。
+         */
+        (row) => row.value, // 検証・変換に使うコールバック
+      ),
+    ]);
+  } catch {
+    throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+  }
+}
+
+/**
+ * 送信済みfingerprint・正規化共通入力・選択日だけをscopeへ結び付け、実行inputHashを作る。
+ * requestIdはledgerの一意キーで扱い、現在のDB・timezone・候補から再計算しない。
+ */
+export function buildEventPracticeBatchInputHash( // 送信済み入力の照合hashを計算する関数
+  scope: EventPracticeBatchFingerprintScope, // 認可済みクラブ・所属・本人の識別情報型
+  input: EventPracticeBatchInput, // 共通入力・選択日・操作識別子の保存入力型
+): string { // 文字列型
+  try {
+    const validated = validateEventPracticeBatchInput(input); // 保存入力を検証・正規化する関数
+    if (!validated.success) {
+      throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+    }
+    return digest("INPUT", [ // 用途・版を含む素材からSHA-256を計算する関数
+      scopeValues(scope), // 認可scopeの識別子を固定順へ揃える関数
+      commonValues(validated.data), // 全共通fieldを固定順の値へ写す関数
+      validated.data.selectedDates,
+      validated.data.previewFingerprint,
+    ]);
+  } catch {
+    throw new Error(INVALID_DATA_MESSAGE); // 原文やcauseを含めない固定例外のコンストラクター
+  }
+}
diff --git a/tests/event-practice-batch-fingerprint.test.ts b/tests/event-practice-batch-fingerprint.test.ts
