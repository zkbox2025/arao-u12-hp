diff --git a/docs/implementation/phases/F11.md b/docs/implementation/phases/F11.md
index 2418b665e45c6483ecfc3e20d38d26f5a0ba33bd..54a699ba716a1585e59fe7fe8d5923cc175d0fd8 100644
--- a/docs/implementation/phases/F11.md
+++ b/docs/implementation/phases/F11.md
@@ -37,3 +37,66 @@ MVP 1.0での推奨仕様
 * 前月複製と定期練習一括作成で共有する部分・分ける部分
 * 日付列挙の純粋関数とDB transactionの境界
 * previewと実保存の入力hashを一致させる理由
+
+【追加：粒度1】仕様補足・入力・preview／結果契約
+
+ユーザー確定事項
+* 対象期間は、管理者一覧で選んだ同じ対象月内の開始日〜終了日に限定する。
+  両端を含め、画面の初期値はその月全体とする。月跨ぎの任意31日間にはしない。
+* 終了時刻は必須で、同日の開始時刻より後だけを許可する。
+  同時刻・逆転・翌日への自動送りは認めず、翌日終了は通常編集で対応する。
+* 既存イベントとの完全一致は初期未選択とし、明示選択された場合は作成を許可する。
+
+この入力契約で採用する補足
+* 通常の時刻付き練習だけを扱い、生成時のisAllDayはfalseに固定する。
+  content・belongings・notesはnullとする。終日・本文等の追加入力は含めない。
+* 共通入力はtargetMonth・periodStart・periodEnd・weekdays・title・startTime・endTime・
+  location・meetingTime・meetingLocation・targetRolesとする。
+  保存専用のselectedDates・requestId・previewFingerprintとは分ける。
+* targetMonthは西暦1〜9999年の単一YYYY-MM文字列、期間は実在するYYYY-MM-DD。
+  年0・不正月・配列・余分な空白や改行を拒否し、現在月へfallbackしない。
+  F11は前月を使わないため0001-01も入力契約で許可する。
+  現在のF10 ledgerの0001-01拒否との整合は、後続の操作別DB制約で扱う。
+* 曜日は日曜0〜土曜6。共通入力のオブジェクトは数値、FormDataでは単一桁の文字列を受ける。
+  反復数は正規化前に1〜7個へ制限し、重複除去・数値昇順にする。
+* タイトルはtrim後1〜120文字、場所・集合場所はtrim後200文字以内。
+  任意文字列の未指定・空欄はnull、超過は切り捨てず拒否する。
+  文字数の正本は既存event-form.tsの定数とする。
+* 時刻はHH:mm形式。集合時刻は各発生日の同日の任意入力で、未指定・空欄はnull。
+  開始後の集合も入力として許容し、後続previewで警告する。前日集合の入力は含めない。
+* 公開対象はOWNERを常に含め、COACH・OFFICER・MEMBERを追加選択できる。
+  OWNERだけも有効。不正roleを拒否した後、既存buildContentTargetRolesで重複・順序を揃える。
+  role入力の反復は正規化前に最大4個。任意roleを選ばないFormDataはOWNERだけになる。
+* 選択日は実在する日付の配列で1〜31件。重複と入力期間外を拒否し、昇順へ正規化する。
+  元イベントUUIDやClient指定のUTC日時を選択値にしない。
+* requestIdは既存isRequestIdで検証するUUID v4、previewFingerprintは64桁16進文字列。
+  どちらも小文字へ正規化する。この検証は識別子の真正性・保存済み判定を保証しない。
+* FormDataの反復項目はweekdays・targetRolesと、保存時のselectedDatesだけ。
+  単一項目の重複は同じ値でも拒否する。File値・未許可項目も拒否する。
+  Nextが付ける$ACTION_接頭辞の輸送用項目は業務入力として利用しない。
+* clientからclubId・実行者・genre・status・isAllDay・公開日時・本文・通知指定・
+  任意遷移先・生成済みUTC値を受け取らない。固定値でも入力への混入は拒否する。
+* preview用validatorは保存専用項目を受け取らない。保存用validatorは共通入力を再検証する。
+  正規化済み入力を再検証しても値が変わらないようにする。
+  エラーには入力値、未許可キー名、ネイティブ検証message、生Error・causeを含めない。
+
+限定DTOと結果の契約
+* previewはREADY（候補0件も含む）・TOO_MANY・FORBIDDEN・PREVIEW_FAILEDを区別する。
+  正規化共通入力、timezone、fingerprint、候補日・UTC ISO日時・除外理由・警告・
+  既存一致フラグ・初期選択、候補件数・選択可能件数を持つ。
+  既存イベントの本文・全モデル・既存IDをClientへ返す契約にはしない。
+* 日時変換不能・曖昧な現地時刻・存在しない現地時刻・期間逆転等は、
+  後続の生成処理で理由付きの選択不可候補にする。31件上限は除外前の候補数にも適用する。
+* 実行結果はCREATED・ALREADY_COMPLETED・VALIDATION_FAILED・FORBIDDEN・PREVIEW_CHANGED・
+  CONFLICT・CREATE_FAILED・RESULT_UNKNOWN。成功receiptは対象月と作成件数だけとする。
+* previewと保存のAction stateを分ける。statusとoutcomeで成功・拒否・結果不明を区別し、
+  成功時だけ必須のdataを持つ。保存済みsuccessのneedsReloadは一覧再読込の案内に使う。
+  メッセージ文字列を比較して結果不明と再preview可否を判別する契約にはしない。
+
+粒度1で保証しないもの
+* この粒度は入力構造と限定結果の契約だけ。画面・Action・候補日列挙・UTC変換・
+  hash生成・DB・Prisma・認証認可・保存は未接続で、DB変更は発生しない。
+* 選択日が曜日条件と一致するか、DST等で生成可能か、既存完全一致か、
+  fingerprintが現在のpreviewと一致するかは後続で再照合する。
+* 最新の本人・ACTIVE所属・管理ロール・プラン・他クラブ防止・同操作の冪等性は、
+  後続のAction・Service・Repository・DB制約で保証する。
diff --git a/domain/club/event/event-practice-batch-form.ts b/domain/club/event/event-practice-batch-form.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9eae759952de88545f76faebe2008e5e9ae16550
--- /dev/null
+++ b/domain/club/event/event-practice-batch-form.ts
@@ -0,0 +1,487 @@
+// domain/club/event/event-practice-batch-form.ts
+// preview共通入力と保存入力を検証し、日付・時刻・選択・識別子の構造だけを保証する。
+
+import { z } from "zod";
+
+import {
+  buildContentTargetRoles, // OWNERを常に含め、正しいロールを既存の順序に正規化する関数
+} from "@/domain/club/content/content-policy";
+import {
+  EVENT_LOCATION_MAX_LENGTH, // イベント開催場所の最大文字数
+  EVENT_TITLE_MAX_LENGTH, // イベントタイトルの最大文字数
+} from "@/domain/club/event/event-form";
+import type {
+  FieldErrors, // 項目ごとの安全なエラーメッセージを保持する型
+} from "@/domain/shared/action-state";
+import {
+  isRequestId, // UUID v4形式の操作IDかを検証する関数。認証・認可の代用にしない
+} from "@/domain/shared/request-id";
+import type {
+  ClubMemberRole, // Prisma由来のクラブ所属ロール型
+} from "@/types/prisma";
+import {
+  EVENT_PRACTICE_BATCH_MAX_COUNT, // 除外前候補と選択の最大件数31件
+  type EventPracticeBatchCommonInput, // 構造検証・正規化済みの共通入力型
+  type EventPracticeBatchField, // previewと実行入力の項目名型
+  type EventPracticeBatchInput, // 共通入力・選択日・操作識別子をまとめた型
+  type EventPracticeBatchValidation, // 正規化済み入力と安全なエラーを分ける結果型
+  type EventPracticeBatchWeekday, // 日曜0〜土曜6の曜日型
+} from "./event-practice-batch-types";
+
+const INVALID_FORM = "定期練習の入力を確認してください。";
+const COMMON_FIELDS = new Set([ // 重複しない集合を作るコンストラクター
+  "targetMonth",
+  "periodStart",
+  "periodEnd",
+  "weekdays",
+  "title",
+  "startTime",
+  "endTime",
+  "location",
+  "meetingTime",
+  "meetingLocation",
+  "targetRoles",
+]);
+const EXECUTION_FIELDS = new Set([ // 重複しない集合を作るコンストラクター
+  ...COMMON_FIELDS,
+  "selectedDates",
+  "requestId",
+  "previewFingerprint",
+]);
+const FIELD_MESSAGES: Record<EventPracticeBatchField, string> = { // キーと値の対応を表す型 / 入力項目名型 / 文字列型
+  targetMonth: "対象月を西暦1〜9999年のYYYY-MM形式で指定してください。",
+  periodStart: "対象月内の実在する開始日を指定してください。",
+  periodEnd: "対象月内で開始日以降の終了日を指定してください。",
+  weekdays: "曜日を日曜0〜土曜6で1〜7個指定してください。",
+  title: `タイトルを1〜${EVENT_TITLE_MAX_LENGTH}文字で入力してください。`,
+  startTime: "開始時刻をHH:mm形式で入力してください。",
+  endTime: "同日の開始時刻より後の終了時刻をHH:mm形式で入力してください。",
+  location: `場所は${EVENT_LOCATION_MAX_LENGTH}文字以内で入力してください。`,
+  meetingTime: "集合時刻はHH:mm形式で入力するか、未設定にしてください。",
+  meetingLocation: `集合場所は${EVENT_LOCATION_MAX_LENGTH}文字以内で入力してください。`,
+  targetRoles: "公開対象に正しいクラブ所属ロールを指定してください。",
+  selectedDates: "期間内の実在する日付を1〜31件、重複なしで選択してください。",
+  requestId: "操作の識別値が不正です。再previewしてください。",
+  previewFingerprint: "生成予定の識別値が不正です。再previewしてください。",
+};
+
+/**
+ * 前月を必要としないF11の対象月を、空白を補正せず厳密に検証する。
+ */
+export function isEventPracticeBatchTargetMonth( // F11の対象月を厳密に検証する関数
+  value: unknown, // 未検証の値を表す型
+): value is string { // 文字列型への絞り込み
+  return (
+    typeof value === "string" &&
+    value.length === 7 &&
+    /^\d{4}-(0[1-9]|1[0-2])$/.test(value) && // 正規表現との一致を検証するメソッド
+    !value.startsWith("0000-") // 接頭辞を判定するメソッド
+  );
+}
+
+/**
+ * UTC変換や候補列挙を行わず、西暦1〜9999年の実在日だけを検証する。
+ */
+function isDateOnly( // 西暦1〜9999年の実在日を検証する関数
+  value: string, // 文字列型
+): boolean { // 真偽値型
+  if (
+    value.length !== 10 ||
+    !/^\d{4}-\d{2}-\d{2}$/.test(value) // 正規表現との一致を検証するメソッド
+  ) {
+    return false;
+  }
+  const year = Number(value.slice(0, 4)); // 値を数値へ変換する関数 / 指定範囲を取り出すメソッド
+  const month = Number(value.slice(5, 7)); // 値を数値へ変換する関数 / 指定範囲を取り出すメソッド
+  const day = Number(value.slice(8, 10)); // 値を数値へ変換する関数 / 指定範囲を取り出すメソッド
+  const leap = (
+    year % 4 === 0 &&
+    (
+      year % 100 !== 0 ||
+      year % 400 === 0
+    )
+  );
+  const lastDay = month === 2
+    ? (leap ? 29 : 28)
+    : [4, 6, 9, 11].includes(month) // 要素の包含を判定するメソッド
+      ? 30
+      : 31;
+  return (
+    year >= 1 &&
+    month >= 1 &&
+    month <= 12 &&
+    day >= 1 &&
+    day <= lastDay
+  );
+}
+
+/**
+ * 文字列を小文字へ揃え、UUIDとfingerprintの表記差を除く。
+ */
+function lowercase( // 識別子を小文字へ揃える関数
+  value: string, // 文字列型
+): string { // 文字列型
+  return value.toLowerCase(); // 小文字へ変換するメソッド
+}
+
+/**
+ * 任意文字列をtrimし、空欄を未設定のnullに揃える。
+ */
+function optionalValue( // 任意文字列と空欄を正規化する関数
+  value: string | null, // 文字列型 / 未設定を表すnull型
+): string | null { // 文字列型 / 未設定を表すnull型
+  return value === null ? null : value.trim() || null; // 前後の空白を除くメソッド
+}
+
+/**
+ * 検証済みの0〜6の曜日を、重複なしの数値昇順へ正規化する。
+ */
+function normalizeWeekdays( // 曜日を重複なしの昇順へ揃える関数
+  value: number[], // 数値型
+): EventPracticeBatchWeekday[] { // クラブ現地の曜日型
+  return [...new Set(value)].sort( // 配列を並べ替えるメソッド / 重複しない集合を作るコンストラクター
+    /**
+     * 曜日番号を小さい順に比較する。
+     */
+    (left, right) => left - right, // 検証や試験に使うコールバック
+  ) as EventPracticeBatchWeekday[]; // クラブ現地の曜日型
+}
+
+const dateSchema = z.string() // 文字列のスキーマを作る関数
+  .length(10) // 長さを制限するメソッド
+  .refine(isDateOnly); // 追加の形式検証を登録するメソッド / 西暦1〜9999年の実在日を検証する関数
+const timeSchema = z.string() // 文字列のスキーマを作る関数
+  .length(5) // 長さを制限するメソッド
+  .regex(/^([01]\d|2[0-3]):[0-5]\d$/); // 正規表現の制約を設定するメソッド
+const optionalTextSchema = z.union([ // 複数の入力型を許可する関数
+  z.string().trim() // 前後の空白を除くメソッド / 文字列のスキーマを作る関数
+    .max(EVENT_LOCATION_MAX_LENGTH), // 上限を制限するメソッド
+  z.null(), // nullのスキーマを作る関数
+])
+  .default(null) // 未指定値の既定値を設定するメソッド
+  .transform(optionalValue); // 正規化を登録するメソッド / 任意文字列と空欄を正規化する関数
+const commonShape = {
+  targetMonth: z.string() // 文字列のスキーマを作る関数
+    .refine(isEventPracticeBatchTargetMonth), // 追加の形式検証を登録するメソッド / F11の対象月を厳密に検証する関数
+  periodStart: dateSchema,
+  periodEnd: dateSchema,
+  weekdays: z.array(z.number().int() // 配列のスキーマを作る関数 / 整数へ制限するメソッド / 数値のスキーマを作る関数
+    .min(0) // 下限を制限するメソッド
+    .max(6)) // 上限を制限するメソッド
+    .min(1) // 下限を制限するメソッド
+    .max(7) // 上限を制限するメソッド
+    .transform(normalizeWeekdays), // 正規化を登録するメソッド / 曜日を重複なしの昇順へ揃える関数
+  title: z.string().trim() // 前後の空白を除くメソッド / 文字列のスキーマを作る関数
+    .min(1) // 下限を制限するメソッド
+    .max(EVENT_TITLE_MAX_LENGTH), // 上限を制限するメソッド
+  startTime: timeSchema,
+  endTime: timeSchema,
+  location: optionalTextSchema,
+  meetingTime: z.union([ // 複数の入力型を許可する関数
+    timeSchema,
+    z.literal(""), // 固定値のスキーマを作る関数
+    z.null(), // nullのスキーマを作る関数
+  ])
+    .default(null) // 未指定値の既定値を設定するメソッド
+    .transform(optionalValue), // 正規化を登録するメソッド / 任意文字列と空欄を正規化する関数
+  meetingLocation: optionalTextSchema,
+  targetRoles: z.array(z.enum([ // 配列のスキーマを作る関数 / 許可した値のスキーマを作る関数
+    "OWNER",
+    "COACH",
+    "OFFICER",
+    "MEMBER",
+  ] satisfies readonly ClubMemberRole[])) // クラブ所属ロール型
+    .max(4) // 上限を制限するメソッド
+    .transform(buildContentTargetRoles), // 正規化を登録するメソッド / OWNERを含む公開対象へ正規化する関数
+};
+
+/**
+ * 共通入力の期間・同月・同日終了を検証する。timezoneによるUTC検証は後続で行う。
+ */
+function refineCommon( // 共通入力の期間・同月・同日終了を検証する関数
+  input: EventPracticeBatchCommonInput, // 構造検証・正規化した共通入力型
+  context: z.RefinementCtx, // 追加検証のエラーを登録する型
+): void { // 戻り値を持たない型
+  if (input.periodStart.slice(0, 7) !== input.targetMonth) { // 指定範囲を取り出すメソッド
+    context.addIssue({ // 項目エラーを登録するメソッド
+      code: "custom",
+      path: ["periodStart"],
+      message: FIELD_MESSAGES.periodStart,
+    });
+  }
+  if (
+    input.periodEnd.slice(0, 7) !== input.targetMonth || // 指定範囲を取り出すメソッド
+    input.periodEnd < input.periodStart
+  ) {
+    context.addIssue({ // 項目エラーを登録するメソッド
+      code: "custom",
+      path: ["periodEnd"],
+      message: FIELD_MESSAGES.periodEnd,
+    });
+  }
+  if (input.endTime <= input.startTime) {
+    context.addIssue({ // 項目エラーを登録するメソッド
+      code: "custom",
+      path: ["endTime"],
+      message: FIELD_MESSAGES.endTime,
+    });
+  }
+}
+
+/**
+ * 選択日が重複せず入力期間内にあることを検証する。曜日・DSTの候補所属は後続の責務。
+ */
+function refineSelection( // 選択日が重複せず入力期間内にあることを検証する関数
+  input: EventPracticeBatchInput, // 保存入力型
+  context: z.RefinementCtx, // 追加検証のエラーを登録する型
+): void { // 戻り値を持たない型
+  const seen = new Set<string>(); // 重複しない集合を作るコンストラクター / 文字列型
+  for (const date of input.selectedDates) {
+    if (
+      seen.has(date) || // 要素や項目の有無を調べるメソッド
+      date < input.periodStart ||
+      date > input.periodEnd
+    ) {
+      context.addIssue({ // 項目エラーを登録するメソッド
+        code: "custom",
+        path: ["selectedDates"],
+        message: FIELD_MESSAGES.selectedDates,
+      });
+      return;
+    }
+    seen.add(date); // 集合へ要素を加えるメソッド
+  }
+}
+
+const previewSchema = z.strictObject(commonShape) // 未許可キーを拒否するスキーマを作る関数
+  .superRefine(refineCommon); // 項目間の検証を登録するメソッド / 共通入力の期間・同月・同日終了を検証する関数
+const executionSchema = z.strictObject({ // 未許可キーを拒否するスキーマを作る関数
+  ...commonShape,
+  selectedDates: z.array(dateSchema) // 配列のスキーマを作る関数
+    .min(1) // 下限を制限するメソッド
+    .max(EVENT_PRACTICE_BATCH_MAX_COUNT), // 上限を制限するメソッド
+  requestId: z.string() // 文字列のスキーマを作る関数
+    .length(36) // 長さを制限するメソッド
+    .refine(isRequestId) // 追加の形式検証を登録するメソッド / UUID v4の形式を検証する関数
+    .transform(lowercase), // 正規化を登録するメソッド / 識別子を小文字へ揃える関数
+  previewFingerprint: z.string() // 文字列のスキーマを作る関数
+    .length(64) // 長さを制限するメソッド
+    .regex(/^[0-9a-f]{64}$/i) // 正規表現の制約を設定するメソッド
+    .transform(lowercase), // 正規化を登録するメソッド / 識別子を小文字へ揃える関数
+})
+  .superRefine(refineCommon) // 項目間の検証を登録するメソッド / 共通入力の期間・同月・同日終了を検証する関数
+  .superRefine(refineSelection) // 項目間の検証を登録するメソッド / 選択日が重複せず入力期間内にあることを検証する関数
+  .transform( // 正規化を登録するメソッド
+    /**
+     * 呼出し元の選択配列を変更せず、保存・hash計算に渡す日付順を固定する。
+     */
+    (value) => ({ // 検証や試験に使うコールバック
+      ...value,
+      selectedDates: [...value.selectedDates].sort(), // 配列を並べ替えるメソッド
+    }),
+  );
+
+/**
+ * 入力・例外原文を含まないフォーム全体の失敗結果を作る。
+ */
+function invalid( // フォーム全体の安全な失敗結果を作る関数
+): EventPracticeBatchValidation<never> { // 入力検証の結果型 / 成功データを許可しない型
+  return {
+    success: false,
+    fieldErrors: {},
+    formError: INVALID_FORM,
+  };
+}
+
+/**
+ * 単一項目の大量重複等でも入力値を返さず、安全な項目エラーだけを作る。
+ */
+function invalidField( // 安全な項目エラーを作る関数
+  field: EventPracticeBatchField, // 入力項目名型
+): EventPracticeBatchValidation<never> { // 入力検証の結果型 / 値を許可しない型
+  return {
+    success: false,
+    fieldErrors: {
+      [field]: [FIELD_MESSAGES[field]],
+    },
+    formError: null,
+  };
+}
+
+/**
+ * plainな値だけをschemaへ渡し、ネイティブ検証messageや例外のcauseを公開しない。
+ */
+function validate<T>( // 入力を安全に検証する関数 / 検証成功時のデータ型
+  schema: z.ZodType<T>, // 検証結果を指定するZodの型 / 検証成功時のデータ型
+  fields: ReadonlySet<string>, // 読取専用集合の型 / 文字列型
+  input: unknown, // 未検証の値を表す型
+): EventPracticeBatchValidation<T> { // 入力検証の結果型 / 検証成功時のデータ型
+  try {
+    if (
+      typeof input !== "object" ||
+      input === null ||
+      Array.isArray(input) // 配列かを調べる関数
+    ) {
+      return invalid(); // 安全なフォームエラーを作る関数
+    }
+    const prototype = Object.getPrototypeOf(input); // オブジェクトのprototypeを取得する関数
+    if (
+      prototype !== Object.prototype &&
+      prototype !== null
+    ) {
+      return invalid(); // 安全なフォームエラーを作る関数
+    }
+    for (const key of Reflect.ownKeys(input)) { // 所有するキーを取得する関数
+      if (
+        typeof key !== "string" ||
+        !fields.has(key) // 要素や項目の有無を調べるメソッド
+      ) {
+        return invalid(); // 安全なフォームエラーを作る関数
+      }
+      const descriptor = Object.getOwnPropertyDescriptor(input, key); // プロパティの定義を取得する関数
+      if (
+        !descriptor ||
+        !descriptor.enumerable ||
+        !("value" in descriptor)
+      ) {
+        return invalid(); // 安全なフォームエラーを作る関数
+      }
+    }
+    const result = schema.safeParse(input); // 検証成功と検証エラーを結果で返すメソッド
+    if (result.success) {
+      return {
+        success: true,
+        data: result.data,
+      };
+    }
+    const fieldErrors: FieldErrors<EventPracticeBatchField> = {}; // 項目別エラーの型 / 入力項目名型
+    for (const issue of result.error.issues) {
+      const field = issue.path[0];
+      if (
+        typeof field !== "string" ||
+        !fields.has(field) // 要素や項目の有無を調べるメソッド
+      ) {
+        return invalid(); // 安全なフォームエラーを作る関数
+      }
+      const knownField = field as EventPracticeBatchField; // 入力項目名型
+      fieldErrors[knownField] = [FIELD_MESSAGES[knownField]];
+    }
+    return {
+      success: false,
+      fieldErrors,
+      formError: null,
+    };
+  } catch {
+    return invalid(); // 安全なフォームエラーを作る関数
+  }
+}
+
+/**
+ * 共通入力だけを検証・正規化する。DB認可・曜日列挙・UTC変換・保存は行わない。
+ */
+export function validateEventPracticeBatchPreviewInput( // 共通入力を検証・正規化する関数
+  input: unknown, // 未検証の値を表す型
+): EventPracticeBatchValidation<EventPracticeBatchCommonInput> { // 入力検証の結果型 / 構造検証・正規化した共通入力型
+  return validate(previewSchema, COMMON_FIELDS, input); // 入力を安全に検証する関数
+}
+
+/**
+ * 共通入力と選択日・操作ID・fingerprintの構造を検証・正規化する。
+ */
+export function validateEventPracticeBatchInput( // 保存入力を検証・正規化する関数
+  input: unknown, // 未検証の値を表す型
+): EventPracticeBatchValidation<EventPracticeBatchInput> { // 入力検証の結果型 / 保存入力型
+  return validate(executionSchema, EXECUTION_FIELDS, input); // 入力を安全に検証する関数
+}
+
+/**
+ * FormDataの単一・反復項目を制限し、文字列の曜日を0〜6へ変換して検証する。
+ */
+function parse( // FormDataの項目を解析する関数
+  formData: FormData, // 送信フォームの型・コンストラクター
+  execute: boolean, // 真偽値型
+): EventPracticeBatchValidation<Record<string, unknown>> { // 入力検証の結果型 / キーと値の対応を表す型 / 文字列型 / 未検証の値を表す型
+  try {
+    if (!(formData instanceof FormData)) { // 送信フォームのコンストラクター参照
+      return invalid(); // 安全なフォームエラーを作る関数
+    }
+    const fields = execute ? EXECUTION_FIELDS : COMMON_FIELDS;
+    const weekdays: number[] = []; // 数値型
+    const targetRoles: string[] = []; // 文字列型
+    const selectedDates: string[] = []; // 文字列型
+    const record: Record<string, unknown> = { // キーと値の対応を表す型 / 文字列型 / 未検証の値を表す型
+      weekdays,
+      targetRoles,
+    };
+    if (execute) {
+      record.selectedDates = selectedDates;
+    }
+    for (const [field, value] of formData.entries()) { // キーと値の組を取得するメソッド
+      if (field.startsWith("$ACTION_")) { // 接頭辞を判定するメソッド
+        continue;
+      }
+      if (
+        !fields.has(field) || // 要素や項目の有無を調べるメソッド
+        typeof value !== "string"
+      ) {
+        return invalid(); // 安全なフォームエラーを作る関数
+      }
+      if (field === "weekdays") {
+        if (
+          weekdays.length >= 7 ||
+          value.length !== 1 ||
+          !/^[0-6]$/.test(value) // 正規表現との一致を検証するメソッド
+        ) {
+          return invalidField("weekdays"); // 安全な項目エラーを作る関数
+        }
+        weekdays.push(Number(value)); // 配列へ要素を追加するメソッド / 値を数値へ変換する関数
+      } else if (field === "targetRoles") {
+        if (targetRoles.length >= 4) {
+          return invalidField("targetRoles"); // 安全な項目エラーを作る関数
+        }
+        targetRoles.push(value); // 配列へ要素を追加するメソッド
+      } else if (field === "selectedDates") {
+        if (selectedDates.length >= EVENT_PRACTICE_BATCH_MAX_COUNT) {
+          return invalidField("selectedDates"); // 安全な項目エラーを作る関数
+        }
+        selectedDates.push(value); // 配列へ要素を追加するメソッド
+      } else {
+        if (Object.hasOwn(record, field)) { // 自身のプロパティかを調べる関数
+          return invalid(); // 安全なフォームエラーを作る関数
+        }
+        record[field] = value;
+      }
+    }
+    return {
+      success: true,
+      data: record,
+    };
+  } catch {
+    return invalid(); // 安全なフォームエラーを作る関数
+  }
+}
+
+/**
+ * preview用の送信を検証する。保存専用項目は受け取らない。
+ */
+export function parseEventPracticeBatchPreviewFormData( // preview用FormDataを検証する関数
+  formData: FormData, // 送信フォームの型・コンストラクター
+): EventPracticeBatchValidation<EventPracticeBatchCommonInput> { // 入力検証の結果型 / 構造検証・正規化した共通入力型
+  const result = parse(formData, false); // FormDataの項目を解析する関数
+  return result.success
+    ? validateEventPracticeBatchPreviewInput(result.data) // 共通入力を検証・正規化する関数
+    : result;
+}
+
+/**
+ * 保存用の送信を検証し、操作ID等が揃った実行入力だけを返す。
+ */
+export function parseEventPracticeBatchFormData( // 保存用FormDataを検証する関数
+  formData: FormData, // 送信フォームの型・コンストラクター
+): EventPracticeBatchValidation<EventPracticeBatchInput> { // 入力検証の結果型 / 保存入力型
+  const result = parse(formData, true); // FormDataの項目を解析する関数
+  if (!result.success) {
+    return result;
+  }
+  return validateEventPracticeBatchInput(result.data); // 保存入力を検証・正規化する関数
+}
