+      scopeValues(scope), // scopeを正規化する関数
+      validation.data.targetMonth,
+      validation.data.selectedEventIds,
+      validation.data.previewFingerprint,
+    ]);
+  } catch {
+    throw new Error(INVALID_DATA_MESSAGE); // 本文や生の検証例外を含めない固定例外のコンストラクター
+  }
+}
