--- a/app/(club-app)/auth/confirm/route.ts
+++ b/app/(club-app)/auth/confirm/route.ts
@@ -7,12 +7,26 @@ import "server-only";
 
 import {
   NextResponse,
+  // 【追加：F06粒度5】invite POSTのCookieをリクエストから読む。
+  type NextRequest,
 } from "next/server";
 
 import {
   createClient,
 } from "@/src/infrastructure/supabase/server";
 
+// 【追加：F06粒度5】invite専用POSTの検証先。recovery GETには使用しない。
+import {
+  CLUB_INVITATION_CONTEXT_COOKIE_NAME,
+  parseClubInvitationContext,
+} from "@/src/infrastructure/security/club-invitation-context";
+import {
+  prepareClubInvitationSession,
+} from "@/src/infrastructure/supabase/club-invitation-session";
+import {
+  findClubInvitationAcceptanceForUser,
+} from "@/src/infrastructure/prisma/repositories/club-invitation-repository";
+
 //エラーの場合のパス
 const INVALID_LINK_PATH =
   "/club-login/forgot-password?error=invalid-link";
@@ -107,4 +121,165 @@ export async function GET(
     RESET_PASSWORD_PATH,
     requestUrl,
   );
-}
\ No newline at end of file
+}
+
+// 【追加：F06粒度5】tokenをURLへ戻さず、固定の結果だけを返す。
+function invitationResult(
+  result:
+    | "confirmed"
+    | "invalid-invitation"
+    | "switch-account"
+    | "login-required",
+  status: number,
+): NextResponse {
+  const response = NextResponse.json(
+    result === "confirmed"
+      ? {
+          status: result,
+          redirectTo: "/welcome",
+        }
+      : { status: result },
+    { status },
+  );
+
+  response.headers.set("Cache-Control", "no-store");
+  response.headers.set("Referrer-Policy", "no-referrer");
+
+  return response;
+}
+
+// 【追加：F06粒度5】Content-Lengthを信用せず、読み込むbody自体を制限する。
+async function readInvitationBody(request: Request): Promise<unknown> {
+  const maximumBytes = 16_384;
+  const contentLength = request.headers.get("content-length");
+
+  if (
+    !request.body ||
+    (contentLength !== null && (
+      !/^[0-9]+$/u.test(contentLength) ||
+      Number(contentLength) > maximumBytes
+    ))
+  ) {
+    throw new Error("Invalid invitation body");
+  }
+
+  const reader = request.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let total = 0;
+
+  try {
+    while (true) {
+      const {
+        done,
+        value,
+      } = await reader.read();
+
+      if (done) {
+        break;
+      }
+
+      total += value.byteLength;
+
+      if (total > maximumBytes) {
+        await reader.cancel();
+        throw new Error("Invitation body limit exceeded");
+      }
+
+      chunks.push(value);
+    }
+  } finally {
+    reader.releaseLock();
+  }
+
+  return JSON.parse(Buffer.concat(chunks).toString("utf8"));
+}
+
+// 【追加：F06粒度5】fragmentの認証結果を同一originのJSON POSTだけで受け付ける。
+export async function POST(request: NextRequest): Promise<NextResponse> {
+  try {
+    const requestUrl = new URL(request.url);
+    const contentType = request.headers.get("content-type") ?? "";
+    const fetchSite = request.headers.get("sec-fetch-site");
+
+    if (
+      request.headers.get("origin") !== requestUrl.origin ||
+      (fetchSite !== null && fetchSite !== "same-origin") ||
+      !/^application\/json(?:;\s*charset=utf-8)?$/iu.test(contentType) ||
+      requestUrl.search !== "" ||
+      request.headers.has("content-encoding")
+    ) {
+      return invitationResult("invalid-invitation", 403);
+    }
+
+    const context = parseClubInvitationContext(
+      request.cookies.get(CLUB_INVITATION_CONTEXT_COOKIE_NAME)?.value,
+    );
+
+    if (!context) {
+      return invitationResult("invalid-invitation", 400);
+    }
+
+    const body = await readInvitationBody(request);
+
+    if (
+      typeof body !== "object" ||
+      body === null ||
+      Array.isArray(body) ||
+      Object.keys(body).length !== 3 ||
+      !("contextId" in body) ||
+      body.contextId !== context.contextId ||
+      !("accessToken" in body) ||
+      typeof body.accessToken !== "string" ||
+      body.accessToken.length > 8_192 ||
+      !/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/u.test(body.accessToken) ||
+      !("refreshToken" in body) ||
+      typeof body.refreshToken !== "string" ||
+      body.refreshToken.length === 0 ||
+      body.refreshToken.length > 2_048 ||
+      !/^[A-Za-z0-9._~-]+$/u.test(body.refreshToken)
+    ) {
+      return invitationResult("invalid-invitation", 400);
+    }
+
+    const prepared = await prepareClubInvitationSession({
+      accessToken: body.accessToken,
+      refreshToken: body.refreshToken,
+      currentCookies: request.cookies.getAll(),
+    });
+
+    if (prepared.outcome === "SWITCH_ACCOUNT") {
+      return invitationResult("switch-account", 409);
+    }
+
+    if (prepared.outcome === "PASSWORD_LOGIN_REQUIRED") {
+      return invitationResult("login-required", 409);
+    }
+
+    if (prepared.outcome !== "VERIFIED") {
+      return invitationResult("invalid-invitation", 409);
+    }
+
+    // Cookie内のslug・hashも未信頼入力として、Auth本人とDBの最新状態を照合する。
+    const invitation = await findClubInvitationAcceptanceForUser({
+      clubSlug: context.clubSlug,
+      tokenHash: context.tokenHash,
+      authenticatedUser: prepared.session.user,
+    });
+
+    if (invitation.outcome !== "AVAILABLE" || context.expiresAt <= Date.now()) {
+      return invitationResult("invalid-invitation", 400);
+    }
+
+    const response = invitationResult("confirmed", 200);
+
+    // 途中で書込が失敗した場合は、この応答全体を捨てて認証Cookieなしの失敗を返す。
+    for (const cookie of prepared.cookies) {
+      response.cookies.set(cookie.name, cookie.value, cookie.options);
+    }
+
+    return response;
+  } catch {
+    // SDK・DB・JSON・Cookieの例外内容と個人情報は表示・ログへ出さない。
+    return invitationResult("invalid-invitation", 400);
+  }
+}
