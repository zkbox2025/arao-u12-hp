+// domain/club/member/member-update-form.ts
+// メンバーの権限・在籍状態変更フォームの値構築とバリデーション
+
+import type {
+  ActionState,
+  FieldErrors,
+} from "@/domain/shared/action-state";
+
+import type {
+  ClubMemberRole,
+  ClubMembershipStatus,
+} from "@/types/prisma";
+
+const CLUB_MEMBER_ROLES =
+  new Set<string>([
+    "OWNER",
+    "COACH",
+    "OFFICER",
+    "MEMBER",
+  ] satisfies readonly ClubMemberRole[]);
+
+const CLUB_MEMBERSHIP_STATUSES =
+  new Set<string>([
+    "INVITED",
+    "ACTIVE",
+    "SUSPENDED",
+    "WITHDRAWN",
+  ] satisfies readonly ClubMembershipStatus[]);
+
+export type ClubMemberUpdateFormValues = {
+  role: string;
+  status: string;
+};
+
+export type ClubMemberUpdateFormField =
+  Extract<
+    keyof ClubMemberUpdateFormValues,
+    string
+  >;
+
+export type ValidClubMemberUpdateInput = {
+  role: ClubMemberRole;
+  status: ClubMembershipStatus;
+};
+
+export type ClubMemberUpdateActionState =
+  ActionState<
+    ClubMemberUpdateFormValues,
+    ClubMemberUpdateFormField
+  >;
+
+type BuildClubMemberUpdateInitialValuesInput = {
+  role: ClubMemberRole;
+  status: ClubMembershipStatus;
+};
+
+function getString(
+  formData: FormData,
+  name: string,
+): string {
+  const value =
+    formData.get(name);
+
+  return typeof value === "string"
+    ? value
+    : "";
+}
+
+function isClubMemberRole(
+  value: string,
+): value is ClubMemberRole {
+  return CLUB_MEMBER_ROLES.has(
+    value,
+  );
+}
+
+function isClubMembershipStatus(
+  value: string,
+): value is ClubMembershipStatus {
+  return CLUB_MEMBERSHIP_STATUSES.has(
+    value,
+  );
+}
+
+export function buildClubMemberUpdateFormValues(
+  formData: FormData,
+): ClubMemberUpdateFormValues {
+  return {
+    role:
+      getString(
+        formData,
+        "role",
+      ).trim(),
+
+    status:
+      getString(
+        formData,
+        "status",
+      ).trim(),
+  };
+}
+
+export function buildClubMemberUpdateInitialValues(
+  membership:
+    BuildClubMemberUpdateInitialValuesInput,
+): ClubMemberUpdateFormValues {
+  return {
+    role: membership.role,
+    status: membership.status,
+  };
+}
+
+export function validateClubMemberUpdateFormValues(
+  values: ClubMemberUpdateFormValues,
+):
+  | {
+      success: true;
+      data:
+        ValidClubMemberUpdateInput;
+    }
+  | {
+      success: false;
+      fieldErrors:
+        FieldErrors<ClubMemberUpdateFormField>;
+    } {
+  const fieldErrors:
+    FieldErrors<ClubMemberUpdateFormField> =
+      {};
+
+  const roleIsValid =
+    isClubMemberRole(
+      values.role,
+    );
+
+  const statusIsValid =
+    isClubMembershipStatus(
+      values.status,
+    );
+
+  if (!roleIsValid) {
+    fieldErrors.role = [
+      "権限を確認してください。",
+    ];
+  }
+
+  if (!statusIsValid) {
+    fieldErrors.status = [
+      "在籍状態を確認してください。",
+    ];
+  }
+
+  if (
+    !roleIsValid ||
+    !statusIsValid
+  ) {
+    return {
+      success: false,
+      fieldErrors,
+    };
+  }
+
+  return {
+    success: true,
+    data: {
+      role: values.role,
+      status: values.status,
+    },
+  };
+}
