+// domain/club/invitation/acceptance-form.ts
+// 初回パスワードの入力検証と、秘密の値を保持しないフォームの型。
+
+import type {
+  ActionState,
+  FieldErrors,
+} from "@/domain/shared/action-state";
+
+export const WELCOME_PASSWORD_MIN_LENGTH = 8;
+
+export type WelcomeFormValues = Record<string, never>;
+
+export type WelcomeFormField =
+  | "password"
+  | "confirmation";
+
+export type WelcomeActionState = ActionState<
+  WelcomeFormValues,
+  WelcomeFormField
+>;
+
+export type WelcomeValidationResult =
+  | {
+      success: true;
+      data: {
+        password: string;
+      };
+    }
+  | {
+      success: false;
+      fieldErrors: FieldErrors<WelcomeFormField>;
+    };
+
+// パスワードを変換せず検証し、失敗時には入力値を返さない。
+// 成功時のpasswordもAuth更新専用であり、ActionStateやログへ渡さない。
+export function validateWelcomeInput(
+  input: {
+    password: unknown;
+    confirmation: unknown;
+  },
+): WelcomeValidationResult {
+  const {
+    password,
+    confirmation,
+  } = input;
+  const fieldErrors: FieldErrors<WelcomeFormField> = {};
+
+  if (
+    typeof password !== "string" ||
+    password.length === 0
+  ) {
+    fieldErrors.password = [
+      "パスワードを入力してください。",
+    ];
+  } else if (password.length < WELCOME_PASSWORD_MIN_LENGTH) {
+    fieldErrors.password = [
+      `パスワードは${WELCOME_PASSWORD_MIN_LENGTH}文字以上で入力してください。`,
+    ];
+  } else if (
+    !/[A-Za-z]/u.test(password) ||
+    !/[0-9]/u.test(password)
+  ) {
+    fieldErrors.password = [
+      "パスワードは英字と数字を含めて入力してください。",
+    ];
+  }
+
+  if (
+    typeof confirmation !== "string" ||
+    confirmation.length === 0
+  ) {
+    fieldErrors.confirmation = [
+      "確認用パスワードを入力してください。",
+    ];
+  } else if (confirmation !== password) {
+    fieldErrors.confirmation = [
+      "パスワードが一致しません。",
+    ];
+  }
+
+  if (
+    Object.keys(fieldErrors).length > 0 ||
+    typeof password !== "string"
+  ) {
+    return {
+      success: false,
+      fieldErrors,
+    };
+  }
+
+  return {
+    success: true,
+    data: {
+      password,
+    },
+  };
+}
