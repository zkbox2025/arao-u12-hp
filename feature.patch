+// app/(club-app)/club/[clubSlug]/account/actions.ts
+// 本人の氏名・Child・現在クラブ所属の操作と、明示要求時の追加候補取得を行う。
+
+"use server";
+
+import {
+  redirect,
+  unstable_rethrow,
+} from "next/navigation";
+
+import {
+  requireClubAppAccess,
+} from "@/app/(club-app)/club/club-app-authorization";
+import type {
+  ClubAccessContext,
+} from "@/app/(club-app)/club/club-membership-authorization";
+import {
+  revalidateClubAccountNamePaths,
+  revalidateClubAccountPaths,
+} from "@/app/(club-app)/club/revalidate-club-paths";
+import {
+  ACCOUNT_NAME_MAX_LENGTH,
+  parseAccountNameFormData,
+  type AccountNameActionState,
+} from "@/domain/club/account/account-form";
+import type {
+  ClubAccountChildCandidatesResult,
+  ClubAccountMutationResult,
+} from "@/domain/club/account/account-types";
+import {
+  CHILD_GRADE_OPTIONS,
+  parseChildFormData,
+  parseChildIdFormData,
+  validateChildIdInput,
+  type ChildActionState,
+  type ChildMembershipActionState,
+} from "@/domain/club/account/child-form";
+import type {
+  ActionState,
+  FieldErrors,
+} from "@/domain/shared/action-state";
+import {
+  createRequestId,
+  isRequestId,
+} from "@/domain/shared/request-id";
+import {
+  getAttachableClubChildren,
+} from "@/src/application/club/account/get-club-account";
+import {
+  addClubChild,
+  createClubChild,
+  updateClubAccountName,
+  updateClubChild,
+  withdrawClubChild,
+} from "@/src/application/club/account/update-club-account";
+
+const EXPIRED_FORM_MESSAGE = "フォームの有効期限が切れました。ページを開き直してください。";
+const TARGET_MESSAGE = "対象の子どもを選び直してください。";
+const FAILED_MESSAGE = "処理に失敗しました。ページを開き直して確認してください。";
+
+// File・欠損・重複fieldを文字列へ丸めず、単一の文字列だけを取得する。
+function singleString(formData: FormData, name: string): string | null {
+  const entries = formData instanceof FormData ? formData.getAll(name) : [];
+  return entries.length === 1 && typeof entries[0] === "string" ? entries[0] : null;
+}
+
+// 前stateではrequestIdだけを確認する。一致は認証・所有権・CSRF保護の代わりにならない。
+function checkRequest(previousState: unknown, formData: FormData) {
+  const previousId = typeof previousState === "object" &&
+    previousState !== null &&
+    !Array.isArray(previousState) &&
+    "requestId" in previousState
+    ? previousState.requestId
+    : null;
+  const submittedId = singleString(formData, "requestId");
+  return {
+    requestId: isRequestId(previousId) ? previousId : createRequestId(),
+    valid: isRequestId(submittedId) &&
+      isRequestId(previousId) &&
+      submittedId === previousId,
+  };
+}
+
+// previousStateを展開せず、許可した入力・固定エラー・安全な識別子だけを返す。
+function errorState<TValues>(
+  values: TValues,
+  requestId: string,
+  formError: string | null,
+  fieldErrors: FieldErrors<Extract<keyof TValues, string>> = {},
+): ActionState<TValues> {
+  return {
+    status: "error",
+    values,
+    fieldErrors,
+    formError,
+    requestId,
+  };
+}
+
+// bindした対象と単一のhidden childIdを照合し、別Childのフォームとの混同を防ぐ。
+function matchesChildTarget(targetChildId: string, formData: FormData): boolean {
+  const submitted = parseChildIdFormData(formData);
+  return validateChildIdInput(targetChildId).success &&
+    submitted.success &&
+    submitted.data.childId === targetChildId;
+}
+
+// Serviceの例外から原文を返さず、Next.jsの制御例外だけは最初に再送出する。
+async function callMutation(
+  operation: () => Promise<ClubAccountMutationResult>,
+): Promise<ClubAccountMutationResult> {
+  try {
+    return await operation();
+  } catch (error) {
+    unstable_rethrow(error);
+    return {
+      outcome: "UPDATE_FAILED",
+    };
+  }
+}
+
+// 存在・権限の違いを区別せず、既知の結果だけを固定メッセージへ変換する。
+function mutationMessage(result: ClubAccountMutationResult): string {
+  switch (result.outcome) {
+    case "NOT_FOUND":
+    case "FORBIDDEN":
+      return "対象の情報を更新できません。ページを開き直してください。";
+    case "CONFLICT":
+      return "同時更新が発生しました。ページを開き直して確認してください。";
+    case "RULE_VIOLATION":
+      switch (result.reason) {
+        case "ALREADY_ACTIVE":
+          return "すでに現在クラブへ追加されています。ページを開き直してください。";
+        case "ALREADY_WITHDRAWN":
+          return "すでに現在クラブから外されています。ページを開き直してください。";
+        case "MEMBERSHIP_NOT_FOUND":
+          return "現在クラブの所属を確認できません。ページを開き直してください。";
+        case "STATUS_CHANGE_NOT_ALLOWED":
+          return "現在の所属状態では変更できません。クラブ管理者へ確認してください。";
+      }
+  }
+  return FAILED_MESSAGE;
+}
+
+// 保存後の失敗を再保存へ誘導せず、認可結果の固定accountへ保存済み案内で戻す。
+function finishSavedAccount(
+  access: ClubAccessContext,
+  requestId: string,
+  affectedClubSlugs: readonly string[],
+  feedback: string,
+  revalidate: typeof revalidateClubAccountPaths,
+): never {
+  let toast = feedback;
+  try {
+    revalidate(affectedClubSlugs);
+  } catch (error) {
+    unstable_rethrow(error);
+    toast = "saved-reload";
+  }
+  const query = new URLSearchParams({
+    toast,
+    toastId: requestId,
+  });
+  redirect(`/club/${encodeURIComponent(access.club.slug)}/account?${query.toString()}`);
+}
+
+// ページを経由しない直接呼出しでも、本人認証・現在クラブ認可後に氏名だけを保存する。
+export async function updateAccountNameAction(
+  clubSlug: string,
+  previousState: AccountNameActionState,
+  formData: FormData,
+): Promise<AccountNameActionState> {
+  const access = await requireClubAppAccess(clubSlug);
+  const values = {
+    name: (singleString(formData, "name") ?? "").slice(0, ACCOUNT_NAME_MAX_LENGTH),
+  };
+  const request = checkRequest(previousState, formData);
+  if (!request.valid) {
+    return errorState(values, request.requestId, EXPIRED_FORM_MESSAGE);
+  }
+  const validation = parseAccountNameFormData(formData);
+  if (!validation.success) {
+    return errorState(values, request.requestId, null, validation.fieldErrors);
+  }
+  const result = await callMutation(() => updateClubAccountName(access, validation.data));
+  if (result.outcome !== "UPDATED") {
+    return errorState(values, request.requestId, mutationMessage(result));
+  }
+  finishSavedAccount(
+    access,
+    request.requestId,
+    result.affectedClubSlugs,
+    "name-saved",
+    revalidateClubAccountNamePaths,
+  );
+}
+
+// 作成はrequestIdをChild.idにし、編集はbind対象とhidden値を再照合する。
+async function saveChildAction(
+  access: ClubAccessContext,
+  targetChildId: string | null,
+  previousState: ChildActionState,
+  formData: FormData,
+  operation: "CREATE" | "UPDATE",
+): Promise<ChildActionState> {
+  const grade = singleString(formData, "grade");
+  const selectedGrade = CHILD_GRADE_OPTIONS.find((option) => option.value === grade);
+  const values = {
+    name: (singleString(formData, "name") ?? "").slice(0, ACCOUNT_NAME_MAX_LENGTH),
+    grade: selectedGrade?.value ?? "",
+  };
+  const request = checkRequest(previousState, formData);
+  if (!request.valid) {
+    return errorState(values, request.requestId, EXPIRED_FORM_MESSAGE);
+  }
+  const id = validateChildIdInput(
+    operation === "CREATE" ? request.requestId : targetChildId,
+  );
+  if (
+    !id.success || (
+      operation === "UPDATE" &&
+      !matchesChildTarget(id.data.childId, formData)
+    )
+  ) {
+    return errorState(values, request.requestId, TARGET_MESSAGE);
+  }
+  const validation = parseChildFormData(formData);
+  if (!validation.success) {
+    return errorState(values, request.requestId, null, validation.fieldErrors);
+  }
+  const input = {
+    childId: id.data.childId,
+    name: validation.data.name,
+    grade: validation.data.grade,
+  };
+  const result = await callMutation(() => operation === "CREATE"
+    ? createClubChild(access, input)
+    : updateClubChild(access, input),);
+  if (result.outcome !== "UPDATED") {
+    return errorState(values, request.requestId, mutationMessage(result));
+  }
+  finishSavedAccount(
+    access,
+    request.requestId,
+    result.affectedClubSlugs,
+    operation === "CREATE" ? "child-created" : "child-updated",
+    revalidateClubAccountPaths,
+  );
+}
+
+// 同じ作成フォームの再送でも同じChild.idを使用し、所有権はRepositoryで再確認する。
+export async function createChildAction(
+  clubSlug: string,
+  previousState: ChildActionState,
+  formData: FormData,
+): Promise<ChildActionState> {
+  const access = await requireClubAppAccess(clubSlug);
+  return saveChildAction(access, null, previousState, formData, "CREATE");
+}
+
+// Childごとのbind対象・requestIdを照合してから、グローバルな氏名・学年を編集する。
+export async function updateChildAction(
+  clubSlug: string,
+  targetChildId: string,
+  previousState: ChildActionState,
+  formData: FormData,
+): Promise<ChildActionState> {
+  const access = await requireClubAppAccess(clubSlug);
+  return saveChildAction(access, targetChildId, previousState, formData, "UPDATE");
+}
+
+// 所属操作では対象IDだけを扱い、氏名・学年・親ID・所属状態を受け取らない。
+async function changeChildMembershipAction(
+  access: ClubAccessContext,
+  targetChildId: string,
+  previousState: ChildMembershipActionState,
+  formData: FormData,
+  operation: "ADD" | "WITHDRAW",
+): Promise<ChildMembershipActionState> {
+  const values = {
+    childId: validateChildIdInput(targetChildId).success ? targetChildId : "",
+  };
+  const request = checkRequest(previousState, formData);
+  if (!request.valid) {
+    return errorState(values, request.requestId, EXPIRED_FORM_MESSAGE);
+  }
+  if (!matchesChildTarget(targetChildId, formData)) {
+    return errorState(values, request.requestId, null, {
+      childId: [TARGET_MESSAGE],
+    },);
+  }
+  const result = await callMutation(() => operation === "ADD"
+    ? addClubChild(access, values)
+    : withdrawClubChild(access, values),);
+  if (result.outcome !== "UPDATED") {
+    return errorState(values, request.requestId, mutationMessage(result));
+  }
+  finishSavedAccount(
+    access,
+    request.requestId,
+    result.affectedClubSlugs,
+    operation === "ADD" ? "child-added" : "child-withdrawn",
+    revalidateClubAccountPaths,
+  );
+}
+
+// 本人の既存Childを現在クラブへ追加し、状態の可否はRepositoryで再照合する。
+export async function addChildToClubAction(
+  clubSlug: string,
+  targetChildId: string,
+  previousState: ChildMembershipActionState,
+  formData: FormData,
+): Promise<ChildMembershipActionState> {
+  const access = await requireClubAppAccess(clubSlug);
+  return changeChildMembershipAction(access, targetChildId, previousState, formData, "ADD");
+}
+
+// 現在クラブの所属だけを解除し、Child本体や他クラブ所属には変更を広げない。
+export async function withdrawChildFromClubAction(
+  clubSlug: string,
+  targetChildId: string,
+  previousState: ChildMembershipActionState,
+  formData: FormData,
+): Promise<ChildMembershipActionState> {
+  const access = await requireClubAppAccess(clubSlug);
+  return changeChildMembershipAction(
+    access,
+    targetChildId,
+    previousState,
+    formData,
+    "WITHDRAW",
+  );
+}
+
+// 追加UIを開いた時だけ候補を読む。書込・再検証・任意の戻り先は扱わない。
+export async function getAttachableChildrenAction(
+  clubSlug: string,
+): Promise<ClubAccountChildCandidatesResult> {
+  const access = await requireClubAppAccess(clubSlug);
+  try {
+    const result = await getAttachableClubChildren(access);
+    if (result.outcome !== "FOUND") {
+      return {
+        outcome: result.outcome,
+      };
+    }
+    return {
+      outcome: "FOUND",
+      children: result.children.map((child) => ({
+        id: child.id,
+        name: child.name,
+        grade: child.grade,
+      }),),
+    };
+  } catch (error) {
+    unstable_rethrow(error);
+    return {
+      outcome: "FETCH_FAILED",
+    };
+  }
+}
