@@ -0,0 +1,80 @@
+// domain/club/account/account-links.ts
+// 現在クラブの外部URLと、確定した法的URLだけを安全なリンクへ変換する。
+
+export type AccountExternalLink = {
+  label: string;
+  href: string;
+};
+
+// 公開先は未確定。仮URL・HPフォーム用の文面は設定せず、確定後に公開先を指定する。
+export const ACCOUNT_LEGAL_URLS: Readonly<{
+  terms: string | null;
+  privacy: string | null;
+}> = {
+  terms: null,
+  privacy: null,
+};
+
+// URLを取得・プレビューせず、資格情報のないhttp/https絶対URLだけを返す。
+export function getSafeAccountExternalUrl(value: unknown): string | null {
+  if (
+    typeof value !== "string" ||
+    !/^https?:\/\//i.test(value) ||
+    /[\u0000-\u0020\u007f\\]/.test(value)
+  ) {
+    return null;
+  }
+  try {
+    const url = new URL(value);
+    const authority = value.match(/^https?:\/\/([^/?#]*)/i)?.[1];
+    if (
+      (
+        url.protocol !== "https:" &&
+        url.protocol !== "http:"
+      ) ||
+      !url.hostname ||
+      !authority ||
+      authority.includes("@") ||
+      url.username ||
+      url.password
+    ) {
+      return null;
+    }
+    return url.href;
+  } catch {
+    return null;
+  }
+}
+
+// 不正・未設定のURLはリンク自体を返さず、クラブの設定と確定した公開先だけを使う。
+export function getAccountExternalLinks(club: {
+  websiteUrl: string | null;
+  instagramUrl: string | null;
+}): AccountExternalLink[] {
+  const candidates = [
+    {
+      label: "公式HP",
+      url: club.websiteUrl,
+    },
+    {
+      label: "Instagram",
+      url: club.instagramUrl,
+    },
+    {
+      label: "利用規約",
+      url: ACCOUNT_LEGAL_URLS.terms,
+    },
+    {
+      label: "プライバシーポリシー",
+      url: ACCOUNT_LEGAL_URLS.privacy,
+    },
+  ];
+  return candidates.flatMap((candidate) => {
+    const href = getSafeAccountExternalUrl(candidate.url);
+    return href ? [{
+      label: candidate.label,
+      href,
+    },] : [];
+  },
+  );
+}
