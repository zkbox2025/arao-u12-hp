+  expect(console.warn).not.toHaveBeenCalled();
+  vi.restoreAllMocks();
+});
+
+describe("buildClubInvitationEmail", () => {
+  it("新規ユーザーへ初回設定案内と認証リンクを生成する", () => {
+    const email = buildClubInvitationEmail(
