+  });
+
+  it("不正なInvitation IDを送信前に拒否する", async () => {
+    await expect(
+      sendClubInvitationEmail({
+        ...newUserInput(),
+        invitationId: "invalid",
+        attemptCount: 1,
+      }),
+    ).rejects.toMatchObject({
+      code: "VALIDATION",
+    });
+    expect(mocks.send).not.toHaveBeenCalled();
+  });
+});
