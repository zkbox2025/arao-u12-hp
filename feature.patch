+        </button>
+      ) : null}
+      {!attempted ? <a href={cancelHref}>月別管理ページへ戻る</a> : null}
+    </form>
+  );
+}
+
+/**
+ * 共通入力とpreviewを接続する。入力変更番号で遅延応答を無効化する。
+ * onSubmitで既定送信を止めてActionを呼ぶため、Reactの自動resetで入力を失わない。
+ */
+export function EventPracticeBatchForm({ // 定期練習の共通入力・previewフォームComponent
+  initialValues,
+  timezone,
+  previewAction,
+  createAction,
+  cancelHref,
+}: Props) { // フォームprops型
+  const id = useId(); // 入力欄の関連付けIDを作るhook
+  const [revision, setRevision] = useState(0); // 入力変更番号を描画へ反映するhook
+  const revisionRef = useRef(0); // 入力変更番号を同期的に保持するhook
+  const submittedRevision = useRef(0); // 送信時点の変更番号を保持するhook
+  const previewInFlight = useRef(false); // previewの連打を同期的に止めるhook
+  const lockedRef = useRef(false); // 保存開始後の入力変更を同期的に止めるhook
+  const [locked, setLocked] = useState(false); // 共通入力の操作可否を保持するhook
+  const initial: PreviewRun = { // 入力変更番号付きpreview state型
+    revision: -1,
+    state: {
+      status: "idle",
+      values: initialValues,
+      fieldErrors: {},
+      formError: null,
+      requestId: "",
+    },
+  };
+  const [run, dispatch, pending] = useActionState( // preview結果と送信中状態を保持するhook
+    /**
+     * 送信時の変更番号を応答と一緒に保持し、古い入力の結果を区別する。
+     */
+    async ( // preview reducerの非同期コールバック
+      previous: PreviewRun, // 前回の変更番号付きpreview結果型
+      data: FormData, // 共通入力のフォーム型
+    ): Promise<PreviewRun> => { // 変更番号付きpreview結果を返す非同期型
+      const version = submittedRevision.current;
+      try {
+        return {
+          revision: version,
+          state: await previewAction(previous.state, data), // 再認可とpreviewを行うサーバーAction
+        };
+      } catch (error) {
+        unstable_rethrow(error); // Nextの遷移・アクセス制御例外を再送出する関数
+        return {
+          revision: version,
+          state: {
+            status: "error",
+            outcome: "PREVIEW_FAILED",
+            values: initialValues,
+            fieldErrors: {},
+            formError: "previewを取得できませんでした。入力を保ったまま再度お試しください。",
+            requestId: "",
+          },
+        };
+      } finally {
+        previewInFlight.current = false;
+      }
+    },
+    initial,
+  );
+  const current = run.revision === revision;
+  const ready = current && run.state.status === "success" ? run.state : null;
+  /**
+   * 入力変更と再previewの開始時に、前の候補を同期的に無効化する。
+   */
+  function invalidate() { // previewを無効化する関数
+    if (lockedRef.current) {
+      return;
+    }
+    revisionRef.current += 1;
+    setRevision(revisionRef.current); // 新しい入力変更番号を表示するstate更新関数
+  }
+  /**
+   * フォーム値を送信時点で取得し、二重送信を防いでpreviewを作成する。
+   */
+  function beginPreview(event: FormEvent<HTMLFormElement>) { // preview送信関数 / フォームイベント型
+    event.preventDefault(); // 通常送信とURLへの入力混入を止めるメソッド
+    if (
+      previewInFlight.current ||
+      lockedRef.current ||
+      pending
+    ) {
+      return;
+    }
+    const data = new FormData(event.currentTarget); // 現在の共通入力を取得するフォームコンストラクター
+    invalidate(); // 再previewを始める時点で古い候補を無効化する関数
+    submittedRevision.current = revisionRef.current;
+    previewInFlight.current = true;
+    startTransition( // Action queueの送信をtransition内で開始する関数
+      /**
+       * 送信時点の共通入力をpreview Actionへ渡す。
+       */
+      () => dispatch(data), // preview送信のコールバック / Action送信関数
+    );
+  }
+  /**
+   * 再描画前の入力変更と再preview開始も含めて、保存対象の有効性を確認する。
+   */
+  function isCurrent() { // 最新のpreviewか確認する関数
+    return (
+      revisionRef.current === run.revision &&
+      !previewInFlight.current
+    );
+  }
+  /**
+   * 初回保存から共通入力を固定する。
+   */
+  function lock() { // 共通入力を固定する関数
+    lockedRef.current = true;
+    setLocked(true); // 操作不可を表示へ反映するstate更新関数
+  }
+  /**
+   * 保存前または確定した失敗後に限り、新しいpreviewを作成できる状態へ戻す。
+   */
+  function restart() { // 新しいpreviewの準備へ戻す関数
+    lockedRef.current = false;
+    setLocked(false); // 共通入力を操作可能にするstate更新関数
+    invalidate(); // 古いpreview・選択・操作IDを破棄する関数
+  }
+  return (
+    <div className="space-y-6">
+      <p>表示timezone: {timezone}。共通入力を確認してからpreviewを作成してください。</p>
+      <form
+        method="post"
+        onSubmit={beginPreview /* previewを送信する関数 */}
+        aria-busy={pending}
+        className="space-y-5"
+      >
+        {/* 定期練習の共通入力欄を表示するComponent */}
+        <EventPracticeBatchInputFields
+          idPrefix={id}
+          values={initialValues}
+          fieldErrors={current ? run.state.fieldErrors : {}}
+          disabled={locked}
+          onChange={invalidate /* 共通入力の変更でpreviewを無効化する関数 */}
+        />
+        {/* preview全体の固定エラーを表示するComponent */}
+        <FormErrorAlert message={current ? run.state.formError : null} />
+        <button
+          type="submit"
+          disabled={pending || locked}
+          className="rounded-lg bg-blue-700 px-4 py-3 text-white disabled:opacity-50"
+        >
+          {pending ? "previewを作成中…" : "作成予定をpreviewする"}
+        </button>
+      </form>
+      {!current && run.state.status !== "idle" ? (
+        <p role="status">入力が変更されました。現在の入力でpreviewを作成してください。</p>
+      ) : null}
+      {ready ? (
+        /* 選択・保存・同じ操作の再確認を扱うComponent */
+        <SelectionForm
+          key={ready.requestId}
+          ready={ready.data}
+          requestId={ready.requestId}
+          createAction={createAction /* クラブを固定したサーバー保存Action */}
+          cancelHref={cancelHref}
+          isCurrent={isCurrent /* 再描画前もpreviewの有効性を確認する関数 */}
+          onAttempt={lock /* 初回保存から共通入力を固定する関数 */}
+          onRestart={restart /* 新しいpreviewの準備へ戻す関数 */}
+        />
+      ) : null}
+      {!locked ? <a href={cancelHref}>月別管理ページへ戻る</a> : null}
+    </div>
+  );
+}
