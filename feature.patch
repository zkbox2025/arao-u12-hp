+   */
+  () => vi.fn(), // mockを先に用意する関数・コールバック
+);
+vi.mock("next", // Next初期化の境界を置き換えるメソッド
+  /**
+   * 実際のNext・HTTP serverを起動せず、初期化の試みだけを記録する。
+   */
+  () => ({
+    default: forbidden // Next初期化を検出するmock関数
+  }), // Next境界を置き換えるコールバック
+);
