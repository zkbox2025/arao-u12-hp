+// 【追加：F07粒度3】初回実行後、P2034だけを最大3回再試行する。
+const ACCOUNT_NAME_MAX_RETRIES = 3;
+
+// IDは認証・認可済みのサーバー側コンテキストから渡す。
+export type UpdateAccountNameForUserInput = ClubAccountReadScope & {
+  name: string;
+};
+
+// Prisma既知エラーだけを判定し、任意オブジェクトのcodeを信用しない。
+function isAccountNamePrismaError(
+  error: unknown,
+  code: string,
+): boolean {
+  return error instanceof Prisma.PrismaClientKnownRequestError &&
+    error.code === code;
+}
+
+// 本人のACTIVE所属と利用プランを再照合し、氏名だけを条件付きで更新する。
+export async function updateAccountNameForUser(
+  input: UpdateAccountNameForUserInput,
+): Promise<ClubAccountMutationResult> {
+  if (!hasReadScope(input)) {
+    return {
+      outcome: "FORBIDDEN",
+    };
+  }
+
+  const validation = validateAccountNameInput({
+    name: input.name,
+  });
+  if (!validation.success) {
+    return {
+      outcome: "UPDATE_FAILED",
+    };
+  }
+
+  let retryCount = 0;
+  while (true) {
+    try {
+      return await prisma.$transaction(
+        async (transaction): Promise<ClubAccountMutationResult> => {
+          const actor = await transaction.clubMembership.findFirst({
+            where: {
+              id: input.actorMembershipId,
+              clubId: input.clubId,
+              userId: input.userId,
+              status: "ACTIVE",
+            },
+            select: {
+              id: true,
+              clubId: true,
+              userId: true,
+              status: true,
+              club: {
+                select: {
+                  id: true,
+                  planType: true,
+                },
+              },
+            },
+          });
+          if (
+            !actor ||
+            actor.id !== input.actorMembershipId ||
+            actor.clubId !== input.clubId ||
+            actor.userId !== input.userId ||
+            actor.status !== "ACTIVE" ||
+            !actor.club ||
+            actor.club.id !== input.clubId ||
+            !hasClubFeature(actor.club.planType, "CLUB_APP")
+          ) {
+            return {
+              outcome: "FORBIDDEN",
+            };
+          }
+
+          const user = await transaction.appUser.findUnique({
+            where: {
+              id: input.userId,
+            },
+            select: {
+              id: true,
+            },
+          });
+          if (!user || user.id !== input.userId) {
+            return {
+              outcome: "NOT_FOUND",
+            };
+          }
+
+          const updated = await transaction.appUser.updateMany({
+            where: {
+              id: input.userId,
+              memberships: {
+                some: {
+                  id: input.actorMembershipId,
+                  clubId: input.clubId,
+                  userId: input.userId,
+                  status: "ACTIVE",
+                  club: {
+                    is: {
+                      id: input.clubId,
+                      planType: actor.club.planType,
+                    },
+                  },
+                },
+              },
+            },
+            data: {
+              name: validation.data.name,
+            },
+          });
+          if (updated.count === 0) {
+            return {
+              outcome: "NOT_FOUND",
+            };
+          }
+          if (updated.count !== 1) {
+            throw new Error("本人氏名の更新件数を確認できません。");
+          }
+
+          // 非ACTIVE所属の会員一覧にもAppUser.nameが表示されるため、状態で絞らない。
+          const memberships = await transaction.clubMembership.findMany({
+            where: {
+              userId: input.userId,
+            },
+            select: {
+              club: {
+                select: {
+                  slug: true,
+                },
+              },
+            },
+          });
+          return {
+            outcome: "UPDATED",
+            affectedClubSlugs: [
+              ...new Set(memberships.map((membership) => membership.club.slug)),
+            ].sort(),
+          };
+        },
+        {
+          isolationLevel: Prisma.TransactionIsolationLevel.Serializable,
+        },
+      );
+    } catch (error) {
+      if (isAccountNamePrismaError(error, "P2034")) {
+        if (retryCount < ACCOUNT_NAME_MAX_RETRIES) {
+          retryCount += 1;
+          continue;
+        }
+        return {
+          outcome: "CONFLICT",
+        };
+      }
+      if (isAccountNamePrismaError(error, "P2002")) {
+        return {
+          outcome: "CONFLICT",
+        };
+      }
+      if (isAccountNamePrismaError(error, "P2025")) {
+        return {
+          outcome: "NOT_FOUND",
+        };
+      }
+
+      // DomainErrorを含め、原文・cause・個人情報は結果やログへ反射しない。
+      return {
+        outcome: "UPDATE_FAILED",
+      };
+    }
+  }
+}
