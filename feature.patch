+// domain/platform/support/support-report-management-policy.ts
+// 検証・認可後に使用する、管理列だけの更新方針。DB操作や権限付与は行わない。
+
+import type {
+  SupportReportStatus, // サポート報告ステータスの型
+} from "@/types/prisma";
+
+export type SupportReportStatusUpdate = { // ステータス実変更時だけ書き込む列の型
+  status: SupportReportStatus; // 新しい報告ステータスの型
+  handledByPlatformAdminId: string; // 認可contextから取得する対応者IDの文字列型
+  statusChangedAt: Date; // 実変更のサーバー日時を保持するDate型
+  resolvedAt: Date | null; // 解決日時を保持するDateまたはnull型
+};
+
+export type SupportReportNoteUpdate = { // 内部メモ保存時だけ書き込む列の型
+  internalNote: string | null; // 正規化済みメモの文字列またはnull型
+  handledByPlatformAdminId: string; // 認可contextから取得する対応者IDの文字列型
+};
+
+export type SupportReportStatusDecision = // 同statusの非更新と、実変更の限定列を分ける型
+  | {
+      outcome: "UNCHANGED"; // 同statusで更新しないリテラル型
+  }
+  | {
+      outcome: "UPDATED"; // 実status変更を示すリテラル型
+      data: SupportReportStatusUpdate; // ステータス更新列の型
+  };
+
+// 認可・入力検証・version照合は呼出し元の責務。同statusでは日時・担当者を維持する。
+export function buildSupportReportStatusUpdate( // ステータス更新列を構築する純粋関数
+  currentStatus: SupportReportStatus, // 現在の報告ステータスの型
+  nextStatus: SupportReportStatus, // 更新先の報告ステータスの型
+  actorId: string, // 認可済み対応者IDの文字列型
+  now: Date, // 呼出し元が渡すサーバー現在日時のDate型
+): SupportReportStatusDecision { // 非更新または限定更新列の判定結果型
+  if (currentStatus === nextStatus) {
+    return { outcome: "UNCHANGED" };
+  }
+  if (!Number.isFinite(now.getTime())) { // 有限値判定とDateのミリ秒取得メソッド
+    throw new RangeError("状態変更日時が不正です。"); // 固定エラーを生成するRangeErrorコンストラクター
+  }
+  return {
+    outcome: "UPDATED",
+    data: {
+      status: nextStatus,
+      handledByPlatformAdminId: actorId,
+      statusChangedAt: new Date(now.getTime()), // サーバー日時を複製するDateコンストラクターとミリ秒取得メソッド
+      resolvedAt: nextStatus === "RESOLVED" ? new Date(now.getTime()) : null, // 解決日時を複製するDateコンストラクターとミリ秒取得メソッド
+    },
+  };
+}
+
+// メモ保存は対応者だけを併せて更新し、status・状態日時・解決日時を返さない。
+export function buildSupportReportNoteUpdate( // メモの限定更新列を構築する純粋関数
+  internalNote: string | null, // 検証・正規化済みメモの文字列またはnull型
+  actorId: string, // 認可済み対応者IDの文字列型
+): SupportReportNoteUpdate { // メモと対応者だけの更新列型
+  return {
+    internalNote,
+    handledByPlatformAdminId: actorId,
+  };
+}
