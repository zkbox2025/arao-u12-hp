@@ -0,0 +1,131 @@
+// app/(club-app)/welcome/InvitationAuthBridge.tsx
+"use client";
+
+import {
+  useEffect,
+  useRef,
+  useState,
+} from "react";
+
+const STATUS_MESSAGES = {
+  "invalid-invitation": "招待の認証を確認できませんでした。招待リンクを開き直してください。",
+  "switch-account":
+    "別のアカウントでログイン中です。ログアウトしてから招待リンクを開いてください。",
+  "login-required": "続けるには、既存のアカウントでパスワードログインしてください。",
+};
+
+type BridgeStatus = keyof typeof STATUS_MESSAGES | null;
+
+// fragmentを即時に履歴から除去し、同一originの専用POSTへ一度だけ渡す。
+export function InvitationAuthBridge({
+  contextId,
+}: {
+  contextId: string;
+}) {
+  const started = useRef(false);
+  const [status, setStatus] = useState<BridgeStatus>(null);
+
+  useEffect(() => {
+    if (started.current) {
+      return;
+    }
+
+    started.current = true;
+    const fragment = window.location.hash;
+
+    if (!fragment) {
+      return;
+    }
+
+    // 解析や通信より先に消し、Authのエラー文字列も履歴へ残さない。
+    window.history.replaceState(
+      window.history.state,
+      "",
+      window.location.pathname + window.location.search,
+    );
+
+    // tokenをstate・DOM・storageへ保存せず、通信に必要な間だけ保持する。
+    async function confirmInvitation(): Promise<void> {
+      try {
+        if (fragment.length > 16_384) {
+          setStatus("invalid-invitation");
+          return;
+        }
+
+        const params = new URLSearchParams(fragment.slice(1));
+        const accessToken = params.get("access_token");
+        const refreshToken = params.get("refresh_token");
+
+        if (
+          params.getAll("access_token").length !== 1 ||
+          params.getAll("refresh_token").length !== 1 ||
+          params.getAll("type").length !== 1 ||
+          params.get("type") !== "invite" ||
+          params.getAll("token_type").length !== 1 ||
+          params.get("token_type") !== "bearer" ||
+          params.has("error") ||
+          params.has("error_description") ||
+          params.has("error_code") ||
+          !accessToken ||
+          !refreshToken
+        ) {
+          setStatus("invalid-invitation");
+          return;
+        }
+
+        const response = await fetch("/auth/confirm", {
+          method: "POST",
+          credentials: "same-origin",
+          cache: "no-store",
+          redirect: "error",
+          referrerPolicy: "no-referrer",
+          headers: {
+            "Content-Type": "application/json",
+          },
+          body: JSON.stringify({
+            contextId,
+            accessToken,
+            refreshToken,
+          }),
+        });
+        const result: unknown = await response.json();
+
+        if (
+          typeof result === "object" &&
+          result !== null &&
+          "status" in result
+        ) {
+          if (response.ok && result.status === "confirmed") {
+            // 応答のURLは使用せず、遷移先を固定する。
+            window.location.replace("/welcome");
+            return;
+          }
+
+          if (
+            result.status === "switch-account" ||
+            result.status === "login-required"
+          ) {
+            setStatus(result.status);
+            return;
+          }
+        }
+
+        setStatus("invalid-invitation");
+      } catch {
+        setStatus("invalid-invitation");
+      }
+    }
+
+    void confirmInvitation();
+  }, [contextId]);
+
+  if (status === null) {
+    return null;
+  }
+
+  return (
+    <p role="alert">
+      {STATUS_MESSAGES[status]}
+    </p>
+  );
+}
