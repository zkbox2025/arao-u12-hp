+  it("trim後の100文字を許可し、101文字を拒否する", () => {
+    expect(validateAccountNameInput({
+      name: ` ${"あ".repeat(ACCOUNT_NAME_MAX_LENGTH)} `,
+    }).success).toBe(true);
+    const result = validateAccountNameInput({
+      name: "あ".repeat(ACCOUNT_NAME_MAX_LENGTH + 1),
+    });
+    expect(result).toEqual({
