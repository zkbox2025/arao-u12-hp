@@ -0,0 +1,163 @@
+// src/infrastructure/security/club-invitation-context.ts
+// 招待URLを、本人確認の根拠にはしない短時間の検索contextへ交換する。
+
+import "server-only";
+
+import { randomUUID } from "node:crypto";
+
+import { isRequestId } from "@/domain/shared/request-id";
+
+import { hashToken } from "./token";
+
+export const CLUB_INVITATION_CONTEXT_COOKIE_NAME = "club-invitation-context";
+export const CLUB_INVITATION_CONTEXT_TTL_MILLISECONDS = 15 * 60 * 1_000;
+
+const MAX_QUERY_LENGTH = 2_048;
+const MAX_COOKIE_LENGTH = 1_024;
+const MAX_CLUB_SLUG_LENGTH = 255;
+const CLUB_SLUG_PATTERN = /^[a-z0-9]+(?:-[a-z0-9]+)*$/u;
+const RAW_TOKEN_PATTERN = /^[A-Za-z0-9_-]{43}$/u;
+const TOKEN_HASH_PATTERN = /^[a-f0-9]{64}$/u;
+
+// expiresAtは一時情報の再利用期限であり、DBの招待期限やAuthの証明ではない。
+export type ClubInvitationContext = {
+  clubSlug: string;
+  tokenHash: string;
+  contextId: string;
+  expiresAt: number;
+};
+
+// 既存のslug形式に従い、Cookieのサイズを抑える入力上限も確認する。
+function isClubSlug(value: unknown): value is string {
+  return (
+    typeof value === "string" &&
+    value.length <= MAX_CLUB_SLUG_LENGTH &&
+    CLUB_SLUG_PATTERN.test(value)
+  );
+}
+
+// 時刻計算の不正値や整数範囲の超過を拒否する。
+function isContextTime(now: number): boolean {
+  return (
+    Number.isSafeInteger(now) &&
+    now >= 0 &&
+    Number.isSafeInteger(now + CLUB_INVITATION_CONTEXT_TTL_MILLISECONDS)
+  );
+}
+
+// 確定した2つのqueryだけを受け付け、多重queryや余分な戻り先指定を拒否する。
+// 不正値は返却せず、raw tokenはハッシュ化した後に持ち回らない。
+export function createClubInvitationContext(
+  query: URLSearchParams,
+  now: number = Date.now(),
+): ClubInvitationContext | null {
+  if (
+    !isContextTime(now) ||
+    query.toString().length > MAX_QUERY_LENGTH ||
+    Array.from(query.keys()).length !== 2 ||
+    query.getAll("clubSlug").length !== 1 ||
+    query.getAll("token").length !== 1
+  ) {
+    return null;
+  }
+
+  const clubSlug = query.get("clubSlug");
+  const rawToken = query.get("token");
+
+  if (
+    !isClubSlug(clubSlug) ||
+    typeof rawToken !== "string" ||
+    !RAW_TOKEN_PATTERN.test(rawToken)
+  ) {
+    return null;
+  }
+
+  return {
+    clubSlug,
+    tokenHash: hashToken(rawToken),
+    contextId: randomUUID(),
+    expiresAt: now + CLUB_INVITATION_CONTEXT_TTL_MILLISECONDS,
+  };
+}
+
+// 明示した項目だけをCookie向けに直列化し、余分な情報を取り込まない。
+export function serializeClubInvitationContext(
+  context: ClubInvitationContext,
+): string {
+  const value = JSON.stringify({
+    clubSlug: context.clubSlug,
+    tokenHash: context.tokenHash,
+    contextId: context.contextId,
+    expiresAt: context.expiresAt,
+  });
+
+  return Buffer.from(value, "utf8").toString("base64url");
+}
+
+// Cookieは改変可能な検索入力として検査する。署名や認証済みフラグは扱わない。
+// 有効な形式での改変も、後続のAuth・DB・表示時contextIdの照合が必要。
+export function parseClubInvitationContext(
+  value: unknown,
+  now: number = Date.now(),
+): ClubInvitationContext | null {
+  if (
+    typeof value !== "string" ||
+    value.length === 0 ||
+    value.length > MAX_COOKIE_LENGTH ||
+    !/^[A-Za-z0-9_-]+$/u.test(value) ||
+    !isContextTime(now)
+  ) {
+    return null;
+  }
+
+  try {
+    const decoded = Buffer.from(value, "base64url").toString("utf8");
+
+    if (Buffer.from(decoded, "utf8").toString("base64url") !== value) {
+      return null;
+    }
+
+    const context: unknown = JSON.parse(decoded);
+
+    if (
+      typeof context !== "object" ||
+      context === null ||
+      Array.isArray(context) ||
+      Object.keys(context).length !== 4 ||
+      !("clubSlug" in context) ||
+      !isClubSlug(context.clubSlug) ||
+      !("tokenHash" in context) ||
+      typeof context.tokenHash !== "string" ||
+      !TOKEN_HASH_PATTERN.test(context.tokenHash) ||
+      !("contextId" in context) ||
+      !isRequestId(context.contextId) ||
+      !("expiresAt" in context) ||
+      typeof context.expiresAt !== "number" ||
+      !Number.isSafeInteger(context.expiresAt) ||
+      context.expiresAt <= now ||
+      context.expiresAt > now + CLUB_INVITATION_CONTEXT_TTL_MILLISECONDS
+    ) {
+      return null;
+    }
+
+    return {
+      clubSlug: context.clubSlug,
+      tokenHash: context.tokenHash,
+      contextId: context.contextId,
+      expiresAt: context.expiresAt,
+    };
+  } catch {
+    return null;
+  }
+}
+
+// Domainは指定せずhost限定にし、ログイン・confirm・両受入画面で読めるPathを使う。
+export function getClubInvitationContextCookieOptions() {
+  return {
+    httpOnly: true,
+    sameSite: "lax" as const,
+    secure: process.env.NODE_ENV === "production",
+    path: "/",
+    maxAge: CLUB_INVITATION_CONTEXT_TTL_MILLISECONDS / 1_000,
+  };
+}
