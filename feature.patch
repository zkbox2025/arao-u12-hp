+// domain/club/support/support-report-types.ts
+// DB受付、内部通知、利用者へ返す結果を分離する。型だけで認可や保存済み状態は保証しない。
+
+import type {
+  ClubMemberRole,
+  SupportReportCategory,
+} from "@/types/prisma";
+
+// サーバー側で正規化するmetadata。FormDataの値をそのまま格納してはいけない。
+export type SupportReportMetadata = {
+  pageUrl: string | null;
+  userAgent: string | null;
+};
+
+// 保存済みの内部通知用DTO。報告者snapshotをClientのprops・ActionState・ログへ渡さない。
+export type SupportReportReceipt = SupportReportMetadata & {
+  id: string;
+  clubId: string;
+  membershipId: string | null;
+  clubName: string;
+  category: SupportReportCategory;
+  message: string;
+  reporterName: string | null;
+  reporterEmail: string | null;
+  reporterRole: ClubMemberRole | null;
+  createdAt: Date;
+};
+
+// 新規受付だけが通知を開始する。同一受付の再送判定と一回限り保存は後続Repositoryの責務。
+export type SupportReportCreationResult =
+  | {
+      outcome: "CREATED";
+      report: SupportReportReceipt;
+    }
+  | {
+      outcome: "ALREADY_ACCEPTED";
+    }
+  | {
+      outcome: "FORBIDDEN" | "CONFLICT" | "CREATE_FAILED";
+    };
+
+// メール原文やSDKレスポンスを保存せず、この固定コードだけをnotifyErrorへ記録する。
+export type SupportReportNotificationErrorCode =
+  | "EMAIL_CONFIGURATION_MISSING"
+  | "EMAIL_SEND_FAILED"
+  | "EMAIL_SEND_RESULT_UNKNOWN";
+
+// provider受付と配送完了を区別し、不明結果を明確な送信失敗へ丸めない。
+export type SupportReportNotificationResult =
+  | {
+      outcome: "ACCEPTED";
+    }
+  | {
+      outcome: "FAILED";
+      errorCode: Exclude<
+        SupportReportNotificationErrorCode,
+        "EMAIL_SEND_RESULT_UNKNOWN"
+      >;
+    }
+  | {
+      outcome: "UNKNOWN";
+      errorCode: "EMAIL_SEND_RESULT_UNKNOWN";
+    };
+
+// 通知結果の記録失敗は、既に保存した報告の受付結果を取り消さない。
+export type SupportReportNotificationRecordResult = {
+  outcome: "RECORDED" | "NOT_FOUND" | "UPDATE_FAILED";
+};
+
+// 公開結果へ報告者情報・報告DTO・通知状態・任意のエラー原文を含めない。
+export type SupportReportAcceptanceResult = {
+  outcome: "ACCEPTED" | "FORBIDDEN" | "CONFLICT" | "CREATE_FAILED";
+};
