@@ -0,0 +1,466 @@
+// tests/event-practice-batch-date-times.test.ts
+// DB・Auth通信なしで、現地曜日・UTC固定値・DST・除外理由・入力不変性を確認する。
+
+import {
+  afterEach,
+  expect,
+  it,
+  vi,
+} from "vitest";
+
+import {
+  generateEventPracticeBatchDateTimes, // 正規化共通入力から現地曜日候補とUTC日時を生成する関数
+  type EventPracticeBatchDateTimeResult, // 候補生成の成功と入力・timezone等の失敗を分ける型
+} from "@/domain/club/event/event-practice-batch-date-times";
+import type {
+  EventPracticeBatchCommonInput, // 検証・正規化した定期練習の共通入力値の型
+} from "@/domain/club/event/event-practice-batch-types";
+import * as resolver from "@/domain/shared/date-time/club-local-date-time"; // 厳密な現地日時解決の関数群
+import * as formValidator from "@/domain/club/event/event-practice-batch-form"; // 共通入力の検証関数群
+
+const PRIVATE = "PRIVATE_DATE_TIME_SQL_TOKEN";
+
+/**
+ * 上書きした項目だけを持つ、独立した定期練習の共通入力を作る。
+ */
+function input( // 試験用の共通入力を作る関数
+  overrides: Partial<EventPracticeBatchCommonInput> = {}, // 指定した型の項目を任意にする型 / 正規化した共通入力型
+): EventPracticeBatchCommonInput { // 正規化した共通入力型
+  return {
+    targetMonth: "2026-01",
+    periodStart: "2026-01-01",
+    periodEnd: "2026-01-31",
+    weekdays: [0, 1, 2, 3, 4, 5, 6],
+    title: "練習",
+    startTime: "18:00",
+    endTime: "20:00",
+    location: null,
+    meetingTime: null,
+    meetingLocation: null,
+    targetRoles: ["OWNER", "MEMBER"],
+    ...overrides,
+  };
+}
+
+/**
+ * 単日の変換を検証する共通入力を作る。曜日選択は全曜日にする。
+ */
+function singleDay( // 単日の試験入力を作る関数
+  date: string, // 文字列型
+  overrides: Partial<EventPracticeBatchCommonInput> = {}, // 指定した型の項目を任意にする型 / 正規化した共通入力型
+): EventPracticeBatchCommonInput { // 正規化した共通入力型
+  return input({ // 試験用の共通入力を作る関数
+    targetMonth: date.slice(0, 7), // 文字列の指定範囲を得るメソッド
+    periodStart: date,
+    periodEnd: date,
+    ...overrides,
+  });
+}
+
+/**
+ * 生成成功を検証し、候補と件数を持つ結果へ型を絞る。
+ */
+function ready( // 生成成功を確認する関数
+  value: EventPracticeBatchCommonInput, // 正規化した共通入力型
+  zone = "Asia/Tokyo",
+) {
+  const result = generateEventPracticeBatchDateTimes(value, zone); // 現地曜日候補とUTC日時を生成する関数
+  expect(result.outcome).toBe("READY"); // 値の一致を検証するメソッド / 期待値を検証する関数
+  if (result.outcome !== "READY") {
+    throw new Error("生成成功を期待しました。"); // 固定メッセージの例外を作るコンストラクター
+  }
+  return result;
+}
+
+/**
+ * 失敗結果に部分候補・入力値・例外原文が含まれないことを確認する。
+ */
+function rejected(result: EventPracticeBatchDateTimeResult) { // 安全な失敗結果を確認する関数 / 候補生成の成功・失敗結果型
+  expect(result.outcome).not.toBe("READY"); // 値の一致を検証するメソッド / 期待値を検証する関数
+  expect(result).not.toHaveProperty("items"); // プロパティの存在を検証するメソッド / 期待値を検証する関数
+  expect(JSON.stringify(result)).not.toContain(PRIVATE); // 値の包含を検証するメソッド / 期待値を検証する関数 / 値をJSON文字列へ変換する関数
+}
+
+afterEach( // 試験後の処理を登録する関数
+  /**
+   * 異常系で置き換えた共有resolverやvalidatorを元へ戻す。
+   */
+  () => { // 検証・変換に使うコールバック
+    vi.restoreAllMocks(); // 置換した関数を元に戻す関数
+  },
+);
+
+it.each([ // 表形式の試験を登録する関数
+  ["2026-01", 31],
+  ["2026-02", 28],
+  ["2028-02", 29],
+  ["1900-02", 28],
+  ["2000-02", 29],
+  ["2026-04", 30],
+])(
+  "%sの全曜日を実在する%i日だけ、重複なしの日付順で生成する",
+  /**
+   * 月初末を含み、平年・閏年の各日付を固定の件数と照合する。
+   */
+  (month, days) => { // 検証・変換に使うコールバック
+    const result = ready(input({ // 生成成功を確認する関数 / 試験用の共通入力を作る関数
+      targetMonth: month,
+      periodStart: `${month}-01`,
+      periodEnd: `${month}-${days}`,
+    }), "UTC");
+    const dates = result.items.map( // 各要素を変換するメソッド
+      /**
+       * 生成候補から識別子として使う現地日付を取り出す。
+       */
+      (item) => item.date, // 検証・変換に使うコールバック
+    );
+    const expected = Array.from({ length: days }, // 配列を生成する関数
+      /**
+       * 月内の連番だけから期待する現地日付を作る。
+       */
+      (_, index) => `${month}-${String(index + 1).padStart(2, "0")}`, // 検証・変換に使うコールバック / 文字列の先頭を補うメソッド / 値を文字列へ変換する関数
+    );
+    expect(dates).toEqual(expected); // 内容の一致を検証するメソッド / 期待値を検証する関数
+    expect(result.candidateCount).toBe(days); // 値の一致を検証するメソッド / 期待値を検証する関数
+    expect(result.selectableCount).toBe(days); // 値の一致を検証するメソッド / 期待値を検証する関数
+  },
+);
+
+it("曜日を日付順に絞り、重複曜日で候補を重複させない", // 試験を登録する関数
+  /**
+   * 2026年1月の日曜と木曜をホストの曜日関数に依存せず固定値で確認する。
+   */
+  () => { // 検証・変換に使うコールバック
+    const result = ready(input({ weekdays: [4, 0, 4] })); // 生成成功を確認する関数 / 試験用の共通入力を作る関数
+    expect(result.items.map( // 期待値を検証する関数 / 各要素を変換するメソッド
+      /**
+       * 曜日候補の現地識別子を比較する。
+       */
+      (item) => item.date, // 検証・変換に使うコールバック
+    )).toEqual([ // 内容の一致を検証するメソッド
+      "2026-01-01",
+      "2026-01-04",
+      "2026-01-08",
+      "2026-01-11",
+      "2026-01-15",
+      "2026-01-18",
+      "2026-01-22",
+      "2026-01-25",
+      "2026-01-29",
+    ]);
+  },
+);
+
+it("単日で曜日が一致しなければ0件となり、空の曜日入力とは区別する", // 試験を登録する関数
+  /**
+   * 有効な曜日選択でも期間内に対象日がなければ空の成功結果を返す。
+   */
+  () => { // 検証・変換に使うコールバック
+    expect(ready(singleDay("2026-01-01", { weekdays: [0] }))).toEqual({ // 内容の一致を検証するメソッド / 期待値を検証する関数 / 生成成功を確認する関数 / 単日の試験入力を作る関数
+      outcome: "READY",
+      items: [],
+      candidateCount: 0,
+      selectableCount: 0,
+    });
