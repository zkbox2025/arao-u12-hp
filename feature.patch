+// scripts/recover-club-invitation.ts
+
+import { randomUUID } from "node:crypto";
+import { pathToFileURL } from "node:url";
+import { parseArgs } from "node:util";
+
+import type { PrismaClient } from "@prisma/client";
+import { z } from "zod";
+
+import { normalizeEmail } from "../domain/shared/email";
+import type {
+  recoverClubInvitationPreparation,
+} from "../src/application/club/invitation/recover-club-invitation";
+import type {
+  recordClubInvitationAuthUser,
+  releaseClubInvitationClaim,
+} from "../src/infrastructure/prisma/repositories/club-invitation-repository";
+import type {
+  getClubInvitationAuthUserById,
+} from "../src/infrastructure/supabase/club-invitation-auth";
+
+export type RecoveryOptions = {
+  clubSlug: string;
+  clubId: string;
+  invitationId: string;
+  authUserId: string;
+  actorMembershipId: string;
+  mode: "dry-run" | "apply";
+};
+
+export type RecoveryDependencies = {
+  db: PrismaClient;
+  getAuthUser: typeof getClubInvitationAuthUserById;
+  recordAuthUser: typeof recordClubInvitationAuthUser;
+  recoverPreparation: typeof recoverClubInvitationPreparation;
+  releaseClaim: typeof releaseClubInvitationClaim;
+};
+
+const optionsSchema = z.object({
+  clubSlug: z.string().regex(/^[a-z0-9]+(?:-[a-z0-9]+)*$/),
+  clubId: z.uuid(),
+  invitationId: z.uuid(),
+  authUserId: z.uuid(),
+  actorMembershipId: z.uuid(),
+  mode: z.enum(["dry-run", "apply"]),
+});
+
+// 入力原文を例外に含めず、確認用IDと実行モードをすべて必須にする。
+export function parseRecoveryOptions(args: readonly string[]): RecoveryOptions {
+  try {
+    const { values } = parseArgs({
+      args: [...args],
+      allowPositionals: false,
+      strict: true,
+      options: {
+        "club-slug": {
+          type: "string",
+        },
+        "club-id": {
+          type: "string",
+        },
+        "invitation-id": {
+          type: "string",
+        },
+        "auth-user-id": {
+          type: "string",
+        },
+        "actor-membership-id": {
+          type: "string",
+        },
+        "dry-run": {
+          type: "boolean",
+        },
+        apply: {
+          type: "boolean",
+        },
+      },
+    });
+
+    if (Boolean(values.apply) === Boolean(values["dry-run"])) {
+      throw new Error("Invalid execution mode");
+    }
+
+    return optionsSchema.parse({
+      clubSlug: values["club-slug"],
+      clubId: values["club-id"],
+      invitationId: values["invitation-id"],
+      authUserId: values["auth-user-id"],
+      actorMembershipId: values["actor-membership-id"],
+      mode: values.apply ? "apply" : "dry-run",
+    });
+  } catch {
+    throw new Error("復旧対象の確認用IDと、--dry-runまたは--applyを指定してください。");
+  }
+}
+
+// 通常テストやimportではDB・Authクライアントを生成しない。
+export async function recoverClubInvitation(
+  input: RecoveryOptions,
+  dependencies: RecoveryDependencies,
+): Promise<string> {
+  let claim: {
+    clubId: string;
+    actorMembershipId: string;
+    invitationId: string;
+    claimToken: string;
+  } | undefined;
+
+  try {
+    const validation = optionsSchema.safeParse(input);
+
+    if (!validation.success) {
+      return "INVALID_OPTIONS";
+    }
+
+    const options = validation.data;
+    const { db } = dependencies;
+    const club = await db.club.findUnique({
+      where: {
+        slug: options.clubSlug,
+      },
+      select: {
+        id: true,
+      },
+    });
+
+    if (!club || club.id !== options.clubId) {
+      return "CLUB_MISMATCH";
+    }
+
+    const owner = await db.clubMembership.findFirst({
+      where: {
+        id: options.actorMembershipId,
+        clubId: club.id,
+        role: "OWNER",
+        status: "ACTIVE",
+      },
+      select: {
+        id: true,
+      },
+    });
+
+    if (!owner) {
+      return "ACTOR_NOT_ACTIVE_OWNER";
+    }
+
+    const invitation = await db.clubInvitation.findFirst({
+      where: {
+        id: options.invitationId,
+        clubId: club.id,
+      },
+      select: {
+        id: true,
+        clubId: true,
+        name: true,
+        email: true,
+        role: true,
+        status: true,
+        acceptedAt: true,
+        authUserId: true,
+        membershipId: true,
+        claimToken: true,
+        leaseExpiresAt: true,
+        expiresAt: true,
+        updatedAt: true,
+        attemptCount: true,
+        membership: {
+          select: {
+            clubId: true,
+            userId: true,
+            status: true,
+          },
+        },
+      },
+    });
+    const now = new Date();
+
+    if (!invitation) {
+      return "NOT_FOUND";
+    }
+
+    if (
+      invitation.status !== "PREPARING" ||
+      invitation.acceptedAt !== null ||
+      invitation.expiresAt <= now ||
+      (
+        invitation.leaseExpiresAt !== null &&
+        invitation.leaseExpiresAt > now
+      )
+    ) {
+      return "INVITATION_NOT_RECOVERABLE";
+    }
+
+    if (
+      (
+        invitation.authUserId !== null &&
+        invitation.authUserId !== options.authUserId
+      ) ||
+      (
+        invitation.membership !== null &&
+        (
+          invitation.membership.clubId !== club.id ||
+          invitation.membership.userId !== options.authUserId ||
+          invitation.membership.status !== "INVITED"
+        )
+      )
+    ) {
+      return "AUTH_USER_MISMATCH";
+    }
+
+    // ID未記録でも、運営者が確認した既知IDをAuthで照合してからDBへ渡す。
+    const user = await dependencies.getAuthUser({
+      authUserId: options.authUserId,
+      email: invitation.email,
+    });
+
+    if (
+      !user ||
+      user.id !== options.authUserId ||
+      normalizeEmail(user.email) !== invitation.email
+    ) {
+      return "AUTH_USER_MISMATCH";
+    }
+
+    const byEmail = await db.appUser.findUnique({
+      where: {
+        email: invitation.email,
+      },
+      select: {
+        id: true,
+      },
+    });
+    const byId = await db.appUser.findUnique({
+      where: {
+        id: user.id,
+      },
+      select: {
+        email: true,
+      },
+    });
+    const membership = await db.clubMembership.findUnique({
+      where: {
+        clubId_userId: {
+          clubId: club.id,
+          userId: user.id,
+        },
+      },
+      select: {
+        id: true,
+        status: true,
+      },
+    });
+
+    if (
+      (byEmail && byEmail.id !== user.id) ||
+      (byId?.email && normalizeEmail(byId.email) !== invitation.email) ||
+      (
+        membership &&
+        (
+          membership.id !== invitation.membershipId ||
+          membership.status !== "INVITED"
+        )
+      )
+    ) {
+      return "APP_USER_OR_MEMBERSHIP_MISMATCH";
+    }
+
+    if (options.mode === "dry-run") {
+      return "DRY_RUN_READY";
+    }
+
+    const claimedAt = new Date();
+    const claimToken = randomUUID();
+    const leaseExpiresAt = new Date(claimedAt.getTime() + 5 * 60 * 1_000);
+    // 再送APIを流用せず、確認したPREPARINGの処理権だけを条件付きで取得する。
+    // updatedAtとOWNER条件も含め、確認後の変更・取消・期限切れ・再送を拒否する。
+    const updated = await db.clubInvitation.updateMany({
+      where: {
+        id: invitation.id,
+        clubId: club.id,
+        updatedAt: invitation.updatedAt,
+        status: "PREPARING",
+        acceptedAt: null,
+        authUserId: invitation.authUserId,
+        membershipId: invitation.membershipId,
+        expiresAt: {
+          gt: claimedAt,
+        },
+        OR: [
+          {
+            leaseExpiresAt: null,
+          },
+          {
+            leaseExpiresAt: {
+              lte: claimedAt,
+            },
+          },
+        ],
+        club: {
+          is: {
+            slug: options.clubSlug,
+            memberships: {
+              some: {
+                id: owner.id,
+                role: "OWNER",
+                status: "ACTIVE",
+              },
+            },
+          },
+        },
+      },
+      data: {
+        claimToken,
+        leaseExpiresAt,
+      },
+    });
+
+    if (updated.count !== 1) {
+      return "CLAIM_LOST";
+    }
+
+    claim = {
+      clubId: club.id,
+      actorMembershipId: owner.id,
+      invitationId: invitation.id,
+      claimToken,
+    };
+    const recorded = await dependencies.recordAuthUser({
+      ...claim,
+      verifiedAuthUser: user,
+    });
+
+    if (recorded.outcome !== "UPDATED") {
+      return recorded.outcome;
+    }
+
+    const result = await dependencies.recoverPreparation({
+      clubId: club.id,
+      actorMembershipId: owner.id,
+      invitation: {
+        id: invitation.id,
+        clubId: club.id,
+        email: invitation.email,
+        name: invitation.name,
+        role: invitation.role,
+        status: "PREPARING",
+        authUserId: user.id,
+        existingUserId: invitation.membership?.userId ?? byEmail?.id ?? null,
+        membershipId: invitation.membershipId,
+        claimToken,
+        leaseExpiresAt,
+        expiresAt: invitation.expiresAt,
+        attemptCount: invitation.attemptCount,
+      },
+    });
+
+    return result.outcome;
+  } catch {
+    return "RECOVERY_FAILED";
+  } finally {
+    if (claim) {
+      try {
+        // Serviceが解除済みならCLAIM_LOSTになる。別処理のclaimは解除しない。
+        await dependencies.releaseClaim(claim);
+      } catch {
+        // 解除失敗時はlease期限後に確認し直す。例外原文は表示しない。
+      }
+    }
+  }
+}
+
+// CLIで直接実行した場合だけ既存クライアントを読み込み、必ず接続を閉じる。
+async function main(): Promise<void> {
+  let db: PrismaClient | undefined;
+
+  try {
+    const options = parseRecoveryOptions(process.argv.slice(2));
+    const database = await import("../src/infrastructure/prisma/client");
+    db = database.prisma;
+    const repository = await import(
+      "../src/infrastructure/prisma/repositories/club-invitation-repository"
+    );
+    const auth = await import("../src/infrastructure/supabase/club-invitation-auth");
+    const service = await import("../src/application/club/invitation/recover-club-invitation");
+    const outcome = await recoverClubInvitation(options, {
+      db,
+      getAuthUser: auth.getClubInvitationAuthUserById,
+      recordAuthUser: repository.recordClubInvitationAuthUser,
+      recoverPreparation: service.recoverClubInvitationPreparation,
+      releaseClaim: repository.releaseClubInvitationClaim,
+    });
+
+    console.log(JSON.stringify({
+      clubSlug: options.clubSlug,
+      clubId: options.clubId,
+      invitationId: options.invitationId,
+      actorMembershipId: options.actorMembershipId,
+      mode: options.mode,
+      outcome,
+    }));
+
+    if (outcome !== "DRY_RUN_READY" && outcome !== "RECOVERED") {
+      process.exitCode = 1;
+    }
+  } catch {
+    console.error("復旧に失敗しました。実行環境・確認用ID・実行モードを確認してください。");
+    process.exitCode = 1;
+  } finally {
+    try {
+      await db?.$disconnect();
+    } catch {
+      process.exitCode = 1;
+    }
+  }
+}
+
+// tsxのCommonJS実行とVitestのESM importの両方で、直接起動だけを判定する。
+const directlyExecuted = typeof require !== "undefined"
+  ? require.main === module
+  : Boolean(
+      process.argv[1] &&
+      import.meta.url === pathToFileURL(process.argv[1]).href,
+    );
+
+if (directlyExecuted) {
+  void main();
+}
