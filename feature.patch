@@ -0,0 +1,437 @@
+import "server-only";
+
+import { randomUUID } from "node:crypto";
+import { Prisma } from "@prisma/client";
+import {
+  validateClubMemberInviteFormValues,
+  type ValidClubMemberInviteInput,
+} from "@/domain/club/invitation/invitation-form";
+import {
+  buildClubInvitationExpiresAt,
+  evaluateClubInvitationCancellation,
+  evaluateClubInvitationResend,
+  isUsableClubInvitation,
+  type ClubInvitationOperationViolation,
+} from "@/domain/club/invitation/invitation-policy";
+import { normalizeEmail } from "@/domain/shared/email";
+import { DomainError } from "@/domain/shared/domain-error";
+import { convertPrismaError } from "@/src/infrastructure/prisma/prisma-error";
+import { prisma } from "@/src/infrastructure/prisma/client";
+import type { ClubInvitationStatus, ClubMemberRole, ClubMembershipStatus } from "@/types/prisma";
+
+const ACTIVE_STATUSES: ClubInvitationStatus[] = ["PREPARING", "READY_TO_SEND", "SENT", "EMAIL_FAILED"];
+const LEASE_MILLISECONDS = 5 * 60 * 1_000;
+const MAX_TRANSACTION_RETRIES = 3;
+
+type OwnerInput = { clubId: string; actorMembershipId: string; now?: Date };
+type InvitationInput = OwnerInput & { invitationId: string };
+type ClaimInput = InvitationInput & { claimToken: string };
+type VerifiedAuthUser = { id: string; email: string };
+type DuplicateReason = "ACTIVE_INVITATION" | "TOKEN_HASH" | "CLAIM_TOKEN" | "MEMBERSHIP" | "APP_USER";
+type RuleViolation = ClubInvitationOperationViolation | "AUTH_USER_MISMATCH" | "TOKEN_NOT_ROTATED";
+
+export type ClubInvitationFailure =
+  | { outcome: "ACTOR_NOT_ACTIVE_OWNER" }
+  | { outcome: "NOT_FOUND" }
+  | { outcome: "CLAIM_LOST" }
+  | { outcome: "RULE_VIOLATION"; reason: RuleViolation }
+  | { outcome: "MEMBERSHIP_EXISTS"; membershipStatus: ClubMembershipStatus }
+  | { outcome: "DUPLICATE"; reason: DuplicateReason };
+
+// This DTO is only for server-side preparation and delivery, never for a Page.
+export type ClubInvitationProcessing = {
+  id: string; clubId: string; email: string; name: string | null;
+  role: ClubMemberRole; status: ClubInvitationStatus;
+  authUserId: string | null; existingUserId: string | null;
+  membershipId: string | null; claimToken: string;
+  leaseExpiresAt: Date; expiresAt: Date; attemptCount: number;
+};
+
+export type ClubInvitationForOwner = {
+  id: string; name: string | null; email: string; role: ClubMemberRole;
+  status: ClubInvitationStatus; hasMembership: boolean;
+  membershipStatus: ClubMembershipStatus | null;
+  createdAt: Date; expiresAt: Date; emailSentAt: Date | null;
+  lastAttemptAt: Date | null; leaseExpiresAt: Date | null;
+  canResend: boolean; canCancel: boolean; needsPreparationRetry: boolean;
+};
+
+type StoredInvitation = Prisma.ClubInvitationGetPayload<{
+  include: { membership: { select: { id: true; clubId: true; userId: true; role: true; status: true } } };
+}>;
+
+class TransactionAbort extends Error {
+  constructor(readonly result: ClubInvitationFailure) { super("Invitation transaction aborted"); }
+}
+
+function object(value: unknown): Record<string, unknown> | null {
+  return typeof value === "object" && value !== null ? value as Record<string, unknown> : null;
+}
+
+// Prisma 7 adapter-pg can expose expression-index fields through driverAdapterError,
+// including "lower(email" without a closing parenthesis. Never inspect error messages.
+function duplicateReason(error: Prisma.PrismaClientKnownRequestError): DuplicateReason | null {
+  const meta = object(error.meta);
+  const cause = object(object(meta?.driverAdapterError)?.cause);
+  const constraint = object(cause?.constraint);
+  const target = meta?.target ?? constraint?.fields ?? constraint?.index;
+  const names: Record<string, DuplicateReason> = {
+    ClubInvitation_active_email_key: "ACTIVE_INVITATION",
+    ClubInvitation_tokenHash_key: "TOKEN_HASH",
+    ClubInvitation_claimToken_key: "CLAIM_TOKEN",
+    ClubInvitation_membershipId_key: "MEMBERSHIP",
+    ClubMembership_clubId_userId_key: "MEMBERSHIP",
+    AppUser_email_key: "APP_USER",
+  };
+  if (typeof target === "string") return names[target] ?? null;
+  if (!Array.isArray(target) || !target.every((field) => typeof field === "string")) return null;
+  const fields = target.map((field: string) => field.replaceAll('"', ""));
+  const model = meta?.modelName;
+  if ((model === "ClubInvitation" || model === undefined) && fields.length === 2 &&
+      fields.includes("clubId") && fields.some((field) => ["email", "lower(email", "lower(email)"].includes(field))) {
+    return "ACTIVE_INVITATION";
+  }
+  if (fields.length === 1) {
+    if (fields[0] === "tokenHash") return "TOKEN_HASH";
+    if (fields[0] === "claimToken") return "CLAIM_TOKEN";
+    if (fields[0] === "membershipId") return "MEMBERSHIP";
+    if (fields[0] === "email" && (model === "AppUser" || model === undefined)) return "APP_USER";
+  }
+  if ((model === "ClubMembership" || model === undefined) &&
+      fields.length === 2 && fields.includes("clubId") && fields.includes("userId")) return "MEMBERSHIP";
+  return null;
+}
+
+function time(input: { now?: Date }): Date {
+  const now = input.now ?? new Date();
+  if (!Number.isFinite(now.getTime())) throw new DomainError("VALIDATION", "処理日時が正しくありません。");
+  return now;
+}
+
+function assertTokenHash(tokenHash: string): void {
+  if (!/^[a-f0-9]{64}$/.test(tokenHash)) {
+    throw new DomainError("VALIDATION", "招待トークンの形式が正しくありません。");
+  }
+}
+
+async function ownerTransaction<T>(
+  input: OwnerInput,
+  operation: (tx: Prisma.TransactionClient, now: Date) => Promise<T>,
+): Promise<T | ClubInvitationFailure> {
+  for (let attempt = 0; ; attempt += 1) {
+    try {
+      return await prisma.$transaction(async (tx) => {
+        const now = time(input);
+        const actor = await tx.clubMembership.findFirst({
+          where: { id: input.actorMembershipId, clubId: input.clubId, role: "OWNER", status: "ACTIVE" },
+          select: { id: true },
+        });
+        if (!actor) return { outcome: "ACTOR_NOT_ACTIVE_OWNER" as const };
+        return operation(tx, now);
+      }, { isolationLevel: Prisma.TransactionIsolationLevel.Serializable });
+    } catch (error) {
+      if (error instanceof TransactionAbort) return error.result;
+      if (error instanceof Prisma.PrismaClientKnownRequestError) {
+        if (error.code === "P2034" && attempt < MAX_TRANSACTION_RETRIES) continue;
+        if (error.code === "P2002") {
+          const reason = duplicateReason(error);
+          if (reason) return { outcome: "DUPLICATE", reason };
+        }
+      }
+      const safe = convertPrismaError(error);
+      // Preserve the fixed public error, without retaining DB messages or input in cause.
+      throw new DomainError(safe.code, safe.publicMessage);
+    }
+  }
+}
+
+async function stored(tx: Prisma.TransactionClient, input: InvitationInput): Promise<StoredInvitation | null> {
+  const row = await tx.clubInvitation.findFirst({
+    where: { id: input.invitationId, clubId: input.clubId },
+    include: { membership: { select: { id: true, clubId: true, userId: true, role: true, status: true } } },
+  });
+  if (row?.membership && row.membership.clubId !== input.clubId) {
+    throw new DomainError("INVALID_REFERENCE", "関連するデータの組み合わせを確認できません。");
+  }
+  return row;
+}
+
+function claimWhere(input: ClaimInput, now: Date, statuses: ClubInvitationStatus[]): Prisma.ClubInvitationWhereInput {
+  return {
+    id: input.invitationId, clubId: input.clubId, claimToken: input.claimToken,
+    acceptedAt: null, status: { in: statuses },
+    leaseExpiresAt: { gt: now }, expiresAt: { gt: now },
+  };
+}
+
+function ownsClaim(row: StoredInvitation, input: ClaimInput, now: Date, statuses: ClubInvitationStatus[]): boolean {
+  return input.claimToken.length > 0 && row.claimToken === input.claimToken &&
+    row.acceptedAt === null && statuses.includes(row.status) &&
+    row.leaseExpiresAt !== null && row.leaseExpiresAt > now && row.expiresAt > now &&
+    (!row.membership || row.membership.status === "INVITED");
+}
+
+async function processing(tx: Prisma.TransactionClient, row: StoredInvitation): Promise<ClubInvitationProcessing> {
+  if (!row.claimToken || !row.leaseExpiresAt) throw new DomainError("INTERNAL", "招待の処理権を確認できません。");
+  const user = row.membership ? null : await tx.appUser.findUnique({ where: { email: row.email }, select: { id: true } });
+  return {
+    id: row.id, clubId: row.clubId, email: row.email, name: row.name,
+    role: row.membership?.role ?? row.role, status: row.status,
+    authUserId: row.authUserId, existingUserId: row.membership?.userId ?? user?.id ?? null,
+    membershipId: row.membershipId, claimToken: row.claimToken,
+    leaseExpiresAt: row.leaseExpiresAt, expiresAt: row.expiresAt, attemptCount: row.attemptCount,
+  };
+}
+
+async function expire(tx: Prisma.TransactionClient, clubId: string, now: Date, excludeId?: string): Promise<number> {
+  const updated = await tx.clubInvitation.updateMany({
+    where: { clubId, ...(excludeId ? { id: { not: excludeId } } : {}), status: { in: ACTIVE_STATUSES }, acceptedAt: null, expiresAt: { lte: now } },
+    data: { status: "EXPIRED", claimToken: null, leaseExpiresAt: null },
+  });
+  return updated.count;
+}
+
+export async function findClubInvitationsForOwner(input: OwnerInput) {
+  return ownerTransaction(input, async (tx, now) => {
+    const rows = await tx.clubInvitation.findMany({
+      where: { clubId: input.clubId },
+      orderBy: [{ createdAt: "asc" }, { id: "asc" }],
+      select: {
+        id: true, name: true, email: true, role: true, status: true, acceptedAt: true,
+        createdAt: true, expiresAt: true, emailSentAt: true, lastAttemptAt: true, leaseExpiresAt: true,
+        membership: { select: { clubId: true, role: true, status: true } },
+      },
+    });
+    const invitations: ClubInvitationForOwner[] = rows.map((row) => {
+      if (row.membership && row.membership.clubId !== input.clubId) {
+        throw new DomainError("INVALID_REFERENCE", "関連するデータの組み合わせを確認できません。");
+      }
+      return {
+        id: row.id, name: row.name, email: row.email, role: row.membership?.role ?? row.role,
+        status: row.status, hasMembership: row.membership !== null,
+        membershipStatus: row.membership?.status ?? null,
+        createdAt: row.createdAt, expiresAt: row.expiresAt, emailSentAt: row.emailSentAt,
+        lastAttemptAt: row.lastAttemptAt, leaseExpiresAt: row.leaseExpiresAt,
+        canResend: evaluateClubInvitationResend({ invitation: row, membership: row.membership, now }).allowed,
+        canCancel: evaluateClubInvitationCancellation({ invitation: row, membership: row.membership }).allowed,
+        needsPreparationRetry: row.status === "PREPARING" && row.acceptedAt === null &&
+          (row.leaseExpiresAt === null || row.leaseExpiresAt <= now),
+      };
+    });
+    return { outcome: "FOUND" as const, invitations };
+  });
+}
+
+export async function reserveClubInvitation(
+  input: OwnerInput & ValidClubMemberInviteInput & { tokenHash: string },
+) {
+  assertTokenHash(input.tokenHash);
+  const validation = validateClubMemberInviteFormValues(input);
+  if (!validation.success) throw new DomainError("VALIDATION", "招待する入力値を確認してください。");
+  return ownerTransaction(input, async (tx, now) => {
+    await expire(tx, input.clubId, now);
+    const user = await tx.appUser.findUnique({ where: { email: validation.data.email }, select: { id: true } });
+    const membership = user && await tx.clubMembership.findUnique({
+      where: { clubId_userId: { clubId: input.clubId, userId: user.id } }, select: { status: true },
+    });
+    if (membership) return { outcome: "MEMBERSHIP_EXISTS" as const, membershipStatus: membership.status };
+    const duplicate = await tx.clubInvitation.findFirst({
+      where: { clubId: input.clubId, email: validation.data.email, status: { in: ACTIVE_STATUSES } },
+      select: { id: true },
+    });
+    if (duplicate) return { outcome: "DUPLICATE" as const, reason: "ACTIVE_INVITATION" as const };
+    const row = await tx.clubInvitation.create({
+      data: {
+        clubId: input.clubId, ...validation.data, tokenHash: input.tokenHash,
+        status: "PREPARING", expiresAt: buildClubInvitationExpiresAt(now),
+        invitedByMembershipId: input.actorMembershipId, attemptCount: 1, lastAttemptAt: now,
+        claimToken: randomUUID(), leaseExpiresAt: new Date(now.getTime() + LEASE_MILLISECONDS),
+      },
+      include: { membership: { select: { id: true, clubId: true, userId: true, role: true, status: true } } },
+    });
+    return { outcome: "RESERVED" as const, invitation: await processing(tx, row) };
+  });
+}
+
+export async function claimClubInvitationResend(input: InvitationInput & { tokenHash: string }) {
+  assertTokenHash(input.tokenHash);
+  return ownerTransaction(input, async (tx, now) => {
+    const row = await stored(tx, input);
+    if (!row) return { outcome: "NOT_FOUND" as const };
+    const evaluation = evaluateClubInvitationResend({ invitation: row, membership: row.membership, now });
+    if (!evaluation.allowed) return { outcome: "RULE_VIOLATION" as const, reason: evaluation.violation };
+    if (row.tokenHash === input.tokenHash) return { outcome: "RULE_VIOLATION" as const, reason: "TOKEN_NOT_ROTATED" as const };
+    // Keep a still-PREPARING target eligible for the Domain preparation retry.
+    await expire(tx, input.clubId, now, row.id);
+    const duplicate = await tx.clubInvitation.findFirst({
+      where: { clubId: input.clubId, email: row.email, id: { not: row.id }, status: { in: ACTIVE_STATUSES } },
+      select: { id: true },
+    });
+    if (duplicate) return { outcome: "DUPLICATE" as const, reason: "ACTIVE_INVITATION" as const };
+    const updated = await tx.clubInvitation.updateMany({
+      where: {
+        id: row.id, clubId: input.clubId, acceptedAt: null,
+        status: row.status, claimToken: row.claimToken,
+        OR: [{ leaseExpiresAt: null }, { leaseExpiresAt: { lte: now } }],
+      },
+      data: {
+        status: "PREPARING", tokenHash: input.tokenHash, expiresAt: buildClubInvitationExpiresAt(now),
+        claimToken: randomUUID(), leaseExpiresAt: new Date(now.getTime() + LEASE_MILLISECONDS),
+        attemptCount: { increment: 1 }, lastAttemptAt: now, emailSendError: null,
+      },
+    });
+    if (updated.count !== 1) throw new TransactionAbort({ outcome: "CLAIM_LOST" });
+    const claimed = await stored(tx, input);
+    if (!claimed) throw new TransactionAbort({ outcome: "NOT_FOUND" });
+    return { outcome: "CLAIMED" as const, invitation: await processing(tx, claimed) };
+  });
+}
+
+async function matchesAuthUser(tx: Prisma.TransactionClient, row: StoredInvitation, user: VerifiedAuthUser): Promise<boolean> {
+  if (!user.id || normalizeEmail(user.email) !== row.email ||
+      (row.authUserId !== null && row.authUserId !== user.id) ||
+      (row.membership !== null && row.membership.userId !== user.id)) return false;
+  const byEmail = await tx.appUser.findUnique({ where: { email: row.email }, select: { id: true } });
+  const byId = await tx.appUser.findUnique({ where: { id: user.id }, select: { email: true } });
+  return (!byEmail || byEmail.id === user.id) &&
+    (!byId || byId.email === null || normalizeEmail(byId.email) === row.email);
+}
+
+export async function recordClubInvitationAuthUser(input: ClaimInput & { verifiedAuthUser: VerifiedAuthUser }) {
+  return ownerTransaction(input, async (tx, now) => {
+    const row = await stored(tx, input);
+    if (!row) return { outcome: "NOT_FOUND" as const };
+    if (!ownsClaim(row, input, now, ["PREPARING"])) return { outcome: "CLAIM_LOST" as const };
+    if (!await matchesAuthUser(tx, row, input.verifiedAuthUser)) {
+      return { outcome: "RULE_VIOLATION" as const, reason: "AUTH_USER_MISMATCH" as const };
+    }
+    const updated = await tx.clubInvitation.updateMany({
+      where: { ...claimWhere(input, now, ["PREPARING"]), authUserId: row.authUserId },
+      data: { authUserId: input.verifiedAuthUser.id },
+    });
+    return updated.count === 1 ? { outcome: "UPDATED" as const } : { outcome: "CLAIM_LOST" as const };
+  });
+}
+
+// verifiedAuthUser must come from the server-side Auth adapter, never from a browser.
+export async function completeClubInvitationPreparation(input: ClaimInput & { verifiedAuthUser: VerifiedAuthUser }) {
+  return ownerTransaction(input, async (tx, now) => {
+    const row = await stored(tx, input);
+    if (!row) return { outcome: "NOT_FOUND" as const };
+    if (!ownsClaim(row, input, now, ["PREPARING"])) return { outcome: "CLAIM_LOST" as const };
+    if (row.authUserId !== input.verifiedAuthUser.id || !await matchesAuthUser(tx, row, input.verifiedAuthUser)) {
+      return { outcome: "RULE_VIOLATION" as const, reason: "AUTH_USER_MISMATCH" as const };
+    }
+    const existing = await tx.clubMembership.findUnique({
+      where: { clubId_userId: { clubId: input.clubId, userId: row.authUserId } },
+      select: { id: true, status: true },
+    });
+    if (existing && (existing.id !== row.membershipId || existing.status !== "INVITED")) {
+      return { outcome: "MEMBERSHIP_EXISTS" as const, membershipStatus: existing.status };
+    }
+    if (row.membershipId !== null && (!existing || existing.id !== row.membershipId)) {
+      throw new TransactionAbort({ outcome: "CLAIM_LOST" });
+    }
+    const user = await tx.appUser.findUnique({ where: { id: row.authUserId }, select: { id: true } });
+    if (!user) await tx.appUser.create({ data: { id: row.authUserId, email: row.email, name: row.name }, select: { id: true } });
+    const membership = existing ?? await tx.clubMembership.create({
+      data: { clubId: input.clubId, userId: row.authUserId, role: row.role, status: "INVITED" },
+      select: { id: true, status: true },
+    });
+    const updated = await tx.clubInvitation.updateMany({
+      where: { ...claimWhere(input, now, ["PREPARING"]), authUserId: row.authUserId, membershipId: row.membershipId },
+      data: { membershipId: membership.id, status: "READY_TO_SEND", emailSendError: null },
+    });
+    if (updated.count !== 1) throw new TransactionAbort({ outcome: "CLAIM_LOST" });
+    const prepared = await stored(tx, input);
+    if (!prepared) throw new TransactionAbort({ outcome: "NOT_FOUND" });
+    return { outcome: "PREPARED" as const, invitation: await processing(tx, prepared) };
+  });
+}
+
+async function markEmail(input: ClaimInput, status: "SENT" | "EMAIL_FAILED") {
+  return ownerTransaction(input, async (tx, now) => {
+    const row = await stored(tx, input);
+    if (!row) return { outcome: "NOT_FOUND" as const };
+    if (!ownsClaim(row, input, now, ["READY_TO_SEND"]) || !row.membership) return { outcome: "CLAIM_LOST" as const };
+    const updated = await tx.clubInvitation.updateMany({
+      where: {
+        ...claimWhere(input, now, ["READY_TO_SEND"]),
+        membership: { is: { clubId: input.clubId, status: "INVITED" } },
+      },
+      data: {
+        status, ...(status === "SENT" ? { emailSentAt: now } : {}),
+        emailSendError: status === "EMAIL_FAILED" ? "EMAIL_SEND_FAILED" : null,
+        claimToken: null, leaseExpiresAt: null,
+      },
+    });
+    return updated.count === 1 ? { outcome: "UPDATED" as const } : { outcome: "CLAIM_LOST" as const };
+  });
+}
+
+export async function markClubInvitationEmailSent(input: ClaimInput) { return markEmail(input, "SENT"); }
+export async function markClubInvitationEmailFailed(input: ClaimInput) { return markEmail(input, "EMAIL_FAILED"); }
+
+export async function releaseClubInvitationClaim(input: ClaimInput) {
+  return ownerTransaction(input, async (tx, now) => {
+    const row = await stored(tx, input);
+    if (!row) return { outcome: "NOT_FOUND" as const };
+    if (!ownsClaim(row, input, now, ["PREPARING", "READY_TO_SEND"])) return { outcome: "CLAIM_LOST" as const };
+    const updated = await tx.clubInvitation.updateMany({
+      where: claimWhere(input, now, ["PREPARING", "READY_TO_SEND"]),
+      data: { claimToken: null, leaseExpiresAt: null },
+    });
+    return updated.count === 1 ? { outcome: "UPDATED" as const } : { outcome: "CLAIM_LOST" as const };
+  });
+}
+
+export async function cancelClubInvitation(input: InvitationInput) {
+  return ownerTransaction(input, async (tx) => {
+    const row = await stored(tx, input);
+    if (!row) return { outcome: "NOT_FOUND" as const };
+    const evaluation = evaluateClubInvitationCancellation({ invitation: row, membership: row.membership });
+    if (!evaluation.allowed) return { outcome: "RULE_VIOLATION" as const, reason: evaluation.violation };
+    if (!row.membershipId) throw new TransactionAbort({ outcome: "NOT_FOUND" });
+    const updated = await tx.clubInvitation.updateMany({
+      where: { id: row.id, clubId: input.clubId, status: row.status, acceptedAt: null, membershipId: row.membershipId },
+      data: { status: "CANCELLED", claimToken: null, leaseExpiresAt: null },
+    });
+    if (updated.count !== 1) throw new TransactionAbort({ outcome: "CLAIM_LOST" });
+    const deleted = await tx.clubMembership.deleteMany({
+      where: { id: row.membershipId, clubId: input.clubId, status: "INVITED" },
+    });
+    if (deleted.count !== 1) throw new TransactionAbort({ outcome: "CLAIM_LOST" });
+    return { outcome: "CANCELLED" as const };
+  });
+}
+
+export async function expireClubInvitations(input: OwnerInput) {
+  return ownerTransaction(input, async (tx, now) => ({ outcome: "EXPIRED" as const, count: await expire(tx, input.clubId, now) }));
+}
+
+// authenticatedUserId is supplied by server-side authentication; this only reads.
+export async function findUsableClubInvitationByTokenHash(
+  input: { clubId: string; tokenHash: string; authenticatedUserId: string; now?: Date },
+) {
+  assertTokenHash(input.tokenHash);
+  const now = time(input);
+  if (!input.authenticatedUserId) return null;
+  try {
+    const row = await prisma.clubInvitation.findFirst({
+      where: {
+        clubId: input.clubId, tokenHash: input.tokenHash, authUserId: input.authenticatedUserId,
+        status: { in: ["READY_TO_SEND", "SENT", "EMAIL_FAILED"] }, acceptedAt: null, expiresAt: { gt: now },
+        membership: { is: { clubId: input.clubId, userId: input.authenticatedUserId, status: "INVITED" } },
+      },
+      select: {
+        id: true, clubId: true, status: true, acceptedAt: true, expiresAt: true,
+        membership: { select: { id: true, role: true, status: true } },
+      },
+    });
+    if (!row?.membership || !isUsableClubInvitation({ invitation: row, membership: row.membership, now })) return null;
+    return { id: row.id, clubId: row.clubId, membershipId: row.membership.id, role: row.membership.role, expiresAt: row.expiresAt };
+  } catch (error) {
+    const safe = convertPrismaError(error);
+    throw new DomainError(safe.code, safe.publicMessage);
+  }
+}
