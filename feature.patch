@@ -0,0 +1,270 @@
+// lib/mail/club-invitation-mail.ts
+// 招待メールの本文を生成し、送信試行の冪等キー付きでResendへ渡す。
+
+import "server-only";
+
+import { z } from "zod";
+
+import {
+  getClubMemberRoleLabel,
+} from "@/domain/club/club-member-role";
+import {
+  CLUB_MEMBER_INVITE_EMAIL_MAX_LENGTH,
+} from "@/domain/club/invitation/invitation-form";
+import {
+  formatClubDateTime,
+} from "@/domain/shared/date-time/club-date-time";
+import { DomainError } from "@/domain/shared/domain-error";
+import { normalizeEmail } from "@/domain/shared/email";
+import type { ClubMemberRole } from "@/types/prisma";
+
+import {
+  buildMailFrom,
+  resend,
+} from "./resend";
+
+export type ClubInvitationEmailInput = {
+  email: string;
+  name: string | null;
+  clubName: string;
+  role: ClubMemberRole;
+  expiresAt: Date;
+  timeZone?: string;
+} & (
+  | {
+      kind: "NEW_USER";
+      authLink: string;
+    }
+  | {
+      kind: "EXISTING_USER";
+      invitationUrl: string;
+    }
+);
+
+export type ClubInvitationEmail = {
+  to: string;
+  subject: string;
+  text: string;
+  html: string;
+};
+
+export type ClubInvitationEmailSendResult =
+  | {
+      outcome: "ACCEPTED";
+      emailId: string;
+    }
+  | {
+      outcome: "REJECTED";
+      errorCode: "EMAIL_SEND_FAILED";
+    }
+  | {
+      outcome: "UNKNOWN";
+      errorCode: "EMAIL_SEND_RESULT_UNKNOWN";
+    };
+
+const emailSchema = z.email().max(
+  CLUB_MEMBER_INVITE_EMAIL_MAX_LENGTH,
+);
+const invitationIdSchema = z.uuid();
+
+// 氏名・クラブ名を本文用の一行へ揃え、件名への改行混入も防ぐ。
+function singleLine(value: string): string {
+  return value.replace(/\s+/gu, " ").trim();
+}
+
+// 本文・hrefへ埋め込む値をエスケープし、HTMLや属性の注入を防ぐ。
+function escapeHtml(value: string): string {
+  return value
+    .replaceAll("&", "&amp;")
+    .replaceAll("<", "&lt;")
+    .replaceAll(">", "&gt;")
+    .replaceAll('"', "&quot;")
+    .replaceAll("'", "&#39;");
+}
+
+// サーバーが構築した招待URLを検証し、危険なschemeや資格情報を拒否する。
+function invitationUrl(value: string): string {
+  let url: URL;
+
+  try {
+    url = new URL(value);
+  } catch {
+    throw new DomainError(
+      "VALIDATION",
+      "招待メールのリンクを確認してください。",
+    );
+  }
+
+  if (
+    /[\r\n]/u.test(value) ||
+    (
+      url.protocol !== "https:" &&
+      url.protocol !== "http:"
+    ) ||
+    url.username ||
+    url.password
+  ) {
+    throw new DomainError(
+      "VALIDATION",
+      "招待メールのリンクを確認してください。",
+    );
+  }
+
+  return url.toString();
+}
+
+// 新規ユーザー向けの初回設定案内と、既存ユーザー向けのクラブ参加案内を作る。
+export function buildClubInvitationEmail(
+  input: ClubInvitationEmailInput,
+): ClubInvitationEmail {
+  const email = normalizeEmail(input.email);
+  const name =
+    singleLine(input.name ?? "") ||
+    "ご招待者";
+  const clubName = singleLine(input.clubName);
+  const roleLabel = getClubMemberRoleLabel(
+    input.role,
+  );
+
+  if (
+    !emailSchema.safeParse(email).success ||
+    !clubName ||
+    !roleLabel ||
+    !Number.isFinite(input.expiresAt.getTime())
+  ) {
+    throw new DomainError(
+      "VALIDATION",
+      "招待メールの内容を確認してください。",
+    );
+  }
+
+  const url = invitationUrl(
+    input.kind === "NEW_USER"
+      ? input.authLink
+      : input.invitationUrl,
+  );
+  let expiresAt: string;
+
+  try {
+    expiresAt = formatClubDateTime(
+      input.expiresAt,
+      input.timeZone ?? "Asia/Tokyo",
+    );
+  } catch {
+    throw new DomainError(
+      "VALIDATION",
+      "招待メールの有効期限を確認してください。",
+    );
+  }
+
+  const instructions =
+    input.kind === "NEW_USER"
+      ? "認証リンクからメールアドレスを確認し、初回設定とクラブ参加を進めてください。"
+      : "既存のアカウントでログインし、参加案内からクラブへの参加を進めてください。";
+  const linkLabel =
+    input.kind === "NEW_USER"
+      ? "初回設定とクラブ参加へ進む"
+      : "クラブ参加案内を開く";
+  const deadline =
+    `招待の有効期限：${expiresAt}（${input.timeZone ?? "Asia/Tokyo"}）`;
+
+  return {
+    to: email,
+    subject: `【${clubName}】クラブ参加のご案内`,
+    text: [
+      `${name} 様`,
+      "",
+      `${clubName}から、${roleLabel}として招待されています。`,
+      instructions,
+      "",
+      linkLabel,
+      url,
+      "",
+      deadline,
+      "この招待に心当たりがない場合は、このメールを破棄してください。",
+    ].join("\n"),
+    html: [
+      `<p>${escapeHtml(name)} 様</p>`,
+      `<p>${escapeHtml(clubName)}から、${escapeHtml(roleLabel)}として招待されています。</p>`,
+      `<p>${escapeHtml(instructions)}</p>`,
+      `<p><a href="${escapeHtml(url)}">${escapeHtml(linkLabel)}</a></p>`,
+      `<p>${escapeHtml(deadline)}</p>`,
+      "<p>この招待に心当たりがない場合は、このメールを破棄してください。</p>",
+    ].join("\n"),
+  };
+}
+
+// 同じInvitation・attemptCountは同じキー、新tokenの再送は新しいattemptCountで送る。
+export async function sendClubInvitationEmail(
+  input: ClubInvitationEmailInput & {
+    invitationId: string;
+    attemptCount: number;
+  },
+): Promise<ClubInvitationEmailSendResult> {
+  if (
+    !invitationIdSchema.safeParse(
+      input.invitationId,
+    ).success ||
+    !Number.isSafeInteger(input.attemptCount) ||
+    input.attemptCount < 1
+  ) {
+    throw new DomainError(
+      "VALIDATION",
+      "招待メールの送信試行を確認してください。",
+    );
+  }
+
+  const email = buildClubInvitationEmail(input);
+  const idempotencyKey =
+    `club-invitation/${input.invitationId}/${input.attemptCount}`;
+
+  try {
+    const response = await resend.emails.send(
+      {
+        from: buildMailFrom(input.clubName),
+        to: email.to,
+        subject: email.subject,
+        text: email.text,
+        html: email.html,
+      },
+      {
+        idempotencyKey,
+      },
+    );
+
+    if (
+      !response.error &&
+      response.data?.id
+    ) {
+      return {
+        outcome: "ACCEPTED",
+        emailId: response.data.id,
+      };
+    }
+
+    // 4xxの明確な拒否だけを失敗扱いにし、timeout・競合・5xxは送信結果不明とする。
+    const statusCode =
+      response.error?.statusCode;
+
+    if (
+      typeof statusCode === "number" &&
+      statusCode >= 400 &&
+      statusCode < 500 &&
+      statusCode !== 408 &&
+      statusCode !== 409 &&
+      response.error?.name !== "application_error"
+    ) {
+      return {
+        outcome: "REJECTED",
+        errorCode: "EMAIL_SEND_FAILED",
+      };
+    }
+  } catch {
+    // 通信切断でも配送済みの可能性があるため、原文やcauseを返さず結果不明にする。
+  }
+
+  return {
+    outcome: "UNKNOWN",
+    errorCode: "EMAIL_SEND_RESULT_UNKNOWN",
+  };
+}
