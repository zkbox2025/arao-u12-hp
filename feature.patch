+// tests/mvp/next-e2e-server.test.ts
+// Next・DB・Authを初期化せず、専用production serverの起動前ガードを確認する。
+import {
+  mkdtempSync,
+  realpathSync,
+  rmSync,
+  writeFileSync,
+} from "node:fs";
