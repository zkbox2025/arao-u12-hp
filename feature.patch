+// domain/club/support/support-report-form.ts
+// サポート報告の許可入力、表示用values、検証結果を定義する。
+
+import type {
+  ActionState,
+  FieldErrors,
+} from "@/domain/shared/action-state";
+import type {
+  SupportReportCategory,
+} from "@/types/prisma";
+
+export const SUPPORT_REPORT_MESSAGE_MAX_LENGTH = 2000;
+
+export const SUPPORT_REPORT_CATEGORY_OPTIONS = [
+  {
+    value: "BUG",
+    label: "不具合",
+  },
+  {
+    value: "QUESTION",
+    label: "質問",
+  },
+  {
+    value: "REQUEST",
+    label: "改善要望",
+  },
+  {
+    value: "OTHER",
+    label: "その他",
+  },
+] as const satisfies readonly {
+  value: SupportReportCategory;
+  label: string;
+}[];
+
+export type SupportReportFormValues = {
+  category: SupportReportCategory;
+  message: string;
+};
+
+export type SupportReportFormField = keyof SupportReportFormValues;
+
+export type SupportReportActionState = ActionState<
+  SupportReportFormValues,
+  SupportReportFormField
+>;
+
+export const SUPPORT_REPORT_INITIAL_VALUES: Readonly<SupportReportFormValues> = {
+  category: "BUG",
+  message: "",
+};
+
+export const SUPPORT_REPORT_ACCEPTED_MESSAGE =
+  "不具合報告を受け付けました。開発チームにて確認し、サービスの改善に役立てさせていただきます。ご協力ありがとうございます。";
+
+export const SUPPORT_REPORT_FAILED_MESSAGE =
+  "送信できませんでした。時間をおいてもう一度お試しください。";
+
+export type SupportReportValidationResult =
+  | {
+      success: true;
+      data: SupportReportFormValues;
+    }
+  | {
+      success: false;
+      fieldErrors: FieldErrors<SupportReportFormField>;
+    };
+
+// DBに定義済みの4種だけを許可し、不正値を既定値へ丸めて保存しない。
+function isSupportReportCategory(value: unknown): value is SupportReportCategory {
+  return SUPPORT_REPORT_CATEGORY_OPTIONS.some((option) => option.value === value);
+}
+
+// 単一の文字列だけを取り出し、File・欠損・重複を入力として採用しない。
+function singleFormString(
+  formData: FormData,
+  field: SupportReportFormField,
+): string | undefined {
+  const entries = formData instanceof FormData ? formData.getAll(field) : [];
+  return (
+    entries.length === 1 &&
+    typeof entries[0] === "string"
+  ) ? entries[0] : undefined;
+}
+
+// エラー表示用の値だけを復元する。切り詰めた本文を保存前の検証へ渡してはいけない。
+export function buildSupportReportFormValues(
+  formData: FormData,
+): SupportReportFormValues {
+  const category = singleFormString(formData, "category");
+  const message = singleFormString(formData, "message");
+  return {
+    category: isSupportReportCategory(category) ? category : "BUG",
+    message: (message ?? "").slice(0, SUPPORT_REPORT_MESSAGE_MAX_LENGTH),
+  };
+}
+
+// 許可項目だけを検証・正規化する。本人・クラブ・報告者snapshotは後続層で再確認する。
+export function validateSupportReportInput(
+  input: unknown,
+): SupportReportValidationResult {
+  const record = (
+    typeof input === "object" &&
+    input !== null &&
+    !Array.isArray(input)
+  ) ? input as Record<string, unknown> : undefined;
+  const category = isSupportReportCategory(record?.category) ? record.category : null;
+  const message = typeof record?.message === "string" ? record.message.trim() : "";
+  const fieldErrors: FieldErrors<SupportReportFormField> = {};
+
+  if (category === null) {
+    fieldErrors.category = ["種別を選択してください。"];
+  }
+  if (!message) {
+    fieldErrors.message = ["内容を入力してください。"];
+  } else if (message.length > SUPPORT_REPORT_MESSAGE_MAX_LENGTH) {
+    fieldErrors.message = ["内容は2000文字以内で入力してください。"];
+  }
+  if (
+    category === null ||
+    fieldErrors.message !== undefined
+  ) {
+    return {
+      success: false,
+      fieldErrors,
+    };
+  }
+  return {
+    success: true,
+    data: {
+      category,
+      message,
+    },
+  };
+}
+
+// 表示用valuesを経由せず、元のFormDataを厳密に検証する。
+export function parseSupportReportFormData(
+  formData: FormData,
+): SupportReportValidationResult {
+  return validateSupportReportInput({
+    category: singleFormString(formData, "category"),
+    message: singleFormString(formData, "message"),
+  });
+}
