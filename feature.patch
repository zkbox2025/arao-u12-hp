+// app/(club-app)/club-invitations/accept/actions.ts
+"use server";
+
+import "server-only";
+
+import { cookies } from "next/headers";
+import { unstable_rethrow } from "next/navigation";
+
+import {
+  completeClubInvitationAction,
+} from "@/app/(club-app)/welcome/actions";
+import type {
+  WelcomeActionState,
+} from "@/domain/club/invitation/acceptance-form";
+import {
+  createRequestId,
+  isRequestId,
+} from "@/domain/shared/request-id";
+import {
+  CLUB_INVITATION_CONTEXT_COOKIE_NAME,
+  parseClubInvitationContext,
+} from "@/src/infrastructure/security/club-invitation-context";
+import {
+  getVerifiedClubInvitationSession,
+} from "@/src/infrastructure/supabase/club-invitation-session";
+
+// 前回stateや入力値を反射せず、再開のための固定メッセージだけを返す。
+function failure(
+  requestId: unknown,
+  message: string,
+): WelcomeActionState {
+  return {
+    status: "error",
+    values: {},
+    fieldErrors: {},
+    formError: message,
+    requestId: isRequestId(requestId) ? requestId : createRequestId(),
+  };
+}
+
+// この入口を直接選んでも、初回設定を省略できるのはpassword認証済み本人だけにする。
+export async function acceptExistingClubInvitationAction(
+  previousState: WelcomeActionState,
+  formData: FormData,
+): Promise<WelcomeActionState> {
+  const previousRequestId = previousState?.requestId;
+
+  if (!(formData instanceof FormData)) {
+    return failure(previousRequestId, "フォームを開き直してください。");
+  }
+
+  const requestId = formData.get("requestId");
+  const contextId = formData.get("contextId");
+
+  if (
+    formData.getAll("requestId").length !== 1 ||
+    !isRequestId(previousRequestId) ||
+    !isRequestId(requestId) ||
+    requestId !== previousRequestId ||
+    formData.getAll("contextId").length !== 1 ||
+    !isRequestId(contextId)
+  ) {
+    return failure(previousRequestId, "フォームを開き直してください。");
+  }
+
+  try {
+    const cookieStore = await cookies();
+    const context = parseClubInvitationContext(
+      cookieStore.get(CLUB_INVITATION_CONTEXT_COOKIE_NAME)?.value,
+    );
+
+    if (!context || context.contextId !== contextId) {
+      return failure(requestId, "招待メールのリンクから開き直してください。");
+    }
+
+    const session = await getVerifiedClubInvitationSession();
+
+    if (!session || session.authenticationMethod !== "password") {
+      return failure(
+        requestId,
+        "既存のアカウントでパスワードログインしてから招待を再開してください。",
+      );
+    }
+  } catch (error) {
+    unstable_rethrow(error);
+    return failure(requestId, "ログインを確認できませんでした。ページを開き直してください。");
+  }
+
+  // パスワードは受け取らない。認証方法が途中で変わっても初回更新へ流用させない。
+  const acceptanceForm = new FormData();
+  acceptanceForm.set("requestId", requestId);
+  acceptanceForm.set("contextId", contextId);
+
+  // 共通の承諾入口がCookie・nonce・現在の本人を再検査する。制御例外はそのまま伝播する。
+  return completeClubInvitationAction(previousState, acceptanceForm);
+}
diff --git a/app/(club-app)/welcome/actions.ts b/app/(club-app)/welcome/actions.ts
