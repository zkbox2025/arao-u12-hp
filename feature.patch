+// src/application/club/invitation/recover-club-invitation.ts
+
+import "server-only";
+
+import { normalizeEmail } from "@/domain/shared/email";
+import {
+  completeClubInvitationPreparation,
+  findClubInvitationsForOwner,
+  releaseClubInvitationClaim,
+  type ClubInvitationFailure,
+  type ClubInvitationProcessing,
+} from "@/src/infrastructure/prisma/repositories/club-invitation-repository";
+import {
+  getClubInvitationAuthUserById,
+} from "@/src/infrastructure/supabase/club-invitation-auth";
+
+export type RecoverClubInvitationPreparationResult =
+  | ClubInvitationFailure
+  | {
+      outcome: "RECOVERED";
+      invitationId: string;
+    }
+  | {
+      outcome: "MANUAL_RECOVERY_REQUIRED";
+    }
+  | {
+      outcome: "RECOVERY_FAILED";
+    };
+
+// 入力はサーバー内部でRepositoryから得たclaim付き招待に限定する。
+// lease切れ時のclaim再取得は既存claimClubInvitationResendを呼び出し元で使用する。
+// ブラウザからAuth IDやclaimを受け取る入口には接続しない。
+export async function recoverClubInvitationPreparation(
+  input: {
+    clubId: string;
+    actorMembershipId: string;
+    invitation: ClubInvitationProcessing;
+  },
+): Promise<RecoverClubInvitationPreparationResult> {
+  const owner = {
+    clubId: input.clubId,
+    actorMembershipId: input.actorMembershipId,
+  };
+  const invitation = input.invitation;
+  const claim = {
+    ...owner,
+    invitationId: invitation.id,
+    claimToken: invitation.claimToken,
+  };
+  let ownsPreparation = false;
+
+  try {
+    // Auth管理APIより前に現在のOWNER資格と招待状態を確認する。
+    const result = await findClubInvitationsForOwner(owner);
+
+    if (result.outcome !== "FOUND") {
+      return result;
+    }
+
+    const stored = result.invitations.find((row) => row.id === invitation.id);
+    const now = Date.now();
+
+    if (
+      !stored ||
+      invitation.clubId !== owner.clubId ||
+      invitation.status !== "PREPARING" ||
+      stored.status !== "PREPARING" ||
+      normalizeEmail(stored.email) !== normalizeEmail(invitation.email) ||
+      !invitation.claimToken ||
+      !(invitation.leaseExpiresAt.getTime() > now) ||
+      !(invitation.expiresAt.getTime() > now) ||
+      stored.leaseExpiresAt?.getTime() !== invitation.leaseExpiresAt.getTime() ||
+      stored.expiresAt.getTime() !== invitation.expiresAt.getTime() ||
+      (
+        stored.membershipStatus !== null &&
+        stored.membershipStatus !== "INVITED"
+      )
+    ) {
+      return {
+        outcome: "CLAIM_LOST",
+      };
+    }
+
+    ownsPreparation = true;
+
+    if (!invitation.authUserId) {
+      // Auth ID未記録は粒度9の運営者手順へ委ね、新規Authで穴埋めしない。
+      return {
+        outcome: "MANUAL_RECOVERY_REQUIRED",
+      };
+    }
+
+    if (
+      invitation.existingUserId &&
+      invitation.existingUserId !== invitation.authUserId
+    ) {
+      return {
+        outcome: "RULE_VIOLATION",
+        reason: "AUTH_USER_MISMATCH",
+      };
+    }
+
+    const user = await getClubInvitationAuthUserById({
+      authUserId: invitation.authUserId,
+      email: stored.email,
+    });
+
+    if (!user) {
+      return {
+        outcome: "MANUAL_RECOVERY_REQUIRED",
+      };
+    }
+
+    if (
+      user.id !== invitation.authUserId ||
+      normalizeEmail(user.email) !== normalizeEmail(stored.email)
+    ) {
+      return {
+        outcome: "RULE_VIOLATION",
+        reason: "AUTH_USER_MISMATCH",
+      };
+    }
+
+    // transaction内で記録済みID・email・clubId・状態・claimを再照合する。
+    const prepared = await completeClubInvitationPreparation({
+      ...claim,
+      verifiedAuthUser: user,
+    });
+
+    if (prepared.outcome !== "PREPARED") {
+      return prepared;
+    }
+
+    return {
+      outcome: "RECOVERED",
+      invitationId: invitation.id,
+    };
+  } catch {
+    return {
+      outcome: "RECOVERY_FAILED",
+    };
+  } finally {
+    if (ownsPreparation) {
+      try {
+        // 配送は行わないためclaimを解除する。失敗時はlease期限後に再試行する。
+        await releaseClubInvitationClaim(claim);
+      } catch {
+        // 保存済みAuth IDと復旧地点を保持し、解除障害の原文を残さない。
+      }
+    }
+  }
+}
