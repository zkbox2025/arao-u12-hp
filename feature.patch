new file mode 100644
index 0000000..3f47d45
--- /dev/null
+++ b/src/infrastructure/prisma/repositories/club-account-repository.ts
@@ -0,0 +1,378 @@
+// src/infrastructure/prisma/repositories/club-account-repository.ts
+// 認可済みの本人・現在クラブに限定して、マイページと既存Child追加候補を読み取る。
+
+import "server-only";
+
+import type {
+  Prisma,
+} from "@prisma/client";
+
+import type {
+  ClubAccountChildCandidatesResult,
+  ClubAccountChildView,
+  ClubAccountReadResult,
+  ClubAccountView,
+} from "@/domain/club/account/account-types";
+import {
+  evaluateChildMembershipAddition,
+} from "@/domain/club/account/child-membership-policy";
+import {
+  hasClubFeature,
+} from "@/domain/club/plan-features";
+import {
+  prisma,
+} from "@/src/infrastructure/prisma/client";
+
+// 呼出元は認証・認可結果から渡す。クライアントの自己申告を渡してはいけない。
+export type ClubAccountReadScope = {
+  clubId: string;
+  actorMembershipId: string;
+  userId: string;
+};
+
+// Auth emailとクラブ切替判定は、既存の取得処理を使う後続Serviceで補う。
+export type ClubAccountForUserResult =
+  | {
+      outcome: "FOUND";
+      view: Omit<ClubAccountView, "authEmail" | "canSwitchClub">;
+    }
+  | Exclude<ClubAccountReadResult, {
+      outcome: "FOUND";
+    }>;
+
+// 未指定のwhere条件がPrismaで省略され、対象が広がることを防ぐ。
+function hasReadScope(input: ClubAccountReadScope): boolean {
+  return input !== null &&
+    typeof input === "object" &&
+    typeof input.clubId === "string" &&
+    input.clubId.trim().length > 0 &&
+    typeof input.actorMembershipId === "string" &&
+    input.actorMembershipId.trim().length > 0 &&
+    typeof input.userId === "string" &&
+    input.userId.trim().length > 0;
+}
+
+// 現在の親MembershipとAppUserの対応を読み、認可後の状態変化も確認する。
+async function findAccountMembership(input: ClubAccountReadScope) {
+  const membership = await prisma.clubMembership.findFirst({
+    where: {
+      id: input.actorMembershipId,
+      clubId: input.clubId,
+      userId: input.userId,
+      status: "ACTIVE",
+    },
+    select: {
+      id: true,
+      clubId: true,
+      userId: true,
+      status: true,
+      role: true,
+      club: {
+        select: {
+          id: true,
+          name: true,
+          slug: true,
+          planType: true,
+          websiteUrl: true,
+          instagramUrl: true,
+        },
+      },
+      user: {
+        select: {
+          id: true,
+          name: true,
+          email: true,
+        },
+      },
+    },
+  });
+
+  if (!membership) {
+    return null;
+  }
+  if (
+    !membership.user ||
+    !membership.club
+  ) {
+    throw new Error("アカウントの対応を確認できません。");
+  }
+  if (
+    membership.id !== input.actorMembershipId ||
+    membership.clubId !== input.clubId ||
+    membership.userId !== input.userId ||
+    membership.status !== "ACTIVE" ||
+    membership.user.id !== input.userId ||
+    membership.club.id !== input.clubId ||
+    !hasClubFeature(membership.club.planType, "CLUB_APP")
+  ) {
+    return null;
+  }
+
+  return membership;
+}
+
+// 候補の認可確認では、氏名・email・外部URLを取得しない。
+async function findCandidateMembership(input: ClubAccountReadScope) {
+  const membership = await prisma.clubMembership.findFirst({
+    where: {
+      id: input.actorMembershipId,
+      clubId: input.clubId,
+      userId: input.userId,
+      status: "ACTIVE",
+    },
+    select: {
+      id: true,
+      clubId: true,
+      userId: true,
+      status: true,
+      user: {
+        select: {
+          id: true,
+        },
+      },
+      club: {
+        select: {
+          id: true,
+          planType: true,
+        },
+      },
+    },
+  });
+
+  if (!membership) {
+    return null;
+  }
+  if (
+    !membership.user ||
+    !membership.club
+  ) {
+    throw new Error("アカウントの対応を確認できません。");
+  }
+  if (
+    membership.id !== input.actorMembershipId ||
+    membership.clubId !== input.clubId ||
+    membership.userId !== input.userId ||
+    membership.status !== "ACTIVE" ||
+    membership.user.id !== input.userId ||
+    membership.club.id !== input.clubId ||
+    !hasClubFeature(membership.club.planType, "CLUB_APP")
+  ) {
+    return null;
+  }
+
+  return membership;
+}
+
+// 未所属候補でも、親自身の現在クラブMembershipがACTIVEであることを条件に入れる。
+function childScope(input: ClubAccountReadScope): Prisma.ChildWhereInput {
+  return {
+    parentId: input.userId,
+    parent: {
+      is: {
+        id: input.userId,
+        memberships: {
+          some: {
+            id: input.actorMembershipId,
+            clubId: input.clubId,
+            userId: input.userId,
+            status: "ACTIVE",
+          },
+        },
+      },
+    },
+  };
+}
+
+// 照合用の親・所属情報は内部だけで使い、他クラブの所属情報は取得しない。
+function childSelection(input: ClubAccountReadScope) {
+  return {
+    id: true,
+    parentId: true,
+    name: true,
+    grade: true,
+    clubMemberships: {
+      where: {
+        clubId: input.clubId,
+      },
+      select: {
+        childId: true,
+        clubId: true,
+        parentUserId: true,
+        status: true,
+      },
+    },
+  } as const satisfies Prisma.ChildSelect;
+}
+
+type AccountChildRow = Prisma.ChildGetPayload<{
+  select: ReturnType<typeof childSelection>;
+}>;
+
+// DBの対応を照合し、明示的にid・name・gradeだけのDTOへ投影する。
+function childView(
+  child: AccountChildRow,
+  input: ClubAccountReadScope,
+  purpose: "CURRENT" | "CANDIDATE",
+): ClubAccountChildView {
+  if (
+    child.parentId !== input.userId ||
+    child.clubMemberships.length > 1 ||
+    child.clubMemberships.some((membership) =>
+      membership.childId !== child.id ||
+      membership.clubId !== input.clubId ||
+      membership.parentUserId !== input.userId)
+  ) {
+    throw new Error("子どもの所属の対応を確認できません。");
+  }
+
+  const [membership] = child.clubMemberships;
+  if (purpose === "CURRENT") {
+    if (
+      !membership ||
+      membership.status !== "ACTIVE"
+    ) {
+      throw new Error("現在の所属を確認できません。");
+    }
+  } else {
+    const evaluation = evaluateChildMembershipAddition({
+      status: membership ? membership.status : null,
+    });
+    if (!evaluation.allowed) {
+      throw new Error("追加候補の所属を確認できません。");
+    }
+  }
+
+  return {
+    id: child.id,
+    name: child.name,
+    grade: child.grade,
+  };
+}
+
+// 現在クラブのACTIVEな本人所属Childだけを返す。読取時に修復・更新は行わない。
+export async function findClubAccountForUser(
+  input: ClubAccountReadScope,
+): Promise<ClubAccountForUserResult> {
+  if (!hasReadScope(input)) {
+    return {
+      outcome: "UNAVAILABLE",
+    };
+  }
+
+  try {
+    const membership = await findAccountMembership(input);
+    if (!membership) {
+      return {
+        outcome: "UNAVAILABLE",
+      };
+    }
+
+    const [children, platformAdmin] = await Promise.all([
+      prisma.child.findMany({
+        where: {
+          ...childScope(input),
+          clubMemberships: {
+            some: {
+              clubId: input.clubId,
+              parentUserId: input.userId,
+              status: "ACTIVE",
+            },
+          },
+        },
+        select: childSelection(input),
+        orderBy: {
+          id: "asc",
+        },
+      }),
+      prisma.platformAdmin.findFirst({
+        where: {
+          id: input.userId,
+          isActive: true,
+        },
+        select: {
+          id: true,
+        },
+      }),
+    ]);
+
+    return {
+      outcome: "FOUND",
+      view: {
+        name: membership.user.name,
+        appUserEmail: membership.user.email,
+        club: {
+          name: membership.club.name,
+          slug: membership.club.slug,
+          websiteUrl: membership.club.websiteUrl,
+          instagramUrl: membership.club.instagramUrl,
+        },
+        role: membership.role,
+        children: children.map((child) => childView(child, input, "CURRENT")),
+        isPlatformAdmin: platformAdmin?.id === input.userId,
+      },
+    };
+  } catch {
+    // Prisma原文・個人情報・任意のDomainErrorを結果やログへ渡さない。
+    return {
+      outcome: "FETCH_FAILED",
+    };
+  }
+}
+
+// 追加操作用に、自分の未所属・WITHDRAWNのChildだけを別取得する。
+export async function findAttachableChildrenForUser(
+  input: ClubAccountReadScope,
+): Promise<ClubAccountChildCandidatesResult> {
+  if (!hasReadScope(input)) {
+    return {
+      outcome: "UNAVAILABLE",
+    };
+  }
+
+  try {
+    const membership = await findCandidateMembership(input);
+    if (!membership) {
+      return {
+        outcome: "UNAVAILABLE",
+      };
+    }
+
+    const children = await prisma.child.findMany({
+      where: {
+        ...childScope(input),
+        OR: [
+          {
+            clubMemberships: {
+              none: {
+                clubId: input.clubId,
+              },
+            },
+          },
+          {
+            clubMemberships: {
+              some: {
+                clubId: input.clubId,
+                parentUserId: input.userId,
+                status: "WITHDRAWN",
+              },
+            },
+          },
+        ],
+      },
+      select: childSelection(input),
+      orderBy: {
+        id: "asc",
+      },
+    });
+
+    return {
+      outcome: "FOUND",
+      children: children.map((child) => childView(child, input, "CANDIDATE")),
+    };
+  } catch {
+    // 所属不整合をupsert等で修復せず、取得失敗として扱う。
+    return {
+      outcome: "FETCH_FAILED",
+    };
+  }
+}
