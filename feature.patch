@@ -0,0 +1,189 @@
+// domain/club/account/child-form.ts
+// 子どもの氏名・任意の学年・対象IDを検証し、所有者やクラブの自己申告は引き継がない。
+
+import type {
+  ActionState,
+  FieldErrors,
+} from "@/domain/shared/action-state";
+import {
+  isRequestId,
+} from "@/domain/shared/request-id";
+import type {
+  Grade,
+} from "@/types/prisma";
+
+import {
+  validateAccountNameInput,
+} from "./account-form";
+
+// 未設定の選択肢はvalue=""で扱う。ここにはDBと同じ7種類だけを列挙する。
+export const CHILD_GRADE_OPTIONS = [
+  {
+    value: "YOUJI",
+    label: "幼児",
+  },
+  {
+    value: "ELEMENTARY_1",
+    label: "小学1年",
+  },
+  {
+    value: "ELEMENTARY_2",
+    label: "小学2年",
+  },
+  {
+    value: "ELEMENTARY_3",
+    label: "小学3年",
+  },
+  {
+    value: "ELEMENTARY_4",
+    label: "小学4年",
+  },
+  {
+    value: "ELEMENTARY_5",
+    label: "小学5年",
+  },
+  {
+    value: "ELEMENTARY_6",
+    label: "小学6年",
+  },
+] as const satisfies ReadonlyArray<{
+  value: Grade;
+  label: string;
+}>;
+
+export type ChildFormValues = {
+  name: string;
+  grade: string;
+};
+
+export type ChildFormField = keyof ChildFormValues;
+
+export type ChildActionState = ActionState<
+  ChildFormValues,
+  ChildFormField
+>;
+
+export type ChildValidationResult =
+  | {
+      success: true;
+      data: {
+        name: string;
+        grade: Grade | null;
+      };
+    }
+  | {
+      success: false;
+      fieldErrors: FieldErrors<ChildFormField>;
+    };
+
+export type ChildMembershipFormValues = {
+  childId: string;
+};
+
+export type ChildMembershipActionState = ActionState<
+  ChildMembershipFormValues,
+  "childId"
+>;
+
+export type ChildIdValidationResult =
+  | {
+      success: true;
+      data: ChildMembershipFormValues;
+    }
+  | {
+      success: false;
+      fieldErrors: FieldErrors<"childId">;
+    };
+
+// Gradeをtrimや大文字化で補正せず、選択肢と完全一致する値だけを許可する。
+function isGrade(value: unknown): value is Grade {
+  return CHILD_GRADE_OPTIONS.some((option) => option.value === value);
+}
+
+// 氏名と学年だけを返す。学年の空選択・明示nullと、欠損・不正値は区別する。
+export function validateChildInput(
+  input: unknown,
+): ChildValidationResult {
+  const nameResult = validateAccountNameInput(input);
+  const rawGrade = typeof input === "object" &&
+    input !== null &&
+    !Array.isArray(input) &&
+    "grade" in input
+    ? input.grade
+    : undefined;
+  const grade = rawGrade === "" ||
+    rawGrade === null
+    ? null
+    : isGrade(rawGrade)
+      ? rawGrade
+      : undefined;
+  const fieldErrors: FieldErrors<ChildFormField> = {};
+
+  if (!nameResult.success) {
+    fieldErrors.name = nameResult.fieldErrors.name;
+  }
+  if (grade === undefined) {
+    fieldErrors.grade = ["学年は未設定、または選択肢から選んでください。"];
+  }
+
+  if (
+    !nameResult.success ||
+    grade === undefined
+  ) {
+    return {
+      success: false,
+      fieldErrors,
+    };
+  }
+
+  return {
+    success: true,
+    data: {
+      name: nameResult.data.name,
+      grade,
+    },
+  };
+}
+
+// optionalな学年でもfieldを一つ要求し、Fileや重複を空選択へ変換しない。
+export function parseChildFormData(
+  formData: FormData,
+): ChildValidationResult {
+  const names = formData instanceof FormData ? formData.getAll("name") : [];
+  const grades = formData instanceof FormData ? formData.getAll("grade") : [];
+
+  return validateChildInput({
+    name: names.length === 1 ? names[0] : undefined,
+    grade: grades.length === 1 ? grades[0] : undefined,
+  });
+}
+
+// UUID v4の形式だけを確認する。本人所有・現在クラブ所属の照合は後続の責務。
+export function validateChildIdInput(
+  childId: unknown,
+): ChildIdValidationResult {
+  if (!isRequestId(childId)) {
+    return {
+      success: false,
+      fieldErrors: {
+        childId: ["対象の子どもを選び直してください。"],
+      },
+    };
+  }
+
+  return {
+    success: true,
+    data: {
+      childId,
+    },
+  };
+}
+
+// 所属操作の対象IDも単一の文字列だけを受け付ける。
+export function parseChildIdFormData(
+  formData: FormData,
+): ChildIdValidationResult {
+  const ids = formData instanceof FormData ? formData.getAll("childId") : [];
+
+  return validateChildIdInput(ids.length === 1 ? ids[0] : undefined);
+}
