+// app/(club-app)/platform/support/page.tsx
+// Page自身で再認可し、検証済み条件で50件ずつ読み取るPlatformサポート管理画面。
+
+import Link from "next/link";
+import { notFound, unstable_rethrow } from "next/navigation";
+
+import {
+  requirePlatformAdmin, // Auth本人と有効なPlatform管理者を照合して認可contextを返す関数
+} from "@/app/(club-app)/platform/require-platform-admin";
+import {
+  parseSupportReportQuery, // 一覧queryを検証し、検索条件を整形する関数
+  PLATFORM_SUPPORT_MAX_PAGE, // 一覧queryで許可する最大ページ番号
+  type PlatformSupportQuery, // 検証済みの一覧検索条件の型
+} from "@/domain/platform/support/support-report-query";
+import type {
+  PlatformSupportListResult, // 一覧取得の成功値と固定失敗分類の型
+} from "@/domain/platform/support/support-report-management-types";
+import {
+  getPlatformSupport, // 認可contextと生queryから限定一覧DTOまたは固定失敗分類を返すService関数
+} from "@/src/application/platform/support/get-platform-support";
+import {
+  SupportReportFilters, // 検証済み条件とクラブ候補から単一GETフォームを表示するComponent
+} from "./SupportReportFilters";
+import {
+  SupportReportTable, // snapshot・全文・管理情報を安全なテキストで表示する読取専用Component
+} from "./SupportReportTable";
+
+/**
+ * 権限と一覧データを要求ごとに確認し、管理情報を静的な共有結果へ保存しない設定。
+ */
+export const dynamic = "force-dynamic";
+
+/**
+ * Next.jsの非同期searchParamsを受け取る管理一覧Pageのprops型。
+ */
+type Props = { // 一覧Pageのprops型
+  searchParams: Promise<Record<string, string | string[] | undefined>>; // 生queryの辞書を返す非同期型
+};
+
+/**
+ * 検証済みフィルターだけを引き継ぎ、固定の管理パスへページ送りURLを作る。
+ */
+function pageHref(query: PlatformSupportQuery, page: number): string { // ページ送りURL生成関数 / 検証済み条件型 / ページ番号型 / 文字列型
+  const params = new URLSearchParams(); // 検索値をエンコードするURLSearchParamsコンストラクター
+  for (const key of ["clubId", "status", "category"] as const) { // 引継ぎ対象キーの読取専用リテラル型
+    if (query[key] !== null) {
+      params.set(key, query[key]); // 検証済みフィルターを設定するメソッド
+    }
+  }
+  params.set("page", String(page)); // ページ文字列の設定メソッド / 数値の文字列化関数
+  return `/platform/support?${params.toString()}`; // URL queryへエンコードするメソッド
+}
+
+/**
+ * 検索条件の不正を固定文面で示し、任意入力を表示・再利用せずリセット先を提供する。
+ */
+function InvalidQuery() { // 不正query表示のComponent関数
+  return (
+    <section className="space-y-4">
+      <h1 className="text-2xl font-bold">サポート報告</h1>
+      <p role="alert">検索条件が不正です。条件をリセットして検索し直してください。</p>
+      {/* 生queryを引き継がない固定パスへのNext Link Component */}
+      <Link
+        href="/platform/support"
+        className="underline"
+      >条件をリセット</Link>
+    </section>
+  );
+}
+
+/**
+ * Page単独でも再認可し、query検証後だけ読取Serviceを呼ぶ。更新UIは後続粒度で接続する。
+ */
+export default async function PlatformSupportPage({ searchParams }: Props) { // 管理一覧PageのComponent関数 / props型
+  let query: PlatformSupportQuery | null = null; // 検証後だけ保持する一覧条件の型
+  let result: PlatformSupportListResult | null = null; // 認可後だけ保持する一覧結果の型
+  try {
+    const access = await requirePlatformAdmin(); // layoutに依存せず本人と最新Platform権限を確認する関数
+    const validation = parseSupportReportQuery(await searchParams); // 非同期queryを検証して整形する関数
+    if (validation.success) {
+      query = validation.data;
+      result = await getPlatformSupport(access, { // 認可contextと許可した生queryだけを渡すService関数
+        clubId: query.clubId ?? "",
+        status: query.status ?? "",
+        category: query.category ?? "",
+        page: String(query.page), // ページ番号を生query形式へ戻す文字列化関数
+      });
+    }
+  } catch (error) {
+    unstable_rethrow(error); // 認可と取得のNext制御例外を再送出する関数
+    return (
+      <section className="space-y-4">
+        <h1 className="text-2xl font-bold">サポート報告</h1>
+        <p role="alert">管理情報を取得できませんでした。時間をおいて再度お試しください。</p>
+      </section>
+    );
+  }
+  if (result?.outcome === "FORBIDDEN") {
+    notFound(); // 読取時に権限が失効していた場合に404で処理を中断する関数
+  }
+  if (query === null || result?.outcome === "INVALID_QUERY") {
+    return <InvalidQuery />; // 不正な検索条件の固定表示Component
+  }
+  if (result?.outcome !== "FOUND") {
+    return (
+      <section className="space-y-4">
+        <h1 className="text-2xl font-bold">サポート報告</h1>
+        <p role="alert">報告を取得できませんでした。時間をおいて再読み込みしてください。</p>
+      </section>
+    );
+  }
+  const totalPages = Math.max(1, Math.ceil(result.totalCount / query.pageSize)); // 総ページ数の切上げ・下限設定メソッド
+  const previousPage = Math.min(query.page - 1, totalPages); // 存在する前ページ番号を選ぶメソッド
+  const hasNext =
+    query.page < totalPages &&
+    query.page < PLATFORM_SUPPORT_MAX_PAGE;
+  const previousHref = query.page > 1 ? pageHref(query, previousPage) : null; // 前ページURLの生成関数
+  const nextHref = hasNext ? pageHref(query, query.page + 1) : null; // 次ページURLの生成関数
+  return (
+    <section className="space-y-5">
+      <h1 className="text-2xl font-bold">サポート報告</h1>
+      <p className="text-sm text-slate-600">全クラブの報告を新しい順に50件ずつ表示します。</p>
+      {/* 検証済み条件と限定クラブ候補だけを渡す検索Component */}
+      <SupportReportFilters
+        query={query}
+        clubs={result.clubs}
+      />
+      <p>全{result.totalCount}件・{query.page}ページ目（全{totalPages}ページ）</p>
+      {result.reports.length === 0 ? (
+        <p role="status">このページに表示する報告はありません。</p>
+      ) : (
+        // 読取専用の報告一覧Component
+        <SupportReportTable reports={result.reports} />
+      )}
+      <nav
+        aria-label="サポート報告のページ送り"
+        className="flex flex-wrap gap-4"
+      >
+        {previousHref !== null && (
+          // 検証済み条件を維持する前ページへのNext Link Component
+          <Link
+            href={previousHref}
+            rel="prev"
+            className="underline"
+          >前のページ</Link>
+        )}
+        {nextHref !== null && (
+          // 検証済み条件を維持する次ページへのNext Link Component
+          <Link
+            href={nextHref}
+            rel="next"
+            className="underline"
+          >次のページ</Link>
+        )}
+      </nav>
+    </section>
+  );
+}
