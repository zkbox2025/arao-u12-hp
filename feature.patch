@@ -0,0 +1,134 @@
+// src/application/platform/support/get-platform-support.ts
+// 認可contextと検索条件を分離し、Platform一覧の限定DTOまたは固定失敗分類を返す。
+
+import "server-only";
+
+import type {
+  PlatformAdminAccessContext, // Auth本人IDと有効なPlatform管理者情報をまとめた認可context型
+} from "@/app/(club-app)/platform/require-platform-admin";
+import {
+  parseSupportReportQuery, // 一覧queryを検証し、検索条件を整形する関数
+} from "@/domain/platform/support/support-report-query";
+import type {
+  PlatformSupportClub, // 一覧と絞り込み候補に使うクラブ情報の型
+  PlatformSupportListResult, // 一覧取得の成功値と固定失敗分類の型
+  PlatformSupportReport, // 全文・snapshot・管理情報を含む報告表示用の型
+} from "@/domain/platform/support/support-report-management-types";
+import {
+  sanitizeLogContext, // ログへ出してよい安全な項目だけを返す関数
+} from "@/src/infrastructure/logging/sanitize-log-context";
+import {
+  findSupportReportsForPlatform, // 本人と最新権限を照合し、一覧・件数・クラブ候補を取得する関数
+} from "@/src/infrastructure/prisma/repositories/platform-support-report-repository";
+
+/**
+ * 例外や本文を渡さず、一覧取得の固定失敗分類だけを記録する。
+ */
+function logReadFailure(): void { // 一覧失敗を安全に記録する関数 / 戻り値なしの型
+  try {
+    console.error( // 固定の失敗情報を出力するメソッド
+      "platform_support_operation_failed",
+      sanitizeLogContext({ // 許可したログ項目だけを返す関数
+        operation: "platformSupport.read",
+        result: "READ_FAILED",
+        errorCode: "INTERNAL",
+      }),
+    );
+  } catch {
+    // ログ障害で一覧読取を再試行したり、原文を外へ出したりしない。
+  }
+}
+
+/**
+ * クラブ情報から表示に必要な3項目だけを新しいオブジェクトへ写す。
+ */
+function clubView(club: PlatformSupportClub): PlatformSupportClub { // クラブDTO変換関数 / クラブ情報型
+  return {
+    id: club.id,
+    name: club.name,
+    slug: club.slug,
+  };
+}
+
+/**
+ * 本文を切り捨てず、型契約で許可した表示列と担当者情報だけを返す。
+ */
+function reportView(report: PlatformSupportReport): PlatformSupportReport { // 報告DTO変換関数 / 報告表示型
+  return {
+    id: report.id,
+    createdAt: report.createdAt,
+    updatedAt: report.updatedAt,
+    club: clubView(report.club), // クラブの限定DTOを作る関数
+    category: report.category,
+    status: report.status,
+    message: report.message,
+    pageUrl: report.pageUrl,
+    userAgent: report.userAgent,
+    reporterName: report.reporterName,
+    reporterEmail: report.reporterEmail,
+    reporterRole: report.reporterRole,
+    handler: report.handler === null ? null : {
+      id: report.handler.id,
+      name: report.handler.name,
+    },
+    statusChangedAt: report.statusChangedAt,
+    resolvedAt: report.resolvedAt,
+    internalNote: report.internalNote,
+    notifiedAt: report.notifiedAt,
+    notificationFailed: report.notificationFailed,
+  };
+}
+
+/**
+ * 認可contextと生queryを受け取り、入力を再検証して全クラブの限定一覧を返す。
+ * Auth検証は呼出し元、最新DB権限の再照合はRepositoryが担う。
+ */
+export async function getPlatformSupport( // Platform一覧を取得するApplication Service関数
+  context: PlatformAdminAccessContext, // サーバーで構築したPlatform認可context型
+  input: unknown, // 未検証の検索条件の型
+): Promise<PlatformSupportListResult> { // 一覧の成功値または固定失敗分類を返す非同期型
+  try {
+    if (
+      !context ||
+      typeof context.userId !== "string" ||
+      context.userId.trim().length === 0 || // 本人ID前後の空白を除くメソッド
+      !context.platformAdmin ||
+      context.platformAdmin.id !== context.userId ||
+      (
+        context.platformAdmin.role !== "DEVELOPER" &&
+        context.platformAdmin.role !== "SUPPORT"
+      )
+    ) {
+      return { outcome: "FORBIDDEN" };
+    }
+    const validation = parseSupportReportQuery(input); // 生queryを共通契約で再検証する関数
+    if (!validation.success) {
+      return { outcome: "INVALID_QUERY" };
+    }
+    const result = await findSupportReportsForPlatform({ // 最新権限を再照合して一覧を取得する関数
+      userId: context.userId,
+      platformAdminId: context.platformAdmin.id,
+      query: validation.data,
+    });
+    switch (result.outcome) {
+      case "FOUND":
+        return {
+          outcome: "FOUND",
+          reports: result.reports.map(reportView), // 限定DTO変換を適用するメソッド / 報告変換関数参照
+          clubs: result.clubs.map(clubView), // 限定候補を作るメソッド / クラブ変換関数参照
+          totalCount: result.totalCount,
+          page: result.page,
+          pageSize: result.pageSize,
+        };
+      case "FORBIDDEN":
+      case "INVALID_QUERY":
+        return { outcome: result.outcome };
+      default:
+        logReadFailure(); // 失敗の固定分類だけを記録する関数
+        return { outcome: "READ_FAILED" };
+    }
+  } catch {
+    logReadFailure(); // 例外原文を渡さず固定分類を記録する関数
+    return { outcome: "READ_FAILED" };
+  }
+}
