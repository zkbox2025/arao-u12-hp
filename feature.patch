+++ b/src/infrastructure/prisma/repositories/event-month-copy-read-repository.ts
@@ -0,0 +1,249 @@
+// src/infrastructure/prisma/repositories/event-month-copy-read-repository.ts
+// 前月開始の候補と完全一致する既存イベントを、現在の認可条件で上限付き取得する。
+
+import "server-only";
+
+import { TZDate } from "@date-fns/tz";
+import type { Prisma } from "@prisma/client";
+
+import {
+  CLUB_MEMBER_ROLE_LABELS, // Prisma由来の全クラブ所属ロールに対応する表示ラベル
+  isClubAdminRole, // OWNER・COACH・OFFICERかを判定する関数
+} from "@/domain/club/club-member-role";
+import {
+  convertEventMonthCopyDateTimes, // 前月イベントの日時だけを1か月先へ変換する関数
+} from "@/domain/club/event/event-month-copy-date-times";
+import {
+  isEventMonthCopyTargetMonth, // 複製対象月の厳密な構造を検証する関数
+} from "@/domain/club/event/event-month-copy-form";
+import {
+  buildEventMonthCopyKey, // 全コピー列の決定的な比較値を作る関数
+  EVENT_MONTH_COPY_FIELDS, // 変更できないコピー対象の項目名リスト
+  pickEventMonthCopyEvent, // コピー対象の値を検証し、必要な列だけを抽出する関数
+} from "@/domain/club/event/event-month-copy-policy";
+import {
+  EVENT_MONTH_COPY_MAX_COUNT, // 前月予定の複製候補・選択件数の上限100件
+  type EventMonthCopyEvent, // コピーするイベント1件あたりの型
+} from "@/domain/club/event/event-month-copy-types";
+import {
+  hasClubFeature, // プランで指定機能を利用できるか判定する関数
+} from "@/domain/club/plan-features";
+import {
+  prisma, // サーバーDB接続用の共有Prisma Client
+} from "@/src/infrastructure/prisma/client";
+import type {
+  EventMonthCopyFingerprintCandidate, // 元データ・変換結果・既存一致IDをまとめたサーバー用候補型
+  EventMonthCopyFingerprintScope, // クラブ・所属・Auth本人の識別子をまとめた型
+} from "@/src/infrastructure/security/event-month-copy-fingerprint";
+import type {
+  ClubMemberRole, // Prisma由来のクラブ所属ロール型
+} from "@/types/prisma";
+
+/**
+ * 認証済みの呼出し元から受け取るscopeと、厳密な検証対象の複製先年月。
+ * この識別子だけでAuth本人を認証したことにはならない。
+ */
+export type EventMonthCopyPreviewDataInput = EventMonthCopyFingerprintScope & { // 認可scopeと対象月の結合型
+  targetMonth: string; // 複製先YYYY-MMの文字列型
+};
+
+/**
+ * Client表示へ変換する前のサーバー内部材料。初期選択・コピー実行の可否は決めない。
+ */
+export type EventMonthCopyPreviewData = // 上限付き読取の成功・失敗を区別する型
+  | { // 読取成功の材料をまとめる構造型
+      outcome: "READY"; // 0件を含む取得成功の型
+      targetMonth: string; // 複製先YYYY-MMの文字列型
+      sourceMonth: string; // 複製元YYYY-MMの文字列型
+      timezone: string; // 現在のDBから取得したクラブtimezoneの文字列型
+      candidates: readonly EventMonthCopyFingerprintCandidate[]; // 本文を含むサーバー専用候補配列型
+    }
+  | { // 値を公開しない取得失敗の構造型
+      outcome: "FORBIDDEN" | "TOO_MANY" | "PREVIEW_FAILED"; // 認可拒否・超過・安全な取得失敗の型
+    };
+
+const COPY_SELECT = Object.fromEntries( // 共通allowlistからselect辞書を生成するメソッド
+  EVENT_MONTH_COPY_FIELDS.map( // コピー項目名をselect値へ写すメソッド
+    /**
+     * コピー項目1つを、取得を許可するselectの組へ変換する。
+     */
+    (field) => [field, true], // 項目名からselectの組を返すコールバック
+  ),
+) as Record<keyof EventMonthCopyEvent, true>; // コピー列名だけをキーに持つ辞書型への型アサーション
+const SOURCE_SELECT = {
+  ...COPY_SELECT,
+  id: true,
+  updatedAt: true,
+} satisfies Prisma.ClubEventSelect; // コピー列・元ID・更新版だけのPrisma select型
+const ALL_ROLES = Object.keys(CLUB_MEMBER_ROLE_LABELS) as ClubMemberRole[]; // 全ロール名を取得するメソッド / ロール配列型
+
+/**
+ * クラブ現地の月初をUTCへ変換する。年1〜99も1900年代へ読み替えず明示設定する。
+ * 月境界のDSTによる欠落時刻はSDKが解決する。予定本体の変換とは別の検索境界である。
+ */
+function monthStart( // クラブ現地月初のUTC値を作る関数
+  year: number, // 西暦年の数値型
+  month: number, // 1〜12月の数値型
+  timezone: string, // クラブtimezoneの文字列型
+): Date { // 月初UTC日時の型
+  const local = new TZDate(0, timezone); // timezone付き日時のコンストラクター
+  local.setFullYear(year, month - 1, 1); // 年0〜99の読替えなしで年月初日を設定するメソッド
+  local.setHours(0, 0, 0, 0); // 現地月初の時分秒ミリ秒を設定するメソッド
+  return new Date(local.getTime()); // 標準Dateの生成 / UTC値を取得するメソッド
+}
+
+/**
+ * 全コピー列が等しい既存イベントの条件。ロールは順序・重複を無視した集合で比較する。
+ * 余分なロールを持つ行も排除し、公開状態や関連行は条件に含めない。
+ */
+function duplicateWhere( // 既存イベントの完全一致検索条件を組み立てる関数
+  clubId: string, // 認可対象クラブIDの文字列型
+  event: EventMonthCopyEvent, // 変換後のコピー値の型
+): Prisma.ClubEventWhereInput { // Prismaイベント検索条件の型
+  const { targetRoles, ...columns } = pickEventMonthCopyEvent(event); // コピー列だけを検証・抽出する関数
+  const roles = [...new Set(targetRoles)]; // ロールの重複を除く集合の生成
+  if (roles.length === 0) {
+    return {
+      clubId,
+      ...columns,
+      targetRoles: {
+        isEmpty: true,
+      },
+    };
+  }
+  const excludedRoles = ALL_ROLES.filter( // 候補に含まれないロールを取り出すメソッド
+    /**
+     * 候補のロール集合にないロールだけを残す。
+     */
+    (role) => !roles.includes(role), // 集合外か判定するコールバック / 配列の包含判定メソッド
+  );
+  return {
+    clubId,
+    ...columns,
+    targetRoles: {
+      hasEvery: roles,
+    },
+    NOT: {
+      targetRoles: {
+        hasSome: excludedRoles,
+      },
+    },
+  };
+}
+
+/**
+ * 最新のACTIVE所属・本人・クラブ・管理者ロール・利用可能プランを確認して材料を取得する。
+ * Prisma読取は認可1回＋候補1回＋異なる変換値の一致検索最大100回の計102呼出し。
+ * 実SQL数はclubのrelation取得方式に依存するため、DB統合試験で別途確認する。
+ * transaction clientを渡せば、後続の保存処理でも同じ読取を再利用できる。
+ * transactionの開始、Auth検証、ログ出力、初期選択、書込は行わない。
+ */
+export async function findEventMonthCopyPreviewData( // 上限付きpreview読取の公開関数
+  input: EventMonthCopyPreviewDataInput, // 認証済み呼出し元のscopeと対象月の型
+  database: Prisma.TransactionClient = prisma, // 通常Clientまたは呼出し元transaction clientの型
+): Promise<EventMonthCopyPreviewData> { // サーバー用取得結果を返す非同期型
+  try {
+    if (!isEventMonthCopyTargetMonth(input.targetMonth)) { // 対象月を厳密に検証する関数
+      return { outcome: "PREVIEW_FAILED" };
+    }
+    const actor = await database.clubMembership.findFirst({ // 最新の本人所属を取得するメソッド
+      where: {
+        id: input.membershipId,
+        clubId: input.clubId,
+        userId: input.userId,
+        status: "ACTIVE",
+      },
+      select: {
+        role: true,
+        club: {
+          select: {
+            timezone: true,
+            planType: true,
+          },
+        },
+      },
+    });
+    if (
+      !actor ||
+      !isClubAdminRole(actor.role) || // 現在のロールが管理者か判定する関数
+      !hasClubFeature(actor.club.planType, "CLUB_APP") // 現在のプランでアプリを使えるか判定する関数
+    ) {
+      return { outcome: "FORBIDDEN" };
+    }
+    const timezone = actor.club.timezone;
+    new Intl.DateTimeFormat("en-US", { timeZone: timezone }).format(0); // timezoneを検証する書式の生成 / 固定日時の書式化メソッド
+    const year = Number(input.targetMonth.slice(0, 4)); // 年を取り出すメソッド / 数値へ変換する関数
+    const month = Number(input.targetMonth.slice(5, 7)); // 月を取り出すメソッド / 数値へ変換する関数
+    const sourceYear = month === 1 ? year - 1 : year;
+    const sourceMonthNumber = month === 1 ? 12 : month - 1;
+    const sourceMonth =
+      `${String(sourceYear).padStart(4, "0")}-${String(sourceMonthNumber).padStart(2, "0")}`; // 年月の文字列化関数 / 桁を揃えるメソッド
+    // 元DRAFTも取得対象にする確定方針に従い、status条件は設けない。
+    const rows = await database.clubEvent.findMany({ // 前月開始の候補を上限付きで取得するメソッド
+      where: {
+        clubId: input.clubId,
+        startAt: {
+          gte: monthStart(sourceYear, sourceMonthNumber, timezone), // 前月の現地月初をUTCへ変換する関数
+          lt: monthStart(year, month, timezone), // 対象月の現地月初をUTCへ変換する関数
+        },
+      },
+      select: SOURCE_SELECT,
+      orderBy: [
+        { startAt: "asc" },
+        { id: "asc" },
+      ],
+      take: EVENT_MONTH_COPY_MAX_COUNT + 1,
+    });
+    if (rows.length > EVENT_MONTH_COPY_MAX_COUNT) {
+      return { outcome: "TOO_MANY" };
+    }
+    const candidates: EventMonthCopyFingerprintCandidate[] = []; // サーバー用の変換済み候補配列型
+    const duplicateIds = new Map<string, string | null>(); // 比較値と既存一致IDのMap生成 / 文字列または未一致の型
+    for (const row of rows) {
+      const source = {
+        ...pickEventMonthCopyEvent(row), // コピー列だけを検証・抽出する関数
+        id: row.id,
+        updatedAt: new Date(row.updatedAt.getTime()), // 更新版Dateの生成 / UTC値を取得するメソッド
+      };
+      const dateTimes = convertEventMonthCopyDateTimes(source, timezone); // 先行粒度の日時変換関数
+      let duplicateEventId: string | null = null; // 既存一致IDまたは未一致の型
+      if (dateTimes.success) {
+        const converted = {
+          ...source,
+          ...dateTimes.converted,
+        };
+        const key = buildEventMonthCopyKey(converted); // 全コピー列の比較値を作る関数。本文をログへ出さない
+        const cached = duplicateIds.get(key); // 既に照合した変換値の結果を取得するメソッド
+        if (cached !== undefined) {
+          duplicateEventId = cached;
+        } else {
+          const duplicate = await database.clubEvent.findFirst({ // 一致行を最大1件だけ取得するメソッド
+            where: duplicateWhere(input.clubId, converted), // 同クラブの全コピー列一致条件を作る関数
+            select: {
+              id: true,
+            },
+            orderBy: {
+              id: "asc",
+            },
+          });
+          duplicateEventId = duplicate?.id ?? null;
+          duplicateIds.set(key, duplicateEventId); // 同一変換値の検索結果を記録するメソッド
+        }
+      }
+      candidates.push({ // 元データ・変換結果・既存一致IDを追加するメソッド
+        source,
+        dateTimes,
+        duplicateEventId,
+      });
+    }
+    return {
+      outcome: "READY",
+      targetMonth: input.targetMonth,
+      sourceMonth,
+      timezone,
+      candidates,
+    };
+  } catch {
+    return { outcome: "PREVIEW_FAILED" };
+  }
+}
diff --git a/tests/event-month-copy-read-repository.test.ts b/tests/event-month-copy-read-repository.test.ts
