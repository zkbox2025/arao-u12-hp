+  expectedSession: VerifiedClubInvitationSession;
+}): Promise<ClubInvitationPasswordUpdateResult> {
+  const validation = validateWelcomeInput({
+    password: input.password,
+    confirmation: input.password,
+  });
+
+  if (!validation.success) {
+    return {
+      outcome: "REJECTED",
+      reason: "PASSWORD_REJECTED",
+    };
