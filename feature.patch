+// tests/club-invitation-recovery.integration.test.ts
+
+import { randomBytes, randomUUID } from "node:crypto";
+
+import { PrismaClient } from "@prisma/client";
+import { PrismaPg } from "@prisma/adapter-pg";
+import {
+  afterAll,
+  beforeAll,
+  beforeEach,
+  describe,
