+    }
+  | {
+      outcome: "CONFLICT";
+    };
+
+// 【追加：F06粒度3】条件付き更新の不成立時にtransaction全体を中止する。
+class ClubInvitationAcceptanceConflict extends Error {
+  // 入力値やDBの内容を例外へ含めない。
+  constructor() {
+    super("Invitation acceptance conflict");
+  }
+}
