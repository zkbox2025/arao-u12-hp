+// domain/club/support/support-report-metadata.ts
+// サーバーが導出・取得した報告metadataを保存可能な値へ限定する。
+
+export const SUPPORT_REPORT_USER_AGENT_MAX_LENGTH = 512;
+
+const CONTROL_CHARACTER_PATTERN = /[\u0000-\u001f\u007f-\u009f]/u;
+const USER_AGENT_CONTROL_CHARACTERS = /[\u0000-\u001f\u007f-\u009f]/gu;
+const UNSAFE_SLUG_CHARACTER_PATTERN = /[/\\?#%]/u;
+
+// 現在クラブのaccountパスだけを返す。呼出元は認可済みslugから候補パスを構築する。
+export function sanitizeSupportPageUrl(
+  value: unknown,
+  clubSlug: string,
+): string | null {
+  if (
+    typeof value !== "string" ||
+    typeof clubSlug !== "string" ||
+    !clubSlug ||
+    clubSlug !== clubSlug.trim() ||
+    clubSlug === "." ||
+    clubSlug === ".." ||
+    UNSAFE_SLUG_CHARACTER_PATTERN.test(clubSlug) ||
+    CONTROL_CHARACTER_PATTERN.test(clubSlug) ||
+    CONTROL_CHARACTER_PATTERN.test(value)
+  ) {
+    return null;
+  }
+
+  // URI変換不能な不正サロゲートでも報告metadataのために例外を漏らさない。
+  let accountPath: string;
+  try {
+    accountPath = `/club/${encodeURIComponent(clubSlug)}/account`;
+  } catch {
+    return null;
+  }
+
+  // URLパーサーでdot segment等を正規化せず、許可パスとの厳密一致で判定する。
+  const path = value.split(/[?#]/u, 1)[0];
+  return path === accountPath ? accountPath : null;
+}
+
+// UAはサーバー側のheadersから渡す。偽装可能な補助情報として長さと制御文字だけを制限する。
+export function sanitizeSupportUserAgent(value: unknown): string | null {
+  if (typeof value !== "string") {
+    return null;
+  }
+  const sanitized = value
+    .replace(USER_AGENT_CONTROL_CHARACTERS, "")
+    .trim()
+    .slice(0, SUPPORT_REPORT_USER_AGENT_MAX_LENGTH);
+  return sanitized || null;
+}
