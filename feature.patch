+// src/application/club/invitation/accept-club-invitation.ts
+
+import "server-only";
+
+import {
+  validateWelcomeInput,
+  type WelcomeFormField,
+} from "@/domain/club/invitation/acceptance-form";
+import type {
+  ClubInvitationAcceptanceViolation,
+} from "@/domain/club/invitation/acceptance-policy";
+import type { FieldErrors } from "@/domain/shared/action-state";
+import {
+  acceptClubInvitationForUser,
+  findClubInvitationAcceptanceForUser,
+} from "@/src/infrastructure/prisma/repositories/club-invitation-repository";
+import {
+  parseClubInvitationContext,
+} from "@/src/infrastructure/security/club-invitation-context";
+import {
+  getVerifiedClubInvitationSession,
+  updateClubInvitationPassword,
+} from "@/src/infrastructure/supabase/club-invitation-session";
+
+export type AcceptClubInvitationResult =
+  | {
+      outcome: "ACCEPTED";
+      clubSlug: string;
+    }
+  | {
+      outcome: "INVALID_INPUT";
+      fieldErrors: FieldErrors<WelcomeFormField>;
+    }
+  | {
+      outcome: "UNAVAILABLE";
+      reason: ClubInvitationAcceptanceViolation;
+    }
+  | {
+      outcome:
+        | "AUTHENTICATION_REQUIRED"
+        | "PASSWORD_LOGIN_REQUIRED"
+        | "CONFLICT"
+        | "PROCESSING_FAILED";
+    }
+  | {
+      outcome: "PASSWORD_UPDATE_REJECTED";
+      reason: "PASSWORD_REJECTED" | "REAUTHENTICATION_REQUIRED";
+    }
+  | {
+      outcome: "PASSWORD_UPDATE_UNKNOWN";
+      recovery: "PASSWORD_LOGIN";
+    }
+  | {
+      outcome: "PASSWORD_UPDATED_ACCEPTANCE_INCOMPLETE";
+      reason: ClubInvitationAcceptanceViolation | "CONFLICT" | "PROCESSING_FAILED";
+      recovery: "PASSWORD_LOGIN";
+    };
+
+// Auth更新とDB承諾は別処理として扱い、結果不明時に自動で再更新しない。
+export async function acceptClubInvitation(input: {
+  context: unknown;
+  contextId: unknown;
+  password?: unknown;
+  confirmation?: unknown;
+}): Promise<AcceptClubInvitationResult> {
+  const context = parseClubInvitationContext(input.context);
+
+  if (!context || input.contextId !== context.contextId) {
+    return {
+      outcome: "UNAVAILABLE",
+      reason: "INVALID_INVITATION",
+    };
+  }
+
+  let passwordUpdateStarted = false;
+  let passwordUpdated = false;
+
+  try {
+    const session = await getVerifiedClubInvitationSession();
+
+    if (!session) {
+      return {
+        outcome: "AUTHENTICATION_REQUIRED",
+      };
+    }
+
+    if (session.authenticationMethod === "unknown") {
+      return {
+        outcome: "PASSWORD_LOGIN_REQUIRED",
+      };
+    }
+
+    // 経路は検証済みAMRで決める。password認証済みなら入力値を使用しない。
+    const validation = session.authenticationMethod === "otp"
+      ? validateWelcomeInput({
+          password: input.password,
+          confirmation: input.confirmation,
+        })
+      : null;
+
+    if (validation && !validation.success) {
+      return {
+        outcome: "INVALID_INPUT",
+        fieldErrors: validation.fieldErrors,
+      };
+    }
+
+    const invitation = await findClubInvitationAcceptanceForUser({
+      clubSlug: context.clubSlug,
+      tokenHash: context.tokenHash,
+      authenticatedUser: session.user,
+    });
+
+    if (invitation.outcome === "UNAVAILABLE") {
+      return {
+        outcome: "UNAVAILABLE",
+        reason: invitation.view.reason,
+      };
+    }
+
+    if (context.expiresAt <= Date.now()) {
+      return {
+        outcome: "UNAVAILABLE",
+        reason: "INVALID_INVITATION",
+      };
+    }
+
+    let authenticatedUser = session.user;
+
+    if (validation?.success) {
+      passwordUpdateStarted = true;
+      const updated = await updateClubInvitationPassword({
+        password: validation.data.password,
+        expectedSession: session,
+      });
+
+      if (updated.outcome === "UNKNOWN") {
+        return {
+          outcome: "PASSWORD_UPDATE_UNKNOWN",
+          recovery: "PASSWORD_LOGIN",
+        };
+      }
+
+      if (updated.outcome === "REJECTED") {
+        return {
+          outcome: "PASSWORD_UPDATE_REJECTED",
+          reason: updated.reason,
+        };
+      }
+
+      if (updated.outcome === "PASSWORD_LOGIN_REQUIRED") {
+        return {
+          outcome: "PASSWORD_LOGIN_REQUIRED",
+        };
+      }
+
+      if (updated.outcome !== "UPDATED") {
+        return {
+          outcome: "AUTHENTICATION_REQUIRED",
+        };
+      }
+
+      passwordUpdated = true;
+      authenticatedUser = updated.user;
+    }
+
+    if (context.expiresAt <= Date.now()) {
+      return passwordUpdated
+        ? {
+            outcome: "PASSWORD_UPDATED_ACCEPTANCE_INCOMPLETE",
+            reason: "INVALID_INVITATION",
+            recovery: "PASSWORD_LOGIN",
+          }
+        : {
+            outcome: "UNAVAILABLE",
+            reason: "INVALID_INVITATION",
+          };
+    }
+
+    // nowは固定して渡さず、Repositoryが書込時点の期限・状態・本人を再確認する。
+    const accepted = await acceptClubInvitationForUser({
+      clubSlug: context.clubSlug,
+      tokenHash: context.tokenHash,
+      authenticatedUser,
+    });
+
+    if (accepted.outcome === "ACCEPTED") {
+      return {
+        outcome: "ACCEPTED",
+        clubSlug: accepted.clubSlug,
+      };
+    }
+
+    if (passwordUpdated) {
+      return {
+        outcome: "PASSWORD_UPDATED_ACCEPTANCE_INCOMPLETE",
+        reason: accepted.outcome === "UNAVAILABLE" ? accepted.reason : "CONFLICT",
+        recovery: "PASSWORD_LOGIN",
+      };
+    }
+
+    return accepted.outcome === "UNAVAILABLE"
+      ? {
+          outcome: "UNAVAILABLE",
+          reason: accepted.reason,
+        }
+      : {
+          outcome: "CONFLICT",
+        };
+  } catch {
+    // passwordはDBのrollbackで戻せない。DBの成否不明も完了とは扱わない。
+    if (passwordUpdated) {
+      return {
+        outcome: "PASSWORD_UPDATED_ACCEPTANCE_INCOMPLETE",
+        reason: "PROCESSING_FAILED",
+        recovery: "PASSWORD_LOGIN",
+      };
+    }
+
+    if (passwordUpdateStarted) {
+      return {
+        outcome: "PASSWORD_UPDATE_UNKNOWN",
+        recovery: "PASSWORD_LOGIN",
+      };
+    }
+
+    return {
+      outcome: "PROCESSING_FAILED",
+    };
+  }
+}
