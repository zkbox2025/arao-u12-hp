+  return {
+    outcome: "AVAILABLE",
+    authenticationMethod,
+    view: {
+      status: "available",
+      clubName: CLUB_NAME,
+      clubSlug: "invited-club",
+      expiresAt: "2026-10-20T00:00:00Z",
+    },
+  };
+}
+
+let context: NonNullable<ReturnType<typeof createClubInvitationContext>>;
+
