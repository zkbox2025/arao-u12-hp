+// 【追加：F06粒度3】受取人を再照合し、招待と所属を同じtransactionで一回だけ更新する。
+// authenticatedUserはAuthで検証済みの本人、nowはテスト用。Auth更新はこの関数へ入れない。
+export async function acceptClubInvitationForUser(
+  input: {
+    clubSlug: string;
+    tokenHash: string;
+    authenticatedUser: ClubInvitationAcceptanceUser | null;
+    now?: Date;
+  },
+): Promise<ClubInvitationAcceptanceResult> {
+  assertTokenHash(input.tokenHash);
+
+  if (input.now !== undefined) {
+    time(input);
+  }
+
+  if (!input.clubSlug) {
+    return {
+      outcome: "UNAVAILABLE",
+      reason: "INVALID_INVITATION",
+    };
+  }
+
+  const authenticatedUser = input.authenticatedUser;
+
+  if (!authenticatedUser?.id) {
+    return {
+      outcome: "UNAVAILABLE",
+      reason: "RECIPIENT_MISMATCH",
+    };
+  }
+
+  for (
+    let attempt = 0;
+    ;
+    attempt += 1
+  ) {
+    try {
+      return await prisma.$transaction(
+        // 再試行時も最新の招待・所属・時刻を取得し直す。
+        async (tx): Promise<ClubInvitationAcceptanceResult> => {
+          const row = await tx.clubInvitation.findFirst({
+            where: {
+              tokenHash: input.tokenHash,
+              authUserId: authenticatedUser.id,
+              club: {
+                is: {
+                  slug: input.clubSlug,
+                },
+              },
+            },
+            select: {
+              id: true,
+              clubId: true,
+              tokenHash: true,
+              authUserId: true,
+              email: true,
+              membershipId: true,
+              status: true,
+              acceptedAt: true,
+              expiresAt: true,
+              club: {
+                select: {
+                  slug: true,
+                },
+              },
+              membership: {
+                select: {
+                  id: true,
+                  clubId: true,
+                  userId: true,
+                  status: true,
+                  user: {
+                    select: {
+                      email: true,
+                    },
+                  },
+                },
+              },
+            },
+          });
+
+          if (!row) {
+            return {
+              outcome: "UNAVAILABLE",
+              reason: "INVALID_INVITATION",
+            };
+          }
+
+          // Auth更新前やtransaction開始前の時刻を流用せず、書込前に取得する。
+          const now = time(input);
+          const evaluation = evaluateClubInvitationAcceptance({
+            invitation: row,
+            membership: row.membership,
+            authenticatedUser,
+            clubId: row.clubId,
+            tokenHash: input.tokenHash,
+            now,
+          });
+
+          if (!evaluation.allowed) {
+            return {
+              outcome: "UNAVAILABLE",
+              reason: evaluation.violation,
+            };
+          }
+
+          if (
+            !row.membership ||
+            normalizeEmail(row.membership.user.email ?? "") !==
+              normalizeEmail(row.email)
+          ) {
+            return {
+              outcome: "UNAVAILABLE",
+              reason: "MEMBERSHIP_MISMATCH",
+            };
+          }
+
+          const invitation = await tx.clubInvitation.updateMany({
+            where: {
+              id: row.id,
+              clubId: row.clubId,
+              tokenHash: input.tokenHash,
+              authUserId: authenticatedUser.id,
+              email: row.email,
+              membershipId: row.membership.id,
+              status: row.status,
+              acceptedAt: null,
+              expiresAt: {
+                gt: now,
+              },
+              club: {
+                is: {
+                  slug: input.clubSlug,
+                },
+              },
+              membership: {
+                is: {
+                  id: row.membership.id,
+                  clubId: row.clubId,
+                  userId: authenticatedUser.id,
+                  status: "INVITED",
+                  user: {
+                    is: {
+                      email: row.membership.user.email,
+                    },
+                  },
+                },
+              },
+            },
+            data: {
+              status: "ACCEPTED",
+              acceptedAt: now,
+              claimToken: null,
+              leaseExpiresAt: null,
+            },
+          });
+
+          if (invitation.count !== 1) {
+            throw new ClubInvitationAcceptanceConflict();
+          }
+
+          const membership = await tx.clubMembership.updateMany({
+            where: {
+              id: row.membership.id,
+              clubId: row.clubId,
+              userId: authenticatedUser.id,
+              status: "INVITED",
+              user: {
+                is: {
+                  email: row.membership.user.email,
+                },
+              },
+            },
+            data: {
+              status: "ACTIVE",
+            },
+          });
+
+          if (membership.count !== 1) {
+            throw new ClubInvitationAcceptanceConflict();
+          }
+
+          return {
+            outcome: "ACCEPTED",
+            clubSlug: row.club.slug,
+          };
+        },
+        {
+          isolationLevel: Prisma.TransactionIsolationLevel.Serializable,
+        },
+      );
+    } catch (error) {
+      if (error instanceof ClubInvitationAcceptanceConflict) {
+        return {
+          outcome: "CONFLICT",
+        };
+      }
+
+      if (
+        error instanceof Prisma.PrismaClientKnownRequestError &&
+        error.code === "P2034"
+      ) {
+        if (attempt < MAX_TRANSACTION_RETRIES) {
+          continue;
+        }
+
+        return {
+          outcome: "CONFLICT",
+        };
+      }
+
+      const safe = convertPrismaError(error);
+
+      // DB原文・cause・任意のDomainErrorメッセージを公開しない。
+      throw new DomainError(
+        safe.code,
+        "招待を承諾できませんでした。",
+      );
+    }
+  }
+}
