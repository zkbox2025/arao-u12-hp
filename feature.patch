index 0000000..f9c0265
--- /dev/null
+++ b/app/(club-app)/welcome/actions.ts
@@ -0,0 +1,234 @@
+// app/(club-app)/welcome/actions.ts
+"use server";
+
+import "server-only";
+
+import { revalidatePath } from "next/cache";
+import { cookies } from "next/headers";
+import {
+  redirect,
+  unstable_rethrow,
+} from "next/navigation";
+
+import {
+  revalidateClubMemberPaths,
+} from "@/app/(club-app)/club/revalidate-club-paths";
+import {
+  getClubMemberRevalidationPaths,
+} from "@/domain/club/club-revalidation-paths";
+import type {
+  WelcomeActionState,
+  WelcomeFormField,
+} from "@/domain/club/invitation/acceptance-form";
+import type {
+  ClubInvitationAcceptanceViolation,
+} from "@/domain/club/invitation/acceptance-policy";
+import type { FieldErrors } from "@/domain/shared/action-state";
+import {
+  createRequestId,
+  isRequestId,
+} from "@/domain/shared/request-id";
+import {
+  acceptClubInvitation,
+  type AcceptClubInvitationResult,
+} from "@/src/application/club/invitation/accept-club-invitation";
+import {
+  CLUB_INVITATION_CONTEXT_COOKIE_NAME,
+  getClubInvitationContextCookieOptions,
+  parseClubInvitationContext,
+} from "@/src/infrastructure/security/club-invitation-context";
+import {
+  getVerifiedClubInvitationSession,
+} from "@/src/infrastructure/supabase/club-invitation-session";
+
+const EXPIRED_FORM_MESSAGE =
+  "フォームを確認できませんでした。招待メールのリンクから開き直してください。";
+const LOGIN_MESSAGE =
+  "ログインを確認できませんでした。招待メールのリンクから開き直してください。";
+const PASSWORD_LOGIN_MESSAGE =
+  "既存のアカウントでパスワードログインしてから招待を再開してください。";
+const FAILURE_MESSAGE =
+  "処理結果を確認できませんでした。再送信せず、ページを開き直して招待状況を確認してください。";
+
+// 前回stateの値や任意メッセージを引き継がず、公開してよい項目だけを返す。
+function failure(
+  requestId: unknown,
+  message: string,
+  fieldErrors: FieldErrors<WelcomeFormField> = {},
+): WelcomeActionState {
+  return {
+    status: "error",
+    values: {},
+    fieldErrors,
+    formError: message,
+    requestId: isRequestId(requestId) ? requestId : createRequestId(),
+  };
+}
+
+// 本人照合後の利用不可理由を、内部値を含まない固定の案内へ変換する。
+function unavailableMessage(reason: ClubInvitationAcceptanceViolation): string {
+  switch (reason) {
+    case "RECIPIENT_MISMATCH":
+      return "招待されたアカウントでログインし直してください。";
+    case "INVITATION_EMAIL_MISMATCH":
+      return "招待先のメールアドレスと一致しません。運営者へお問い合わせください。";
+    case "INVITATION_ALREADY_ACCEPTED":
+      return "この招待は承諾済みです。クラブ一覧から参加先を確認してください。";
+    case "INVITATION_CANCELLED":
+      return "この招待は取り消されています。運営者へ新しい招待を依頼してください。";
+    case "INVITATION_EXPIRED":
+      return "この招待の有効期限は切れています。運営者へ新しい招待を依頼してください。";
+    case "MEMBERSHIP_MISMATCH":
+    case "INVALID_INVITATION_STATE":
+      return "招待の状態を確認できません。運営者へお問い合わせください。";
+    default:
+      return EXPIRED_FORM_MESSAGE;
+  }
+}
+
+// パスワードや外部エラーを含めず、Serviceの型付き結果を画面のstateへ変換する。
+function presentFailure(
+  result: Exclude<AcceptClubInvitationResult, { outcome: "ACCEPTED" }>,
+  requestId: string,
+): WelcomeActionState {
+  switch (result.outcome) {
+    case "INVALID_INPUT":
+      return failure(requestId, "入力内容を確認してください。", {
+        password: result.fieldErrors.password,
+        confirmation: result.fieldErrors.confirmation,
+      });
+    case "UNAVAILABLE":
+      return failure(requestId, unavailableMessage(result.reason));
+    case "AUTHENTICATION_REQUIRED":
+      return failure(requestId, LOGIN_MESSAGE);
+    case "PASSWORD_LOGIN_REQUIRED":
+      return failure(requestId, PASSWORD_LOGIN_MESSAGE);
+    case "PASSWORD_UPDATE_REJECTED":
+      return failure(
+        requestId,
+        result.reason === "REAUTHENTICATION_REQUIRED"
+          ? "本人確認のやり直しが必要です。招待メールのリンクから開き直してください。"
+          : "パスワードを設定できませんでした。入力内容を確認してください。",
+      );
+    case "PASSWORD_UPDATE_UNKNOWN":
+      return failure(
+        requestId,
+        "パスワードの設定結果を確認できませんでした。再送信せず、" +
+          "入力したパスワードでログインして招待状況を確認してください。",
+      );
+    case "PASSWORD_UPDATED_ACCEPTANCE_INCOMPLETE":
+      return failure(
+        requestId,
+        "パスワードは設定されました。再設定せず、" +
+          "設定したパスワードでログインして招待状況を確認してください。",
+      );
+    case "CONFLICT":
+      return failure(requestId, "招待状況が変更されました。ページを開き直して確認してください。");
+    default:
+      return failure(requestId, FAILURE_MESSAGE);
+  }
+}
+
+// 初回設定でも既存本人でも、実行時のCookie・Auth・Serviceの照合を必ず行う。
+export async function completeClubInvitationAction(
+  previousState: WelcomeActionState,
+  formData: FormData,
+): Promise<WelcomeActionState> {
+  const previousRequestId = previousState?.requestId;
+
+  if (!(formData instanceof FormData)) {
+    return failure(previousRequestId, EXPIRED_FORM_MESSAGE);
+  }
+
+  const requestId = formData.get("requestId");
+  const contextId = formData.get("contextId");
+
+  if (
+    formData.getAll("requestId").length !== 1 ||
+    !isRequestId(previousRequestId) ||
+    !isRequestId(requestId) ||
+    requestId !== previousRequestId ||
+    formData.getAll("contextId").length !== 1 ||
+    !isRequestId(contextId)
+  ) {
+    return failure(previousRequestId, EXPIRED_FORM_MESSAGE);
+  }
+
+  let result: AcceptClubInvitationResult;
+  let cookieStore: Awaited<ReturnType<typeof cookies>>;
+
+  try {
+    cookieStore = await cookies();
+    const rawContext = cookieStore.get(CLUB_INVITATION_CONTEXT_COOKIE_NAME)?.value;
+    const context = parseClubInvitationContext(rawContext);
+
+    if (!context || context.contextId !== contextId) {
+      return failure(requestId, EXPIRED_FORM_MESSAGE);
+    }
+
+    const session = await getVerifiedClubInvitationSession();
+
+    if (!session) {
+      return failure(requestId, LOGIN_MESSAGE);
+    }
+
+    if (session.authenticationMethod === "unknown") {
+      return failure(requestId, PASSWORD_LOGIN_MESSAGE);
+    }
+
+    let password: string | undefined;
+    let confirmation: string | undefined;
+
+    if (session.authenticationMethod === "otp") {
+      const passwordValue = formData.get("password");
+      const confirmationValue = formData.get("confirmation");
+
+      if (
+        formData.getAll("password").length !== 1 ||
+        formData.getAll("confirmation").length !== 1 ||
+        typeof passwordValue !== "string" ||
+        typeof confirmationValue !== "string"
+      ) {
+        return failure(requestId, "パスワードと確認用パスワードを入力してください。");
+      }
+
+      password = passwordValue;
+      confirmation = confirmationValue;
+    }
+
+    // 自己申告のID・role・遷移先は渡さない。Serviceでも本人とDBを再確認する。
+    result = await acceptClubInvitation({
+      context: rawContext,
+      contextId,
+      password,
+      confirmation,
+    });
+  } catch (error) {
+    unstable_rethrow(error);
+    return failure(requestId, FAILURE_MESSAGE);
+  }
+
+  if (result.outcome !== "ACCEPTED") {
+    return presentFailure(result, requestId);
+  }
+
+  try {
+    // DB由来のslugも既存のパス生成関数で検査してからCookie・再検証を操作する。
+    getClubMemberRevalidationPaths(result.clubSlug);
+    cookieStore.set(CLUB_INVITATION_CONTEXT_COOKIE_NAME, "", {
+      ...getClubInvitationContextCookieOptions(),
+      maxAge: 0,
+    });
+    revalidateClubMemberPaths(result.clubSlug);
+    revalidatePath("/club/select");
+  } catch (error) {
+    unstable_rethrow(error);
+    return failure(
+      requestId,
+      "招待は承諾されました。画面を開き直してクラブを選択してください。",
+    );
+  }
+
+  // redirectは制御例外を投げるためcatchの外で行い、遷移先を固定する。
+  redirect(`/club/${encodeURIComponent(result.clubSlug)}/events`);
+}
