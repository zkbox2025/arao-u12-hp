+    expect(mocks.client).not.toHaveBeenCalled(); // Auth参照 / 期待値生成・未呼出し比較メソッド
+    expect(mocks.limit).not.toHaveBeenCalled(); // 制限参照 / 期待値生成・未呼出し比較メソッド
+    expect(mocks.save).not.toHaveBeenCalled(); // 記録参照 / 期待値生成・未呼出し比較メソッド
