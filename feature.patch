+// 【追加：F07粒度5】本人・クラブのIDは認証済みのサーバー側コンテキストから渡す。
+export type ChildMembershipForUserInput = ClubAccountReadScope & {
+  childId: string;
+};
+
+// 本人所有と現在所属の状態を確認し、現在クラブの所属だけを作成・変更する。
+async function changeChildMembershipForUser(
+  input: ChildMembershipForUserInput,
+  operation: "ADD" | "WITHDRAW",
+): Promise<ClubAccountMutationResult> {
+  if (!hasChildScope(input)) {
+    return {
+      outcome: "FORBIDDEN",
+    };
+  }
+  if (!validateChildIdInput(input.childId).success) {
+    return {
+      outcome: "UPDATE_FAILED",
+    };
+  }
+
+  return runChildTransaction(async (transaction) => {
+    const actor = await findChildActor(transaction, input);
+    if (!actor) {
+      return {
+        outcome: "FORBIDDEN",
+      };
+    }
+    const child = await transaction.child.findFirst({
+      where: {
+        id: input.childId,
+        parentId: input.userId,
+      },
+      select: {
+        id: true,
+        parentId: true,
+      },
+    });
+    if (
+      !child ||
+      child.id !== input.childId ||
+      child.parentId !== input.userId
+    ) {
+      return {
+        outcome: "NOT_FOUND",
+      };
+    }
+
+    // 親で絞って未所属と誤認せず、現在クラブの既存行の親も照合する。
+    const membership = await transaction.childClubMembership.findFirst({
+      where: {
+        clubId: input.clubId,
+        childId: input.childId,
+      },
+      select: {
+        id: true,
+        clubId: true,
+        childId: true,
+        parentUserId: true,
+        status: true,
+      },
+    });
+    if (
+      membership && (
+        membership.clubId !== input.clubId ||
+        membership.childId !== input.childId ||
+        membership.parentUserId !== input.userId
+      )
+    ) {
+      return {
+        outcome: "FORBIDDEN",
+      };
+    }
+
+    const state = {
+      status: membership ? membership.status : null,
+    };
+    const evaluation = operation === "ADD"
+      ? evaluateChildMembershipAddition(state)
+      : evaluateChildMembershipWithdrawal(state);
+    if (!evaluation.allowed) {
+      return {
+        outcome: "RULE_VIOLATION",
+        reason: evaluation.reason,
+      };
+    }
+
+    if (evaluation.operation === "CREATE") {
+      // 同時追加の一意衝突は共通transaction処理でCONFLICTへ変換する。
+      await transaction.childClubMembership.create({
+        data: {
+          clubId: input.clubId,
+          childId: input.childId,
+          parentUserId: input.userId,
+          status: "ACTIVE",
+        },
+        select: {
+          id: true,
+        },
+      });
+    } else {
+      if (!membership) {
+        throw new Error("子どもの所属を確認できません。");
+      }
+      const updated = await transaction.childClubMembership.updateMany({
+        where: {
+          id: membership.id,
+          clubId: input.clubId,
+          childId: input.childId,
+          parentUserId: input.userId,
+          status: operation === "ADD" ? "WITHDRAWN" : "ACTIVE",
+          child: {
+            is: {
+              id: input.childId,
+              parentId: input.userId,
+            },
+          },
+          parentMembership: {
+            is: {
+              id: input.actorMembershipId,
+              clubId: input.clubId,
+              userId: input.userId,
+              status: "ACTIVE",
+              club: {
+                is: {
+                  id: input.clubId,
+                  planType: actor.club.planType,
+                },
+              },
+            },
+          },
+        },
+        data: {
+          status: operation === "ADD" ? "ACTIVE" : "WITHDRAWN",
+        },
+      });
+      if (updated.count === 0) {
+        return {
+          outcome: "CONFLICT",
+        };
+      }
+      if (updated.count !== 1) {
+        throw new Error("子どもの所属の更新件数を確認できません。");
+      }
+    }
+
+    return {
+      outcome: "UPDATED",
+      affectedClubSlugs: [actor.club.slug],
+    };
+  });
+}
+
+// 本人の既存Childを現在クラブへ追加し、WITHDRAWNだけを再有効化する。
+export async function addChildToClubForUser(
+  input: ChildMembershipForUserInput,
+): Promise<ClubAccountMutationResult> {
+  return changeChildMembershipForUser(input, "ADD");
+}
+
+// 現在クラブのACTIVE所属だけを解除し、Child本体と他クラブの所属を保持する。
+export async function withdrawChildFromClubForUser(
+  input: ChildMembershipForUserInput,
+): Promise<ClubAccountMutationResult> {
+  return changeChildMembershipForUser(input, "WITHDRAW");
+}
