index 5e1c447564ce9eb79d9f8696d5563e9c3c2d18fd..0ea424071985a189076f6fe0dfd7d5ae56b26c09 100644
--- a/docs/implementation/phases/F10.md
+++ b/docs/implementation/phases/F10.md
@@ -40,3 +40,53 @@ MVP 1.0での推奨仕様
 * 一括作成ではUIのpendingだけでなくサーバー冪等性が必要なこと
 * UTCではなくclub timezoneの日付を先に変換する理由
 * 一般的な定期イベント複製はMVP 1.5へ残すこと
+
+
+【追加：粒度1】仕様・入力・結果の契約
+
+ユーザー確定事項
+* 複製元は、クラブ現地時刻で対象月の前月に開始したイベントだけとする。
+  前々月に開始し、前月にも継続している予定は含めない。
+* 完全一致は、変換後のコピー対象項目で比較する。
+  既存側のDRAFT／PUBLISHEDは問わず、作成者・更新者・公開日時・PDF等は比較しない。
+* 除外前の前月候補が101件以上なら、preview段階で拒否する。
+  日付不正や重複の除外、選択件数の削減によって上限を回避しない。
+
+粒度1で定義する入力境界
+* 対象月は、前月も西暦1年以上となる単一のYYYY-MM文字列とする。
+  0000年、0001年1月、不正な月、配列、余分な空白や改行を拒否し、現在月へfallbackしない。
+* 選択IDはUUIDの配列で1〜100件とし、小文字・昇順へ正規化する。
+  大小文字を揃えた後に同じIDになる場合も重複として拒否する。
+* requestIdは既存のUUID v4検証を利用し、小文字へ正規化する。
+  previewFingerprintは64桁の16進文字列として検証し、小文字へ正規化する。
+* FormDataでは選択IDだけを反復項目として許可する。
+  その他の単一項目の重複、File値、未許可項目は拒否する。
+  Nextが付加する$ACTION_接頭辞の輸送用項目は業務入力として利用しない。
+* 入力はtargetMonth・selectedEventIds・requestId・previewFingerprintに限定する。
+  clientからclubId・実行者・status・コピー日時・本文等を受け取らない。
+* この検証が保証するのは入力構造だけである。
+  認証・認可、前月候補への所属、fingerprintの一致、冪等性は後続粒度で保証する。
+
+コピー列と結果の契約
+* コピー列はtitle・content・genre・targetRoles・startAt・endAt・isAllDay・location・
+  meetingAt・meetingLocation・belongings・notesとする。日時以外の値やnullを黙って変更しない。
+* Client用previewは、ID・見出し・新旧日時・終日区分・補正項目・重複・除外理由・初期選択へ限定する。
+  コピー本文や関連行、Prismaのモデル全体をClientへ返さない。
+* preview結果はREADY（0件も含む）・TOO_MANY・FORBIDDEN・PREVIEW_FAILEDで区別する。
+* 実行結果はCREATED・ALREADY_COMPLETED・VALIDATION_FAILED・FORBIDDEN・PREVIEW_CHANGED・
+  CONFLICT・CREATE_FAILED・RESULT_UNKNOWNで区別する。
+  完了結果は対象月と作成件数だけとし、本文・生Error・DBエラー原文を含めない。
+* 保存後の再検証失敗は、保存済み成功データのneedsReloadで案内できる契約とする。
+  入力のrequestIdだけで保存済みと判断しない。
+
+未確定事項（提案のまま保持し、確定済み仕様として実装しない）
+* 元DRAFTも対象にするか、既存完全一致候補を明示選択で複製できるか。
+* 月末補正で候補同士が一致した場合の初期選択と、利用者による選択可否。
+* 終了・集合が対象月の前後に跨る場合の扱い、DST fold時の時刻選択・表示。
+* 不正source・DST gap・補正後の期間逆転を理由付きで選択不可にする方針。
+* 秒・ミリ秒を保持する方針、初回送信後の選択変更時の再preview・requestId更新の運用。
+
+粒度1の実装範囲
+* 入力・preview・結果の型契約、入力構造検証、境界テストだけを追加する。
+* 日時変換・比較・fingerprint計算・DB・Repository・Service・Action・画面は後続粒度とする。
+  この粒度だけを適用しても、予定は作成されずDB変更も発生しない。
diff --git a/domain/club/event/event-month-copy-form.ts b/domain/club/event/event-month-copy-form.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b4156c3053c186af5fc528e50079f2ddad9b4eef
--- /dev/null
+++ b/domain/club/event/event-month-copy-form.ts
@@ -0,0 +1,217 @@
+// domain/club/event/event-month-copy-form.ts
+// 前月予定複製の構造検証。認可・候補照合・冪等性の保証は後続粒度で行う。
+
+import { z } from "zod";
+
+import type {
+  FieldErrors, // 入力項目ごとのエラーメッセージを保持する型
+} from "@/domain/shared/action-state";
+import {
+  isRequestId, // UUID v4形式のrequestIdを検証する関数
+} from "@/domain/shared/request-id";
+import {
+  EVENT_MONTH_COPY_MAX_COUNT, // 除外前候補数と選択予定数の上限
+  type EventMonthCopyField, // 複製入力の項目名の型
+  type EventMonthCopyInput, // 構造検証・正規化済みの複製入力型
+  type EventMonthCopyValidation, // 成功データと安全な検証エラーを分ける型
+} from "./event-month-copy-types";
+
+const uuidSchema = z.uuid(); // UUID識別子を検証するスキーマの生成関数
+const inputFields = new Set<string>([ // 入力項目名を判定する集合の生成 / 文字列型
+  "targetMonth",
+  "selectedEventIds",
+  "requestId",
+  "previewFingerprint",
+]);
+const INVALID_FORM_MESSAGE = "複製入力を確認してください。";
+const INVALID_SELECTION_MESSAGE = "複製対象を1〜100件、重複なしで指定してください。";
+
+/**
+ * 単一のYYYY-MM文字列で、前月も西暦1年以上になる対象月かを検証する。
+ */
+export function isEventMonthCopyTargetMonth( // 複製対象月の厳密な構造を検証する関数
+  value: unknown, // 検証前の不明値型
+): value is string { // 検証成功時に文字列へ絞り込む型述語
+  return (
+    typeof value === "string" &&
+    value.length === 7 &&
+    /^\d{4}-(0[1-9]|1[0-2])$/.test(value) && // 4桁年と01〜12月の形式を検証するメソッド
+    !value.startsWith("0000-") && // 西暦0年の対象月を拒否するメソッド
+    value !== "0001-01"
+  );
+}
+
+/**
+ * 上限内のUUID配列を検証し、小文字・昇順に正規化する。重複は拒否する。
+ */
+function normalizeSelectedEventIds( // 複製対象IDの検証と正規化を行う関数
+  value: unknown, // 検証前の不明値型
+): string[] | null { // 正規化済みIDの文字列配列または検証失敗の型
+  if (
+    !Array.isArray(value) || // 配列であるかを確認するメソッド
+    value.length === 0 ||
+    value.length > EVENT_MONTH_COPY_MAX_COUNT
+  ) {
+    return null;
+  }
+  const normalized: string[] = []; // 検証後のIDを保持する文字列配列型
+  const seen = new Set<string>(); // ID重複を検出する集合の生成 / 文字列型
+  for (const entry of value as unknown[]) { // 入力要素を不明値の配列型として扱う型アサーション
+    if (
+      typeof entry !== "string" ||
+      !uuidSchema.safeParse(entry).success // UUIDスキーマによる安全な構造検証メソッド
+    ) {
+      return null;
+    }
+    const identifier = entry.toLowerCase(); // UUIDの表記を小文字へ揃えるメソッド
+    if (seen.has(identifier)) { // 正規化後のIDが重複しているかを調べるメソッド
+      return null;
+    }
+    seen.add(identifier); // 検証済みIDを重複検出用集合へ追加するメソッド
+    normalized.push(identifier); // 検証済みIDを配列へ追加するメソッド
+  }
+  return normalized.sort(); // UUID文字列を昇順に並べ、入力順による差を除くメソッド
+}
+
+/**
+ * 入力オブジェクトの許可項目だけを検証し、安全な項目エラーか正規化済み値を返す。
+ */
+export function validateEventMonthCopyInput( // 複製入力の構造検証と正規化を行う関数
+  input: unknown, // 外部から受け取る不明値型
+): EventMonthCopyValidation<EventMonthCopyInput> { // 複製入力型の検証結果型
+  if (
+    typeof input !== "object" ||
+    input === null ||
+    Array.isArray(input) // 配列を入力オブジェクトとして受け付けない判定メソッド
+  ) {
+    return {
+      success: false,
+      fieldErrors: {},
+      formError: INVALID_FORM_MESSAGE,
+    };
+  }
+  const prototype = Object.getPrototypeOf(input); // 入力オブジェクトのprototypeを取得するメソッド
+  if (
+    prototype !== Object.prototype && // 標準Objectコンストラクターのprototypeとの比較
+    prototype !== null
+  ) {
+    return {
+      success: false,
+      fieldErrors: {},
+      formError: INVALID_FORM_MESSAGE,
+    };
+  }
+  const record = input as Record<string, unknown>; // 文字列キーと不明値の辞書型への型アサーション
+  if (Object.keys(record).some( // 自身の項目名を取り出すメソッド / 未許可項目の有無を判定するメソッド
+    /**
+     * 許可項目に含まれない入力キーかを調べる。
+     */
+    (field) => !inputFields.has(field), // 項目名を検査するコールバック / 許可項目の集合照合メソッド
+  )) {
+    return {
+      success: false,
+      fieldErrors: {},
+      formError: INVALID_FORM_MESSAGE,
+    };
+  }
+  const targetMonth = isEventMonthCopyTargetMonth(record.targetMonth) // 厳密な対象月を検証する関数
+    ? record.targetMonth
+    : null;
+  const selectedEventIds = normalizeSelectedEventIds(record.selectedEventIds); // 選択IDを検証・正規化する関数
+  const requestId = isRequestId(record.requestId) // UUID v4のrequestIdを検証する関数
+    ? record.requestId.toLowerCase() // UUID表記を小文字に揃えるメソッド
+    : null;
+  const previewFingerprint = (
+    typeof record.previewFingerprint === "string" &&
+    record.previewFingerprint.length === 64 &&
+    /^[0-9a-f]{64}$/i.test(record.previewFingerprint) // SHA-256識別値の16進文字列形式を検証するメソッド
+  ) ? record.previewFingerprint.toLowerCase() : null; // 識別値の16進表記を小文字に揃えるメソッド
+  const fieldErrors: FieldErrors<EventMonthCopyField> = {}; // 複製項目名をキーにするエラー辞書型
+  if (targetMonth === null) {
+    fieldErrors.targetMonth = ["前月も指定可能な対象月をYYYY-MM形式で指定してください。"];
+  }
+  if (selectedEventIds === null) {
+    fieldErrors.selectedEventIds = [INVALID_SELECTION_MESSAGE];
+  }
+  if (requestId === null) {
+    fieldErrors.requestId = ["操作の識別値が不正です。再読込してください。"];
+  }
+  if (previewFingerprint === null) {
+    fieldErrors.previewFingerprint = ["複製予定の識別値が不正です。再読込してください。"];
+  }
+  if (
+    targetMonth === null ||
+    selectedEventIds === null ||
+    requestId === null ||
+    previewFingerprint === null
+  ) {
+    return {
+      success: false,
+      fieldErrors,
+      formError: null,
+    };
+  }
+  return {
+    success: true,
+    data: {
+      targetMonth,
+      selectedEventIds,
+      requestId,
+      previewFingerprint,
+    },
+  };
+}
+
+/**
+ * FormDataの単一項目・反復選択・件数を確認して、共通の入力検証へ渡す。
+ * $ACTION_で始まるNextの輸送用項目は無視し、業務入力として利用しない。
+ */
+export function parseEventMonthCopyFormData( // フォーム送信値を複製入力へ検証する関数
+  formData: FormData, // ブラウザー送信値を保持するFormData型
+): EventMonthCopyValidation<EventMonthCopyInput> { // 複製入力型の検証結果型
+  const selectedEventIds: string[] = []; // 上限内の選択IDを保持する文字列配列型
+  const record: Record<string, unknown> = { // 単一項目と選択IDを保持する不明値の辞書型
+    selectedEventIds,
+  };
+  if (!(formData instanceof FormData)) { // 実際のFormDataであることを確認する型判定
+    return {
+      success: false,
+      fieldErrors: {},
+      formError: INVALID_FORM_MESSAGE,
+    };
+  }
+  for (const [field, value] of formData.entries()) { // 送信された各項目を順番に取得するメソッド
+    if (field.startsWith("$ACTION_")) { // Nextの輸送用項目を判定するメソッド
+      continue;
+    }
+    if (
+      !inputFields.has(field) || // 業務入力の許可項目と照合するメソッド
+      typeof value !== "string" ||
+      (
+        field !== "selectedEventIds" &&
+        Object.hasOwn(record, field) // 単一項目が既に存在するかを調べるメソッド
+      )
+    ) {
+      return {
+        success: false,
+        fieldErrors: {},
+        formError: INVALID_FORM_MESSAGE,
+      };
+    }
+    if (field === "selectedEventIds") {
+      if (selectedEventIds.length >= EVENT_MONTH_COPY_MAX_COUNT) {
+        return {
+          success: false,
+          fieldErrors: {
+            selectedEventIds: [INVALID_SELECTION_MESSAGE],
+          },
+          formError: null,
+        };
+      }
+      selectedEventIds.push(value); // 上限内の選択IDを配列へ追加するメソッド
+    } else {
+      record[field] = value;
+    }
+  }
+  return validateEventMonthCopyInput(record); // オブジェクトと共通の構造検証・正規化を行う関数
+}
