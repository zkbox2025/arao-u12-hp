+  });
+});
diff --git a/src/infrastructure/supabase/club-invitation-session.ts b/src/infrastructure/supabase/club-invitation-session.ts
new file mode 100644
index 0000000..941fe34
--- /dev/null
+++ b/src/infrastructure/supabase/club-invitation-session.ts
@@ -0,0 +1,250 @@
+// src/infrastructure/supabase/club-invitation-session.ts
+
+import "server-only";
+
+import {
+  createServerClient,
+  type CookieOptions,
+} from "@supabase/ssr";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+
+import { normalizeEmail } from "@/domain/shared/email";
+import { createClient } from "@/src/infrastructure/supabase/server";
+
+export type VerifiedClubInvitationSession = {
+  user: {
+    id: string;
+    email: string;
+  };
+  authenticationMethod: "password" | "otp" | "unknown";
+  sessionId: string;
+};
+
+type CookieValue = {
+  name: string;
+  value: string;
+};
+
+type SessionCookie = CookieValue & {
+  options: CookieOptions;
+};
+
+export type ClubInvitationSessionResult =
+  | {
+      outcome: "VERIFIED";
+      session: VerifiedClubInvitationSession;
+      cookies: SessionCookie[];
+    }
+  | {
+      outcome:
+        | "INVALID_SESSION"
+        | "SWITCH_ACCOUNT"
+        | "PASSWORD_LOGIN_REQUIRED";
+    };
+
+const uuidSchema = z.uuid();
+const emailSchema = z.email().max(254);
+
+// SDKの両AMR形式を検査し、不明・混在形式から認証方法を推測しない。
+function authenticationMethod(
+  value: unknown,
+): VerifiedClubInvitationSession["authenticationMethod"] {
+  if (!Array.isArray(value) || value.length === 0) {
+    return "unknown";
+  }
+
+  let methods: string[];
+
+  if (value.every((entry) => typeof entry === "string" && entry.length > 0)) {
+    methods = value;
+  } else if (value.every((entry) => (
+    typeof entry === "object" &&
+    entry !== null &&
+    typeof entry.method === "string" &&
+    entry.method.length > 0 &&
+    Number.isSafeInteger(entry.timestamp) &&
+    entry.timestamp >= 0
+  ))) {
+    methods = value.map((entry) => entry.method);
+  } else {
+    return "unknown";
+  }
+
+  if (methods.includes("password")) {
+    return "password";
+  }
+
+  // otp単独ではinviteの証明にならない。呼出元でDB招待も照合する。
+  return methods.includes("otp") ? "otp" : "unknown";
+}
+
+// 同じaccess tokenをAuthと署名検証済みclaimsの双方で確認する。
+async function verifyAccessToken(
+  client: SupabaseClient,
+  accessToken: string,
+): Promise<VerifiedClubInvitationSession | null> {
+  const userResult = await client.auth.getUser(accessToken);
+  const claimsResult = await client.auth.getClaims(accessToken);
+  const user = userResult.data.user;
+  const claims = claimsResult.data?.claims;
+  const email = normalizeEmail(user?.email ?? "");
+
+  if (
+    userResult.error ||
+    claimsResult.error ||
+    !user ||
+    !claims ||
+    !uuidSchema.safeParse(user.id).success ||
+    !emailSchema.safeParse(email).success ||
+    claims.sub !== user.id ||
+    claims.role !== "authenticated" ||
+    !uuidSchema.safeParse(claims.session_id).success ||
+    !Number.isSafeInteger(claims.exp) ||
+    claims.exp <= Date.now() / 1_000 ||
+    user.is_anonymous === true
+  ) {
+    return null;
+  }
+
+  return {
+    user: {
+      id: user.id,
+      email,
+    },
+    authenticationMethod: authenticationMethod(claims.amr),
+    sessionId: claims.session_id,
+  };
+}
+
+// Cookieから読み出したuserを信用せず、現在の同一tokenを再検証する。
+export async function getVerifiedClubInvitationSession(
+  client?: SupabaseClient,
+): Promise<VerifiedClubInvitationSession | null> {
+  try {
+    const supabase = client ?? await createClient();
+    const {
+      data,
+      error,
+    } = await supabase.auth.getSession();
+
+    if (error || !data.session?.access_token) {
+      return null;
+    }
+
+    return await verifyAccessToken(supabase, data.session.access_token);
+  } catch {
+    // SDKエラーやtokenを呼出元・ログへ渡さない。
+    return null;
+  }
+}
+
+// SDKによるCookie更新はメモリ内に保持し、成功応答を作るまで確定しない。
+function stagedClient(initialCookies: CookieValue[]) {
+  const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
+  const key = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;
+
+  if (!url || !key) {
+    throw new Error("Invitation session configuration unavailable");
+  }
+
+  const jar = new Map(initialCookies.map((cookie) => [cookie.name, cookie.value]));
+  const pending = new Map<string, SessionCookie>();
+  const client = createServerClient(url, key, {
+    cookies: {
+      // 検証中にrefreshされた値も、次のSDK呼出しから参照できるようにする。
+      getAll() {
+        return Array.from(jar, ([name, value]) => ({
+          name,
+          value,
+        }));
+      },
+      // 削除Cookieや分割Cookieの属性も省略せず保持する。
+      setAll(cookies) {
+        for (const cookie of cookies) {
+          jar.set(cookie.name, cookie.value);
+          pending.set(cookie.name, cookie);
+        }
+      },
+    },
+  });
+
+  return {
+    client,
+    pending,
+  };
+}
+
+// 既存の本人と受信token・refresh後の本人を照合し、未確定Cookieだけを返す。
+export async function prepareClubInvitationSession(input: {
+  accessToken: string;
+  refreshToken: string;
+  currentCookies: CookieValue[];
+}): Promise<ClubInvitationSessionResult> {
+  try {
+    const current = stagedClient(input.currentCookies);
+    const currentResult = await current.client.auth.getSession();
+
+    if (currentResult.error) {
+      return { outcome: "INVALID_SESSION" };
+    }
+
+    const currentSession = currentResult.data.session;
+    const existing = currentSession
+      ? await verifyAccessToken(current.client, currentSession.access_token)
+      : null;
+
+    if (currentSession && !existing) {
+      return { outcome: "INVALID_SESSION" };
+    }
+
+    const incoming = stagedClient([]);
+    const received = await verifyAccessToken(incoming.client, input.accessToken);
+
+    if (!received) {
+      return { outcome: "INVALID_SESSION" };
+    }
+
+    if (received.authenticationMethod !== "otp") {
+      return { outcome: "PASSWORD_LOGIN_REQUIRED" };
+    }
+
+    if (existing && existing.user.id !== received.user.id) {
+      return { outcome: "SWITCH_ACCOUNT" };
+    }
+
+    // 有効なaccess tokenでもrefresh tokenを実際に検証し、組合せ違いを拒否する。
+    const refreshed = await incoming.client.auth.refreshSession({
+      refresh_token: input.refreshToken,
+    });
+    const refreshedToken = refreshed.data.session?.access_token;
+
+    if (refreshed.error || !refreshedToken) {
+      return { outcome: "INVALID_SESSION" };
+    }
+
+    const verified = await verifyAccessToken(incoming.client, refreshedToken);
+
+    if (
+      !verified ||
+      verified.user.id !== received.user.id ||
+      verified.user.email !== received.user.email ||
+      verified.sessionId !== received.sessionId ||
+      verified.authenticationMethod !== "otp" ||
+      incoming.pending.size === 0
+    ) {
+      return { outcome: "INVALID_SESSION" };
+    }
+
+    // 同一本人がpasswordでログイン済みなら、その認証方法を維持する。
+    const retainPassword = existing?.authenticationMethod === "password";
+
+    return {
+      outcome: "VERIFIED",
+      session: retainPassword ? existing : verified,
+      cookies: Array.from((retainPassword ? current : incoming).pending.values()),
+    };
+  } catch {
+    return { outcome: "INVALID_SESSION" };
+  }
+}
