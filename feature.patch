index 0000000..c2c1c62
--- /dev/null
+++ b/app/(club-app)/welcome/InvitationAcceptanceScreen.tsx
@@ -0,0 +1,202 @@
+// app/(club-app)/welcome/InvitationAcceptanceScreen.tsx
+// 本人確認済みの表示情報だけで、初回設定と既存承諾の画面を組み立てる。
+
+import "server-only";
+
+import Link from "next/link";
+import {
+  cookies,
+} from "next/headers";
+import {
+  unstable_rethrow,
+} from "next/navigation";
+
+import type {
+  WelcomeActionState,
+  WelcomeFormValues,
+} from "@/domain/club/invitation/acceptance-form";
+import type {
+  ClubInvitationAcceptanceViolation,
+} from "@/domain/club/invitation/acceptance-policy";
+import {
+  createInitialActionState,
+} from "@/domain/shared/action-state";
+import {
+  getClubInvitationAcceptance,
+  type GetClubInvitationAcceptanceResult,
+} from "@/src/application/club/invitation/get-club-invitation-acceptance";
+import {
+  CLUB_INVITATION_CONTEXT_COOKIE_NAME,
+  parseClubInvitationContext,
+  type ClubInvitationContext,
+} from "@/src/infrastructure/security/club-invitation-context";
+
+import {
+  AcceptInvitationForm,
+} from "../club-invitations/accept/AcceptInvitationForm";
+import {
+  InvitationAuthBridge,
+} from "./InvitationAuthBridge";
+import {
+  WelcomeForm,
+} from "./WelcomeForm";
+
+const UNAVAILABLE_MESSAGES: Record<ClubInvitationAcceptanceViolation, string> = {
+  INVALID_INVITATION:
+    "招待を確認できません。招待メールのリンクから開き直してください。",
+  RECIPIENT_MISMATCH:
+    "招待されたアカウントでログインし直してください。",
+  INVITATION_EMAIL_MISMATCH:
+    "招待先のメールアドレスと一致しません。運営者へお問い合わせください。",
+  INVITATION_ALREADY_ACCEPTED:
+    "この招待は承諾済みです。クラブ一覧から参加先を確認してください。",
+  INVITATION_CANCELLED:
+    "この招待は取り消されています。運営者へ新しい招待を依頼してください。",
+  INVITATION_EXPIRED:
+    "この招待の有効期限は切れています。運営者へ新しい招待を依頼してください。",
+  MEMBERSHIP_MISMATCH:
+    "招待の状態を確認できません。運営者へお問い合わせください。",
+  INVALID_INVITATION_STATE:
+    "招待の状態を確認できません。運営者へお問い合わせください。",
+};
+
+// 認証方法や利用不可の理由は、読取Serviceで照合した結果だけを案内する。
+function acceptanceMessage(
+  result: GetClubInvitationAcceptanceResult,
+): string {
+  switch (result.outcome) {
+    case "AVAILABLE":
+      return result.authenticationMethod === "password"
+        ? "ログイン中のアカウントで参加します。パスワードの再設定は不要です。"
+        : "初回パスワードを設定して、招待を承諾してください。";
+    case "AUTHENTICATION_REQUIRED":
+      return "新規の方は招待メールの認証リンクを開いてください。" +
+        "既存の方は招待されたアカウントでログインしてください。";
+    case "PASSWORD_LOGIN_REQUIRED":
+      return "認証方法を確認できません。既存のアカウントでパスワードログインしてください。";
+    case "UNAVAILABLE":
+      return UNAVAILABLE_MESSAGES[result.view.reason];
+    default:
+      return "招待情報を取得できませんでした。時間をおいてページを開き直してください。";
+  }
+}
+
+// Cookieは読取だけに使い、本人確認前のクラブ名や秘密情報をClientへ渡さない。
+export async function InvitationAcceptanceScreen({
+  mode,
+  invalidLink,
+}: {
+  mode: "welcome" | "existing";
+  invalidLink: boolean;
+}) {
+  let context: ClubInvitationContext | null = null;
+  let result: GetClubInvitationAcceptanceResult = {
+    outcome: "ERROR",
+    view: {
+      status: "error",
+      reason: "PROCESSING_FAILED",
+    },
+  };
+
+  try {
+    const cookieStore = await cookies();
+    const rawContext = invalidLink
+      ? undefined
+      : cookieStore.get(CLUB_INVITATION_CONTEXT_COOKIE_NAME)?.value;
+    context = parseClubInvitationContext(rawContext);
+    result = await getClubInvitationAcceptance({
+      context: rawContext,
+    });
+  } catch (error) {
+    unstable_rethrow(error);
+  }
+
+  const invitation = result.outcome === "AVAILABLE" &&
+    context !== null
+    ? {
+        view: result.view,
+        authenticationMethod: result.authenticationMethod,
+        contextId: context.contextId,
+      }
+    : null;
+  const showWelcome = invitation !== null &&
+    mode === "welcome" &&
+    invitation.authenticationMethod === "otp";
+  const showAcceptance = invitation !== null &&
+    mode === "existing" &&
+    invitation.authenticationMethod === "password";
+  const initialState: WelcomeActionState =
+    createInitialActionState<WelcomeFormValues>({});
+
+  return (
+    <main className="min-h-screen bg-slate-50 px-4 py-12">
+      <section className="mx-auto max-w-md space-y-5 rounded-lg bg-white p-6 shadow-sm">
+        <h1 className="text-2xl font-bold text-slate-900">
+          {mode === "welcome" ? "初回設定・招待の確認" : "クラブ招待の承諾"}
+        </h1>
+        <InvitationAuthBridge contextId={context?.contextId}>
+          <p role={result.outcome === "ERROR" ? "alert" : undefined}>
+            {acceptanceMessage(result)}
+          </p>
+          {invitation && (
+            <dl className="space-y-2">
+              <dt className="font-bold">招待先クラブ</dt>
+              <dd>{invitation.view.clubName}</dd>
+              <dt className="font-bold">招待の有効期限</dt>
+              <dd>
+                <time dateTime={invitation.view.expiresAt}>
+                  {new Intl.DateTimeFormat("ja-JP", {
+                    dateStyle: "medium",
+                    timeStyle: "short",
+                    timeZone: "Asia/Tokyo",
+                  }).format(new Date(invitation.view.expiresAt))}（日本時間）
+                </time>
+              </dd>
+            </dl>
+          )}
+          {showWelcome &&
+            invitation && (
+              <WelcomeForm
+                key={invitation.contextId}
+                contextId={invitation.contextId}
+                initialState={initialState}
+              />
+            )}
+          {showAcceptance &&
+            invitation && (
+              <AcceptInvitationForm
+                key={invitation.contextId}
+                contextId={invitation.contextId}
+                initialState={initialState}
+              />
+            )}
+          {invitation &&
+            !showWelcome &&
+            !showAcceptance && (
+              <Link
+                href={mode === "welcome" ? "/club-invitations/accept" : "/welcome"}
+                prefetch={false}
+                className="block underline"
+              >
+                {mode === "welcome" ? "招待の承諾へ進む" : "初回設定へ進む"}
+              </Link>
+            )}
+          <Link
+            href="/club-login"
+            prefetch={false}
+            className="block underline"
+          >
+            既存アカウントでログインする
+          </Link>
+          <Link
+            href="/club/select"
+            prefetch={false}
+            className="block underline"
+          >
+            通常のクラブ利用へ進む
+          </Link>
+        </InvitationAuthBridge>
+      </section>
+    </main>
+  );
+}
