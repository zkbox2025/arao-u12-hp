+    args: [
+      "req",
+      "-x509",
+      "-newkey",
+      "rsa:2048",
+      "-nodes",
+      "-keyout",
+      keyFile,
+      "-out",
+      certFile,
+      "-days",
+      "1",
+      "-subj",
+      "/CN=127.0.0.1",
+      "-config",
+      configFile,
+      "-extensions",
+      "server",
+    ],
+    cwd: directory,
+    env: {
+      PATH: process.env.PATH,
+      NODE_ENV: "test"
+    },
+  });
+  await waitMvpChild(child, 20000, signal); // 子の失敗・signal・期限超過を固定例外にし、期限超過時は所有workerも停止する
+  chmodSync(keyFile, 0o600); // 所有ファイルの権限を設定する関数
+  chmodSync(certFile, 0o600); // 所有ファイルの権限を設定する関数
