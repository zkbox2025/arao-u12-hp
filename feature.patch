+// domain/club/event/event-practice-batch-types.ts
+// 定期練習の共通入力、限定preview、保存結果とAction stateの契約。
+
+import type {
+  ActionState, // フォームの入力・エラー・成功データ・操作IDをまとめる型
+  FieldErrors, // 入力項目ごとのエラーメッセージを保持する型
+} from "@/domain/shared/action-state";
+import type {
+  ClubMemberRole, // Prisma由来のクラブ所属ロール型
+} from "@/types/prisma";
+
+/**
+ * 除外前の生成候補と保存選択の最大件数。
+ */
+export const EVENT_PRACTICE_BATCH_MAX_COUNT = 31;
+
+/**
+ * クラブ現地の曜日。日曜を0、土曜を6とする。
+ */
+export type EventPracticeBatchWeekday = 0 | 1 | 2 | 3 | 4 | 5 | 6; // クラブ現地の曜日型 / 値を限定するリテラル型
+
+/**
+ * 入力欄へ戻す未検証の文字列。初期状態の空欄も表現する。
+ */
+export type EventPracticeBatchFormValues = { // フォーム入力値型
+  targetMonth: string; // 文字列型
+  periodStart: string; // 文字列型
+  periodEnd: string; // 文字列型
+  weekdays: readonly string[]; // 文字列型
+  title: string; // 文字列型
+  startTime: string; // 文字列型
+  endTime: string; // 文字列型
+  location: string; // 文字列型
+  meetingTime: string; // 文字列型
+  meetingLocation: string; // 文字列型
+  targetRoles: readonly string[]; // 文字列型
+};
+
+/**
+ * 構造検証・正規化した共通入力。曜日候補・UTC・認可は後続で再確認する。
+ */
+export type EventPracticeBatchCommonInput = { // 構造検証・正規化した共通入力型
+  targetMonth: string; // 文字列型
+  periodStart: string; // 文字列型
+  periodEnd: string; // 文字列型
+  weekdays: readonly EventPracticeBatchWeekday[]; // クラブ現地の曜日型
+  title: string; // 文字列型
+  startTime: string; // 文字列型
+  endTime: string; // 文字列型
+  location: string | null; // 文字列型 / 未設定を表すnull型
+  meetingTime: string | null; // 文字列型 / 未設定を表すnull型
+  meetingLocation: string | null; // 文字列型 / 未設定を表すnull型
+  targetRoles: readonly ClubMemberRole[]; // クラブ所属ロール型
+};
+
+/**
+ * 共通入力に選択日と操作識別子を加えた実行入力。
+ */
+export type EventPracticeBatchInput = EventPracticeBatchCommonInput & { // 保存入力型 / 構造検証・正規化した共通入力型
+  selectedDates: readonly string[]; // 文字列型
+  requestId: string; // 文字列型
+  previewFingerprint: string; // 文字列型
+};
+
+/**
+ * preview入力と実行入力に対応する項目名。
+ */
+export type EventPracticeBatchField = // 入力項目名型
+  | keyof EventPracticeBatchFormValues // フォーム入力値型
+  | "selectedDates" // 値を限定するリテラル型
+  | "requestId" // 値を限定するリテラル型
+  | "previewFingerprint"; // 値を限定するリテラル型
+
+/**
+ * 検証済み値と、安全な項目エラー・フォームエラーを区別する結果型。
+ */
+export type EventPracticeBatchValidation<T> = // 入力検証の結果型 / 検証成功時のデータ型
+  | {
+      success: true; // 値を限定するリテラル型
+      data: T; // 検証成功時のデータ型
+    }
+  | {
+      success: false; // 値を限定するリテラル型
+      fieldErrors: FieldErrors<EventPracticeBatchField>; // 項目別エラーの型 / 入力項目名型
+      formError: string | null; // 文字列型 / 未設定を表すnull型
+    };
+
+/**
+ * Clientへ返す生成予定のUTC ISO日時。終了は必須、集合は任意。
+ */
+export type EventPracticeBatchPreviewDateTimes = { // Clientへ返す生成予定のUTC ISO日時型
+  startAt: string; // 文字列型
+  endAt: string; // 文字列型
+  meetingAt: string | null; // 文字列型 / 未設定を表すnull型
+};
+
+/**
+ * 後続の日時生成で候補を選択不可にする理由。
+ */
+export type EventPracticeBatchExclusionReason = // 後続の日時生成で候補を選択不可にする理由型
+  | "NONEXISTENT_LOCAL_TIME" // 値を限定するリテラル型
+  | "AMBIGUOUS_LOCAL_TIME" // 値を限定するリテラル型
+  | "INVALID_INTERVAL" // 値を限定するリテラル型
+  | "OUT_OF_RANGE" // 値を限定するリテラル型
+  | "INVALID_DATE_TIME"; // 値を限定するリテラル型
+
+/**
+ * 選択を禁止せず、previewで確認を促す警告。
+ */
+export type EventPracticeBatchWarning = "MEETING_AFTER_START"; // 選択を禁止せず、previewで確認を促す警告型 / 値を限定するリテラル型
+
+/**
+ * 1日1件の限定preview。既存イベントの本文・モデル・IDは含めない。
+ */
+export type EventPracticeBatchPreviewItem = { // 1日1件の限定preview型
+  date: string; // 文字列型
+  dates: EventPracticeBatchPreviewDateTimes | null; // Clientへ返す生成予定のUTC ISO日時型 / 未設定を表すnull型
+  exclusionReason: EventPracticeBatchExclusionReason | null; // 後続の日時生成で候補を選択不可にする理由型 / 未設定を表すnull型
+  warnings: readonly EventPracticeBatchWarning[]; // 選択を禁止せず、previewで確認を促す警告型
+  duplicate: boolean; // 真偽値型
+  initiallySelected: boolean; // 真偽値型
+};
+
+/**
+ * 正規化入力、現在のtimezone、候補と件数を持つpreview成功データ。
+ */
+export type EventPracticeBatchPreviewReady = { // preview成功データ型
+  outcome: "READY"; // 値を限定するリテラル型
+  input: EventPracticeBatchCommonInput; // 構造検証・正規化した共通入力型
+  timezone: string; // 文字列型
+  fingerprint: string; // 文字列型
+  items: readonly EventPracticeBatchPreviewItem[]; // 1日1件の限定preview型
+  candidateCount: number; // 数値型
+  selectableCount: number; // 数値型
+};
+
+/**
+ * 候補0件を含む成功と、超過・権限拒否・取得失敗を区別するpreview結果。
+ */
+export type EventPracticeBatchPreview = // preview結果型
+  | EventPracticeBatchPreviewReady // preview成功データ型
+  | {
+      outcome: "TOO_MANY" | "FORBIDDEN" | "PREVIEW_FAILED"; // 値を限定するリテラル型
+    };
+
+/**
+ * 成功ledgerから返す対象月と件数だけの保存完了情報。
+ */
+export type EventPracticeBatchReceipt = { // 対象月・件数のreceipt型
+  targetMonth: string; // 文字列型
+  createdCount: number; // 数値型
+};
+
+/**
+ * 保存せず拒否した場合と、保存結果を確認できない場合を判別するコード。
+ */
+export type EventPracticeBatchFailureOutcome = // 拒否・結果不明のコード型
+  | "VALIDATION_FAILED" // 値を限定するリテラル型
+  | "FORBIDDEN" // 値を限定するリテラル型
+  | "PREVIEW_CHANGED" // 値を限定するリテラル型
+  | "CONFLICT" // 値を限定するリテラル型
+  | "CREATE_FAILED" // 値を限定するリテラル型
+  | "RESULT_UNKNOWN"; // 値を限定するリテラル型
+
+/**
+ * 一括保存の新規完了・replay完了と、安全な失敗結果の契約。
+ */
+export type EventPracticeBatchResult = // 一括保存結果型
+  | {
+      outcome: "CREATED" | "ALREADY_COMPLETED"; // 値を限定するリテラル型
+      receipt: EventPracticeBatchReceipt; // 対象月・件数のreceipt型
+    }
+  | {
+      outcome: EventPracticeBatchFailureOutcome; // 拒否・結果不明のコード型
+    };
+
+/**
+ * 保存済みのまま一覧の再読込が必要な場合も表せる成功データ。
+ */
+export type EventPracticeBatchActionData = EventPracticeBatchReceipt & { // 保存後の成功データ型 / 対象月・件数のreceipt型
+  needsReload: boolean; // 真偽値型
+};
+
+/**
+ * preview Actionの入力・状態。新しい操作IDは成功後にサーバーが設定する。
+ */
+export type EventPracticeBatchPreviewActionState = Omit< // preview Actionの入力・状態型 / 指定したプロパティを除く型
+  ActionState< // 入力・エラー・成功データを持つAction状態型
+    EventPracticeBatchFormValues, // フォーム入力値型
+    EventPracticeBatchField, // 入力項目名型
+    EventPracticeBatchPreviewReady // preview成功データ型
+  >,
+  "status" | "data" // 値を限定するリテラル型
+> & (
+  | {
+      status: "idle"; // 値を限定するリテラル型
+      outcome?: never; // 値を許可しない型
+      data?: never; // 値を許可しない型
+    }
+  | {
+      status: "error"; // 値を限定するリテラル型
+      outcome: "VALIDATION_FAILED" | "TOO_MANY" | "FORBIDDEN" | "PREVIEW_FAILED"; // 値を限定するリテラル型
+      data?: never; // 値を許可しない型
+    }
+  | {
+      status: "success"; // 値を限定するリテラル型
+      outcome: "READY"; // 値を限定するリテラル型
+      data: EventPracticeBatchPreviewReady; // preview成功データ型
+    }
+);
+
+/**
+ * 保存Actionの入力・状態。結果不明を保存済みや再preview可能な失敗と混同しない。
+ */
+export type EventPracticeBatchActionState = Omit< // 保存Actionの入力・状態型 / 指定したプロパティを除く型
+  ActionState< // 入力・エラー・成功データを持つAction状態型
+    EventPracticeBatchInput, // 保存入力型
+    EventPracticeBatchField, // 入力項目名型
+    EventPracticeBatchActionData // 保存後の成功データ型
+  >,
+  "status" | "data" // 値を限定するリテラル型
+> & (
+  | {
+      status: "idle"; // 値を限定するリテラル型
+      outcome?: never; // 値を許可しない型
+      data?: never; // 値を許可しない型
+    }
+  | {
+      status: "error"; // 値を限定するリテラル型
+      outcome: EventPracticeBatchFailureOutcome; // 拒否・結果不明のコード型
+      data?: never; // 値を許可しない型
+    }
+  | {
+      status: "success"; // 値を限定するリテラル型
+      outcome: "CREATED" | "ALREADY_COMPLETED"; // 値を限定するリテラル型
+      data: EventPracticeBatchActionData; // 保存後の成功データ型
+    }
+);
