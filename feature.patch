+  return {
+    ...actions,
+    report: {
+      ...item.report,
+      createdAt: V1,
+      club: {
+        id: "club-id",
+        name: "クラブ",
+        slug: "club-a",
+      },
+      category: "BUG", message: "本文", pageUrl: null, userAgent: null,
+      reporterName: null, reporterEmail: null, reporterRole: null,
