+// src/application/club/support/create-support-report.ts
+// DB受付を正本として保存し、補助通知と結果記録の失敗でも受付成功を維持する。
+
+import "server-only";
+
+import type {
+  ClubAccessContext,
+} from "@/app/(club-app)/club/club-membership-authorization";
+import {
+  validateSupportReportInput,
+  type SupportReportFormValues,
+} from "@/domain/club/support/support-report-form";
+import type {
+  SupportReportAcceptanceResult,
+  SupportReportMetadata,
+  SupportReportNotificationErrorCode,
+  SupportReportNotificationResult,
+  SupportReportReceipt,
+} from "@/domain/club/support/support-report-types";
+import { isRequestId } from "@/domain/shared/request-id";
+import { sendSupportReportEmail } from "@/lib/mail/support-report-mail";
+import {
+  sanitizeLogContext,
+} from "@/src/infrastructure/logging/sanitize-log-context";
+import {
+  createSupportReportForMember,
+  recordSupportReportNotification,
+} from "@/src/infrastructure/prisma/repositories/support-report-repository";
+
+// 固定分類と受付IDだけを記録し、ログ基盤の例外も受付結果へ波及させない。
+function logSupportReportFailure(
+  requestId: string,
+  operation:
+    | "supportReport.create"
+    | "supportReport.notify"
+    | "supportReport.recordNotification",
+  result:
+    | SupportReportNotificationErrorCode
+    | "CREATE_FAILED"
+    | "NOT_FOUND"
+    | "UPDATE_FAILED",
+  errorCode: "INTERNAL" | "EXTERNAL_SERVICE",
+): void {
+  try {
+    console.error(
+      "support_report_operation_failed",
+      sanitizeLogContext({
+        requestId,
+        operation,
+        result,
+        errorCode,
+      }),
+    );
+  } catch {
+    // ログ出力失敗を理由に、通知や受付を再試行しない。
+  }
+}
+
+// 通知は一度だけ試行し、例外や契約外の結果は固定の結果不明へ変換する。
+async function notifySavedReport(
+  report: SupportReportReceipt,
+): Promise<SupportReportNotificationResult> {
+  try {
+    const result = await sendSupportReportEmail(report);
+
+    if (result.outcome === "ACCEPTED") {
+      return {
+        outcome: "ACCEPTED",
+      };
+    }
+    if (
+      result.outcome === "FAILED" &&
+      (
+        result.errorCode === "EMAIL_CONFIGURATION_MISSING" ||
+        result.errorCode === "EMAIL_SEND_FAILED"
+      )
+    ) {
+      return {
+        outcome: "FAILED",
+        errorCode: result.errorCode,
+      };
+    }
+  } catch {
+    // 外部例外の原文やcauseは、結果保存にもログにも渡さない。
+  }
+
+  return {
+    outcome: "UNKNOWN",
+    errorCode: "EMAIL_SEND_RESULT_UNKNOWN",
+  };
+}
+
+// 認可済みcontextと許可入力を分離し、DB保存後は内部通知状態を公開しない。
+export async function createSupportReport(
+  context: ClubAccessContext,
+  requestId: string,
+  input: SupportReportFormValues,
+  metadata: SupportReportMetadata,
+): Promise<SupportReportAcceptanceResult> {
+  const validation = validateSupportReportInput(input);
+
+  if (
+    !isRequestId(requestId) ||
+    !validation.success
+  ) {
+    return {
+      outcome: "CREATE_FAILED",
+    };
+  }
+
+  let report: SupportReportReceipt;
+
+  try {
+    const result = await createSupportReportForMember({
+      clubId: context.club.id,
+      actorMembershipId: context.membership.id,
+      userId: context.userId,
+      requestId,
+      category: validation.data.category,
+      message: validation.data.message,
+      pageUrl: metadata.pageUrl,
+      userAgent: metadata.userAgent,
+    });
+
+    switch (result.outcome) {
+      case "CREATED":
+        report = result.report;
+        break;
+      case "ALREADY_ACCEPTED":
+        return {
+          outcome: "ACCEPTED",
+        };
+      case "FORBIDDEN":
+      case "CONFLICT":
+      case "CREATE_FAILED":
+        return {
+          outcome: result.outcome,
+        };
+      default:
+        return {
+          outcome: "CREATE_FAILED",
+        };
+    }
+  } catch {
+    logSupportReportFailure(
+      requestId,
+      "supportReport.create",
+      "CREATE_FAILED",
+      "INTERNAL",
+    );
+    return {
+      outcome: "CREATE_FAILED",
+    };
+  }
+
+  const notification = await notifySavedReport(report);
+
+  if (notification.outcome !== "ACCEPTED") {
+    logSupportReportFailure(
+      requestId,
+      "supportReport.notify",
+      notification.errorCode,
+      "EXTERNAL_SERVICE",
+    );
+  }
+
+  try {
+    const recorded = await recordSupportReportNotification({
+      reportId: report.id,
+      clubId: report.clubId,
+      notification,
+    });
+
+    if (recorded.outcome !== "RECORDED") {
+      logSupportReportFailure(
+        requestId,
+        "supportReport.recordNotification",
+        recorded.outcome === "NOT_FOUND" ? "NOT_FOUND" : "UPDATE_FAILED",
+        "INTERNAL",
+      );
+    }
+  } catch {
+    logSupportReportFailure(
+      requestId,
+      "supportReport.recordNotification",
+      "UPDATE_FAILED",
+      "INTERNAL",
+    );
+  }
+
+  return {
+    outcome: "ACCEPTED",
+  };
+}
