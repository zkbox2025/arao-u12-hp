@@ -0,0 +1,230 @@
+// app/(club-app)/club/[clubSlug]/account/ChildMembershipOperations.tsx
+// 所属解除と、利用者が開いた時だけ取得する既存Child候補・所属追加を扱う。
+
+"use client";
+
+import {
+  useEffect,
+  useId,
+  useRef,
+  useState,
+  useTransition,
+} from "react";
+
+import {
+  FieldErrorList,
+} from "@/app/(club-app)/club/admin/_components/FieldErrorList";
+import {
+  FormErrorAlert,
+} from "@/app/(club-app)/club/admin/_components/FormErrorAlert";
+import {
+  useScrollToFormError,
+} from "@/app/(club-app)/club/admin/_hooks/useScrollToFormError";
+import type {
+  ClubAccountChildCandidatesResult,
+  ClubAccountChildView,
+} from "@/domain/club/account/account-types";
+import {
+  CHILD_GRADE_OPTIONS,
+  type ChildMembershipActionState,
+} from "@/domain/club/account/child-form";
+import {
+  createInitialActionState,
+} from "@/domain/shared/action-state";
+
+import {
+  AccountConfirmDialog,
+  useConfirmedAccountForm,
+} from "./AccountConfirmDialog";
+
+type MembershipAction = (
+  state: ChildMembershipActionState,
+  data: FormData,
+) => Promise<ChildMembershipActionState>;
+
+type MembershipProps = {
+  mode: "add" | "withdraw";
+  childId: string;
+  initialState: ChildMembershipActionState;
+  action: MembershipAction;
+  disabled?: boolean;
+  onBusyChange?: (busy: boolean) => void;
+};
+
+type AddProps = {
+  mode: "add";
+  loadAction: () => Promise<ClubAccountChildCandidatesResult>;
+  action: (childId: string, state: ChildMembershipActionState, data: FormData) =>
+    Promise<ChildMembershipActionState>;
+};
+
+type Props = (MembershipProps & { mode: "withdraw" }) | AddProps;
+
+// Childごとに独立したstate・確認・hidden値を持つ。所属先・所有者はActionで再照合する。
+function MembershipForm({
+  mode,
+  childId,
+  initialState,
+  action,
+  disabled = false,
+  onBusyChange,
+}: MembershipProps) {
+  const form = useConfirmedAccountForm(action, initialState);
+  const formRef = useScrollToFormError(form.state);
+  const errorId = useId();
+  const withdrawing = mode === "withdraw";
+  const label = withdrawing ? "現在クラブから外す" : "現在クラブへ追加する";
+
+  useEffect(() => {
+    onBusyChange?.(form.pending || form.isOpen);
+    return () => onBusyChange?.(false);
+  }, [form.pending, form.isOpen, onBusyChange]);
+
+  return (
+    <>
+      <form
+        ref={formRef}
+        method="post"
+        onSubmit={form.onSubmit}
+        className="mt-4 space-y-2"
+      >
+        <fieldset disabled={disabled || form.pending || form.isOpen}>
+          <input
+            type="hidden"
+            name="requestId"
+            value={form.state.requestId}
+          />
+          <input
+            type="hidden"
+            name="childId"
+            value={childId}
+          />
+          <FormErrorAlert message={form.state.formError} />
+          <FieldErrorList
+            id={errorId}
+            errors={form.state.fieldErrors.childId}
+          />
+          <button
+            type="submit"
+            className="rounded-lg border border-slate-300 px-4 py-2"
+          >
+            {form.pending ? "処理中…" : label}
+          </button>
+        </fieldset>
+      </form>
+      <AccountConfirmDialog
+        isOpen={form.isOpen}
+        pending={form.pending}
+        returnFocusRef={form.returnFocusRef}
+        title={withdrawing ? "現在クラブから外しますか？" : "現在クラブへ追加しますか？"}
+        confirmLabel={label}
+        onClose={form.close}
+        onConfirm={() => form.confirm()}
+      >
+        {withdrawing
+          ? "子ども本体と他クラブの所属は残ります。入力中の編集は保存されません。"
+          : "既存の子どもを再利用して現在クラブへ追加します。"}
+      </AccountConfirmDialog>
+    </>
+  );
+}
+
+// 候補ごとに初期stateを一度だけ作り、他の候補の入力・エラーを共有しない。
+function CandidateRow({ child, action, disabled, onBusyChange }: {
+  child: ClubAccountChildView;
+  action: AddProps["action"];
+  disabled: boolean;
+  onBusyChange: (busy: boolean) => void;
+}) {
+  const [initialState] = useState(() => createInitialActionState({ childId: child.id }));
+  return (
+    <li className="rounded-lg border border-slate-200 p-4">
+      <p className="font-bold">{child.name}</p>
+      <p className="text-sm text-slate-600">
+        学年：{CHILD_GRADE_OPTIONS.find((option) => option.value === child.grade)?.label ?? "未設定"}
+      </p>
+      <MembershipForm
+        mode="add"
+        childId={child.id}
+        initialState={initialState}
+        action={action.bind(null, child.id)}
+        disabled={disabled}
+        onBusyChange={onBusyChange}
+      />
+    </li>
+  );
+}
+
+// mount時には候補を取得しない。開き直すたびに古い候補とstateを破棄して取得する。
+function AddOperations({ loadAction, action }: AddProps) {
+  const [isOpen, setIsOpen] = useState(false);
+  const [result, setResult] = useState<ClubAccountChildCandidatesResult | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [loading, startLoading] = useTransition();
+  const loadingRef = useRef(false);
+
+  // 認可失効によるNext制御例外はcatchで握りつぶさず、Nextへ委ねる。
+  function open() {
+    if (loading || loadingRef.current || busy) {
+      return;
+    }
+    loadingRef.current = true;
+    setIsOpen(true);
+    setResult(null);
+    startLoading(async () => {
+      try {
+        setResult(await loadAction());
+      } finally {
+        loadingRef.current = false;
+      }
+    });
+  }
+
+  return (
+    <section className="mt-5 space-y-3">
+      <button
+        type="button"
+        disabled={loading || busy}
+        onClick={open}
+      >
+        {loading ? "候補を取得中…" : "登録済みの子どもを現在クラブへ追加"}
+      </button>
+      {isOpen ? (
+        <div className="space-y-3 rounded-lg border border-slate-200 p-4">
+          <h3 className="font-bold">追加できる子ども</h3>
+          {result?.outcome === "FOUND" ? (
+            result.children.length === 0 ? (
+              <p>追加できる子どもはいません。</p>
+            ) : (
+              <ul className="space-y-3">
+                {result.children.map((child) => (
+                  <CandidateRow
+                    key={child.id}
+                    child={child}
+                    action={action}
+                    disabled={busy}
+                    onBusyChange={setBusy}
+                  />
+                ))}
+              </ul>
+            )
+          ) : result ? (
+            <FormErrorAlert message="候補を取得できませんでした。ページを開き直してください。" />
+          ) : null}
+          <button
+            type="button"
+            disabled={loading || busy}
+            onClick={() => setIsOpen(false)}
+          >
+            閉じる
+          </button>
+        </div>
+      ) : null}
+    </section>
+  );
+}
+
+// 所属解除と候補取得の入口を分け、現在の用途に必要な状態だけを持つ。
+export function ChildMembershipOperations(props: Props) {
+  return props.mode === "add" ? <AddOperations {...props} /> : <MembershipForm {...props} />;
+}
