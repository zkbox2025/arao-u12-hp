@@ -0,0 +1,134 @@
+// src/application/club/account/get-club-account.ts
+// 認可済みcontextと現在Auth本人を照合し、本人向け表示と追加候補を別々に取得する。
+
+import "server-only";
+
+import type {
+  ClubAccessContext,
+} from "@/app/(club-app)/club/club-membership-authorization";
+import {
+  findActiveClubMemberships,
+} from "@/app/(club-app)/club/find-active-club-memberships";
+import type {
+  ClubAccountChildCandidatesResult,
+  ClubAccountReadResult,
+} from "@/domain/club/account/account-types";
+import {
+  getAppEnabledMemberships,
+} from "@/domain/club/club-login-destination";
+import {
+  findAttachableChildrenForUser,
+  findClubAccountForUser,
+} from "@/src/infrastructure/prisma/repositories/club-account-repository";
+import {
+  createClient,
+} from "@/src/infrastructure/supabase/server";
+
+// Auth User全体を保持せず、表示に必要な本人IDと現在emailだけに絞る。
+async function getAccountAuth(context: ClubAccessContext) {
+  const supabase = await createClient();
+  const { data, error } = await supabase.auth.getUser();
+  if (
+    error ||
+    !data.user ||
+    !context.userId ||
+    data.user.id !== context.userId
+  ) {
+    return null;
+  }
+  return {
+    id: data.user.id,
+    email: data.user.email ?? null,
+  };
+}
+
+// 通常表示を取得し、Auth email・DB email・利用可能な所属数を別項目へ整理する。
+export async function getClubAccount(
+  context: ClubAccessContext,
+): Promise<ClubAccountReadResult> {
+  try {
+    const auth = await getAccountAuth(context);
+    if (!auth) {
+      return {
+        outcome: "UNAVAILABLE",
+      };
+    }
+    const [account, memberships] = await Promise.all([
+      findClubAccountForUser({
+        clubId: context.club.id,
+        actorMembershipId: context.membership.id,
+        userId: auth.id,
+      }),
+      findActiveClubMemberships(auth.id),
+    ]);
+    if (account.outcome !== "FOUND") {
+      return {
+        outcome: account.outcome,
+      };
+    }
+    const view = account.view;
+    return {
+      outcome: "FOUND",
+      view: {
+        name: view.name,
+        authEmail: auth.email,
+        appUserEmail: view.appUserEmail,
+        club: {
+          name: view.club.name,
+          slug: view.club.slug,
+          websiteUrl: view.club.websiteUrl,
+          instagramUrl: view.club.instagramUrl,
+        },
+        role: view.role,
+        children: view.children.map((child) => ({
+          id: child.id,
+          name: child.name,
+          grade: child.grade,
+        })),
+        canSwitchClub: getAppEnabledMemberships(memberships).length > 1,
+        isPlatformAdmin: view.isPlatformAdmin,
+      },
+    };
+  } catch {
+    // 例外原文・Auth User・部分取得した個人情報は結果やログへ渡さない。
+    return {
+      outcome: "FETCH_FAILED",
+    };
+  }
+}
+
+// 候補は明示的に必要になった時だけ取得し、通常表示や他クラブ詳細を混ぜない。
+export async function getAttachableClubChildren(
+  context: ClubAccessContext,
+): Promise<ClubAccountChildCandidatesResult> {
+  try {
+    const auth = await getAccountAuth(context);
+    if (!auth) {
+      return {
+        outcome: "UNAVAILABLE",
+      };
+    }
+    const result = await findAttachableChildrenForUser({
+      clubId: context.club.id,
+      actorMembershipId: context.membership.id,
+      userId: auth.id,
+    });
+    if (result.outcome !== "FOUND") {
+      return {
+        outcome: result.outcome,
+      };
+    }
+    return {
+      outcome: "FOUND",
+      children: result.children.map((child) => ({
+        id: child.id,
+        name: child.name,
+        grade: child.grade,
+      })),
+    };
+  } catch {
+    return {
+      outcome: "FETCH_FAILED",
+    };
+  }
+}
