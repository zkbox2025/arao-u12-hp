+  expect, // 同じPlaywrightの期待値検証API
+} from "./fixtures";
+
+const A_ROLES = [
+  ["aOwner", true, true],
+  ["aCoach", true, false],
+  ["aOfficer", true, false],
+  ["aMember", false, false],
+] as const; // 本人キー・管理権限・OWNER権限のリテラル型アサーション
