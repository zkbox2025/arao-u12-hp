+// domain/club/account/account-form.ts
+// 本人氏名だけの入力契約と、値を反射しない固定の完了メッセージを定義する。
+
+import type {
+  ActionState,
+  FieldErrors,
+} from "@/domain/shared/action-state";
+
+export const ACCOUNT_NAME_MAX_LENGTH = 100;
+
+export type AccountNameFormValues = {
+  name: string;
+};
+
+export type AccountNameFormField = keyof AccountNameFormValues;
+
+export type AccountNameActionState = ActionState<
+  AccountNameFormValues,
+  AccountNameFormField
+>;
+
+export type AccountNameValidationResult =
+  | {
+      success: true;
+      data: AccountNameFormValues;
+    }
+  | {
+      success: false;
+      fieldErrors: FieldErrors<AccountNameFormField>;
+    };
+
+// 氏名は前後空白だけを除去し、emailや所有者などの余分な項目は引き継がない。
+export function validateAccountNameInput(
+  input: unknown,
+): AccountNameValidationResult {
+  const rawName = typeof input === "object" &&
+    input !== null &&
+    !Array.isArray(input) &&
+    "name" in input
+    ? input.name
+    : undefined;
+  const name = typeof rawName === "string" ? rawName.trim() : "";
+
+  if (!name) {
+    return {
+      success: false,
+      fieldErrors: {
+        name: ["氏名を入力してください。"],
+      },
+    };
+  }
+
+  if (name.length > ACCOUNT_NAME_MAX_LENGTH) {
+    return {
+      success: false,
+      fieldErrors: {
+        name: [`氏名は${ACCOUNT_NAME_MAX_LENGTH}文字以内で入力してください。`],
+      },
+    };
+  }
+
+  return {
+    success: true,
+    data: {
+      name,
+    },
+  };
+}
+
+// File・重複項目・欠損を先勝ちや文字列変換で受理しない。
+export function parseAccountNameFormData(
+  formData: FormData,
+): AccountNameValidationResult {
+  const names = formData instanceof FormData ? formData.getAll("name") : [];
+
+  return validateAccountNameInput({
+    name: names.length === 1 ? names[0] : undefined,
+  });
+}
+
+// URL等の識別子から固定文言だけを返し、任意の文字列や配列は表示しない。
+export function getAccountFeedbackMessage(
+  value: unknown,
+): string | null {
+  switch (value) {
+    case "name-saved":
+      return "氏名を保存しました。";
+    case "child-created":
+      return "子どもを追加しました。";
+    case "child-updated":
+      return "子どもの情報を保存しました。";
+    case "child-added":
+      return "子どもを現在クラブへ追加しました。";
+    case "child-withdrawn":
+      return "子どもを現在クラブから外しました。";
+    case "saved-reload":
+      return "保存は完了しています。再送信せず、ページを開き直して確認してください。";
+    default:
+      return null;
+  }
+}
