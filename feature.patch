+// src/application/club/invitation/get-club-member-management.ts
+
+import "server-only";
+
+import {
+  expireClubInvitations,
+  findClubInvitationsForOwner,
+  type ClubInvitationFailure,
+  type ClubInvitationForOwner,
+} from "@/src/infrastructure/prisma/repositories/club-invitation-repository";
+import {
+  findClubMembershipsForOwner,
+  type ClubMembershipForOwner,
+} from "@/src/infrastructure/prisma/repositories/club-membership-repository";
+
+export type GetClubMemberManagementResult =
+  | ClubInvitationFailure
+  | {
+      outcome: "FOUND";
+      memberships: ClubMembershipForOwner[];
+      invitations: ClubInvitationForOwner[];
+    }
+  | {
+      outcome: "FETCH_FAILED";
+    };
+
+// 期限切れ更新の再認可後にDBの一覧を順に取得し、安全なDTOだけを返す。
+export async function getClubMemberManagement(
+  input: {
+    clubId: string;
+    actorMembershipId: string;
+  },
+): Promise<GetClubMemberManagementResult> {
+  const owner = {
+    clubId: input.clubId,
+    actorMembershipId: input.actorMembershipId,
+  };
+
+  try {
+    const expired = await expireClubInvitations(owner);
+
+    if (expired.outcome !== "EXPIRED") {
+      return expired;
+    }
+
+    const memberships = await findClubMembershipsForOwner({
+      clubId: owner.clubId,
+    });
+    const result = await findClubInvitationsForOwner(owner);
+
+    if (result.outcome !== "FOUND") {
+      // 取得中にOWNER資格を失った場合も部分的な一覧を返さない。
+      return result;
+    }
+
+    return {
+      outcome: "FOUND",
+      memberships,
+      invitations: result.invitations,
+    };
+  } catch {
+    return {
+      outcome: "FETCH_FAILED",
+    };
+  }
+}
