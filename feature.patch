+// src/application/club/invitation/get-club-invitation-acceptance.ts
+
+import "server-only";
+
+import type {
+  ClubInvitationAcceptanceView,
+} from "@/domain/club/invitation/acceptance-policy";
+import {
+  findClubInvitationAcceptanceForUser,
+} from "@/src/infrastructure/prisma/repositories/club-invitation-repository";
+import {
+  parseClubInvitationContext,
+} from "@/src/infrastructure/security/club-invitation-context";
+import {
+  getVerifiedClubInvitationSession,
+} from "@/src/infrastructure/supabase/club-invitation-session";
+
+export type GetClubInvitationAcceptanceResult =
+  | {
+      outcome: "AVAILABLE";
+      authenticationMethod: "password" | "otp";
+      view: Extract<ClubInvitationAcceptanceView, { status: "available" }>;
+    }
+  | {
+      outcome: "UNAVAILABLE";
+      view: Extract<ClubInvitationAcceptanceView, { status: "unavailable" }>;
+    }
+  | {
+      outcome: "AUTHENTICATION_REQUIRED" | "PASSWORD_LOGIN_REQUIRED";
+    }
+  | {
+      outcome: "ERROR";
+      view: Extract<ClubInvitationAcceptanceView, { status: "error" }>;
+    };
+
+// 未信頼のCookieと現在の本人を照合し、画面に必要なDTOだけを返す。
+export async function getClubInvitationAcceptance(input: {
+  context: unknown;
+}): Promise<GetClubInvitationAcceptanceResult> {
+  const context = parseClubInvitationContext(input.context);
+
+  if (!context) {
+    return {
+      outcome: "UNAVAILABLE",
+      view: {
+        status: "unavailable",
+        reason: "INVALID_INVITATION",
+      },
+    };
+  }
+
+  try {
+    const session = await getVerifiedClubInvitationSession();
+
+    if (!session) {
+      return {
+        outcome: "AUTHENTICATION_REQUIRED",
+      };
+    }
+
+    if (session.authenticationMethod === "unknown") {
+      return {
+        outcome: "PASSWORD_LOGIN_REQUIRED",
+      };
+    }
+
+    const result = await findClubInvitationAcceptanceForUser({
+      clubSlug: context.clubSlug,
+      tokenHash: context.tokenHash,
+      authenticatedUser: session.user,
+    });
+
+    if (context.expiresAt <= Date.now()) {
+      return {
+        outcome: "UNAVAILABLE",
+        view: {
+          status: "unavailable",
+          reason: "INVALID_INVITATION",
+        },
+      };
+    }
+
+    if (result.outcome === "UNAVAILABLE") {
+      return {
+        outcome: "UNAVAILABLE",
+        view: {
+          status: "unavailable",
+          reason: result.view.reason,
+        },
+      };
+    }
+
+    return {
+      outcome: "AVAILABLE",
+      authenticationMethod: session.authenticationMethod,
+      view: {
+        status: "available",
+        clubName: result.view.clubName,
+        clubSlug: result.view.clubSlug,
+        expiresAt: result.view.expiresAt,
+      },
+    };
+  } catch {
+    // DomainErrorの任意メッセージや外部例外も公開結果へ反射しない。
+    return {
+      outcome: "ERROR",
+      view: {
+        status: "error",
+        reason: "PROCESSING_FAILED",
+      },
+    };
+  }
+}
