+// 【追加：F06粒度3】承諾成功・状態による拒否・更新競合を区別する。
+export type ClubInvitationAcceptanceResult =
+  | {
+      outcome: "ACCEPTED";
+      clubSlug: string;
+    }
+  | {
+      outcome: "UNAVAILABLE";
