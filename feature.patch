+// src/infrastructure/prisma/repositories/club-event-exact-duplicate-repository.ts
+// 同一クラブ内で、コピー対象12項目とロール集合が完全一致する代表IDだけを読む。
+
+import "server-only";
+
+import type { Prisma } from "@prisma/client";
+
+import {
+  CLUB_MEMBER_ROLE_LABELS, // 全クラブ所属ロールに対応する表示ラベル
+} from "@/domain/club/club-member-role";
+import {
+  pickEventMonthCopyEvent, // コピーするイベント1件から必要なコピー列だけを検証・抽出する関数
+} from "@/domain/club/event/event-month-copy-policy";
+import type {
+  EventMonthCopyEvent, // コピーするイベント1件あたりの型
+} from "@/domain/club/event/event-month-copy-types";
+import type {
+  ClubMemberRole, // Prisma由来のクラブ所属ロール型
+} from "@/types/prisma";
+
+const ALL_ROLES = Object.keys(CLUB_MEMBER_ROLE_LABELS) as ClubMemberRole[]; // ロール名の取得関数 / 所属ロール配列型へのアサーション
+
+/**
+ * コピー対象列と過不足のないロール集合を、同一クラブの検索条件へ変換する。
+ */
+function duplicateWhere( // 完全一致検索条件を組み立てる関数
+  clubId: string, // 認可対象クラブIDの文字列型
+  event: EventMonthCopyEvent, // コピー対象12項目を持つイベント型
+): Prisma.ClubEventWhereInput { // Prismaのイベント検索条件型
+  const { targetRoles, ...columns } = pickEventMonthCopyEvent(event); // コピー列を検証・抽出する関数
+  const roles = [...new Set(targetRoles)]; // ロールの重複を除く集合の生成
+  if (roles.length === 0) {
+    return {
+      clubId,
+      ...columns,
+      targetRoles: {
+        isEmpty: true,
+      },
+    };
+  }
+  const excludedRoles = ALL_ROLES.filter( // 候補にないロールだけを残すメソッド
+    /**
+     * 候補のロール集合に含まれないロールか判定する。
+     */
+    (role) => !roles.includes(role), // ロールを判定するコールバック / 包含判定メソッド
+  );
+  return {
+    clubId,
+    ...columns,
+    targetRoles: {
+      hasEvery: roles,
+    },
+    NOT: {
+      targetRoles: {
+        hasSome: excludedRoles,
+      },
+    },
+  };
+}
+
+/**
+ * 渡されたClientで完全一致する代表イベントのIDだけを取得する。公開状態は問わない。
+ * 認可は呼出し元が確認し、DB・検証エラーは呼出し元へ伝播する。
+ */
+export async function findClubEventExactDuplicateId( // 既存一致IDを取得する関数
+  clubId: string, // 認可対象クラブIDの文字列型
+  event: EventMonthCopyEvent, // 比較するコピー対象イベント型
+  database: Prisma.TransactionClient, // 呼出し元と同一の通常Clientまたはtransaction client型
+): Promise<string | null> { // 代表IDの文字列または未一致を返す非同期型
+  const duplicate = await database.clubEvent.findFirst({ // 一致行を最大1件だけ読むメソッド
+    where: duplicateWhere(clubId, event), // コピー列とロール集合の完全一致条件を組み立てる関数
+    select: {
+      id: true,
+    },
+    orderBy: {
+      id: "asc",
+    },
+  });
+  return duplicate?.id ?? null;
+}
