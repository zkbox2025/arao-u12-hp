+// 【追加：F06粒度6】明確な拒否だけを識別し、通信障害や未知の結果は断定しない。
+function passwordUpdateRejection(error: unknown): ClubInvitationPasswordUpdateResult {
+  if (
+    (isAuthApiError(error) || isAuthWeakPasswordError(error)) &&
+    error.status !== undefined &&
+    error.status >= 400 &&
+    error.status < 500
+  ) {
+    if (error.code === "weak_password" || error.code === "same_password") {
+      return {
+        outcome: "REJECTED",
+        reason: "PASSWORD_REJECTED",
+      };
+    }
+
+    if (
+      error.code === "reauthentication_needed" ||
+      error.code === "reauthentication_not_valid" ||
+      error.code === "reauth_nonce_missing" ||
+      error.code === "session_not_found" ||
+      error.code === "session_expired"
+    ) {
+      return {
+        outcome: "REJECTED",
+        reason: "REAUTHENTICATION_REQUIRED",
+      };
+    }
+  }
+
+  return {
+    outcome: "UNKNOWN",
+  };
+}
