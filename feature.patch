+    if (error) {
+      return passwordUpdateRejection(error);
+    }
+
+    if (
+      !data.user ||
+      data.user.id !== current.user.id ||
+      normalizeEmail(data.user.email ?? "") !== current.user.email
+    ) {
+      return {
+        outcome: "UNKNOWN",
+      };
+    }
+
+    // Authの応答で更新を確認する。RSC用Cookie書込のcatchは成功の根拠にしない。
+    return {
+      outcome: "UPDATED",
+      user: {
+        id: current.user.id,
+        email: current.user.email,
+      },
+    };
+  } catch {
+    return {
+      outcome: updateStarted ? "UNKNOWN" : "AUTHENTICATION_REQUIRED",
+    };
+  }
+}
