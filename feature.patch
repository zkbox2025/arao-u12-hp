diff --git a/src/infrastructure/prisma/repositories/event-month-copy-read-repository.ts b/src/infrastructure/prisma/repositories/event-month-copy-read-repository.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8df57356f369241c2c66bcc6e135b40873e72842
