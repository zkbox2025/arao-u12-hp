+// domain/club/member/member-toast.test.ts
+
+import {
+  describe,
+  expect,
+  it,
+} from "vitest";
+
+import {
+  getClubMembersToastMessage,
+} from "./member-toast";
+
+describe(
+  "getClubMembersToastMessage",
+  () => {
+    it(
+      "許可した識別子を固定メッセージへ変換する",
+      () => {
