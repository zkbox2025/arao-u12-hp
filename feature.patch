+/**
+ * 実Resend要求を架空の応答へ変換し、明示したローカルAuth以外へ通信しない。
+ */
+async function networkFetch( // 接続先を制限するHTTP関数
+  input: Parameters<typeof fetch>[0], // HTTP要求の引数型 / 値から型を取得する型 / HTTP関数型
+  init?: Parameters<typeof fetch>[1], // HTTP設定の引数型 / 値から型を取得する型 / HTTP関数型
+): Promise<Response> { // 非同期のHTTP応答型
+  const url = new URL(input instanceof Request ? input.url : String(input)); // URL解析コンストラクター / HTTP要求の組込み型 / 文字列化関数
+  if (
+    url.href === ENDPOINT &&
+    bridge.sdkAllowed &&
+    init?.method === "POST"
+  ) {
+    const payload = JSON.parse(String(init.body)) as Record<string, unknown>; // JSON解析関数 / 文字列化関数 / payload辞書型 / 文字列キー型 / 未確定値型
+    bridge.mails.push({ // 外部送信せず要求を記録するメソッド
+      headers: new Headers(init.headers), // HTTP headerのコンストラクター
+      payload,
+    });
+    try {
+      await bridge.mailHook?.(); // 受付直前の非同期DB検証関数
+    } catch {
+      bridge.hookFailed = true;
+      throw new Error("F12_MAIL_PRECHECK_FAILED"); // SDKが例外を正規化しても後処理で検出する固定例外コンストラクター
+    }
+    if (bridge.mode === "network") {
+      throw new Error(PRIVATE); // 架空の通信例外コンストラクター
+    }
+    if (bridge.mode === "timeout") {
+      throw new DOMException(PRIVATE, "TimeoutError"); // 架空のtimeout例外コンストラクター
+    }
+    const rejected = bridge.mode === "rejected" ||
+      bridge.mode === "malformed";
+    const status = bridge.mode === "accepted"
+      ? 200
+      : rejected
+        ? 422
+        : bridge.mode === "http-timeout"
+          ? 408
+          : bridge.mode === "conflict"
+            ? 409
+            : 503;
+    const errorName = bridge.mode === "rejected"
+      ? "validation_error"
+      : bridge.mode === "conflict"
+        ? "invalid_idempotency_key"
+        : "internal_server_error";
+    const body = bridge.mode === "accepted"
+      ? JSON.stringify({ id: "f12-email-accepted" }) // 架空の受付IDをJSON化する関数
+      : bridge.mode === "malformed"
+        ? PRIVATE
+        : JSON.stringify({ // SDKが読む架空のエラーをJSON化する関数
+            name: errorName,
+            statusCode: status,
+            message: `${PRIVATE} private@example.test https://private.invalid/?token=${PRIVATE} Cookie=${PRIVATE}`,
+          });
+    return new Response(body, { // 架空のHTTP応答コンストラクター
+      status,
+      headers: {
+        "content-type": "application/json",
+        "set-cookie": `${PRIVATE}=fake`,
+      },
+    });
+  }
+  if (
+    bridge.allowed &&
+    url.origin === bridge.origin &&
+    url.pathname.startsWith("/auth/v1/admin/") && // Auth管理APIのpathだけを許可するメソッド
+    !url.username &&
+    !url.password &&
+    !url.hash
+  ) {
+    return nativeFetch(input, { // 指定したローカルAuthへだけ転送するHTTP関数
+      ...init,
+      redirect: "error",
+    });
+  }
+  bridge.external(); // 禁止したHTTP要求を記録するmock関数
+  throw new Error("F12_HTTP_NOT_ALLOWED"); // URLを含まない固定例外コンストラクター
+}
