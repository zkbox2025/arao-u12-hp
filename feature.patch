diff --git a/src/application/club/line/handle-club-line-webhook.ts b/src/application/club/line/handle-club-line-webhook.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5ab5b9efc5537e2beadd085a3ae48b5de2d2cc45
--- /dev/null
+++ b/src/application/club/line/handle-club-line-webhook.ts
@@ -0,0 +1,319 @@
+// src/application/club/line/handle-club-line-webhook.ts
+// クラブ別LINE Webhookの検証と通知先登録を統括するApplication Service
+
+import "server-only";
+
+import {
+  parseClubLineRegistrationCode,
+} from "@/domain/club/line/line-registration-code";
+
+import {
+  LINE_WEBHOOK_MAX_BODY_BYTES,
+  parseLineWebhookPayload,
+  verifyLineWebhookSignature,
+} from "@/src/infrastructure/line/line-webhook";
+
+import {
+  consumeClubLineRegistrationTokenAndUpsertTarget,
+  findClubLineSettingForWebhook,
+} from "@/src/infrastructure/prisma/repositories/club-line-setting-repository";
+
+import {
+  decryptLineCredential,
+} from "@/src/infrastructure/security/line-credential-crypto";
+
+import {
+  hashToken,
+} from "@/src/infrastructure/security/token";
+
+export type HandleClubLineWebhookResult =
+  | {
+      status: 200;
+      outcome:
+        | "VERIFICATION_SUCCEEDED"
+        | "PROCESSED"
+        | "REGISTRATION_SUCCEEDED";
+    }
+  | {
+      status: 400;
+      outcome: "INVALID_REQUEST";
+    }
+  | {
+      status: 401;
+      outcome: "UNAUTHORIZED";
+    }
+  | {
+      status: 403;
+      outcome: "FORBIDDEN";
+    }
+  | {
+      status: 404;
+      outcome: "NOT_FOUND";
+    }
+  | {
+      status: 413;
+      outcome: "PAYLOAD_TOO_LARGE";
+    }
+  | {
+      status: 503;
+      outcome: "SERVICE_UNAVAILABLE";
+    };
+
+type HandleClubLineWebhookInput = {
+  webhookKey: string;
+  signature: string | null;
+  rawBody: string;
+  now?: Date;
+};
+
+function hasConfiguredValue(
+  value: string | null,
+): value is string {
+  return (
+    typeof value === "string" &&
+    value.trim().length > 0
+  );
+}
+
+function isPayloadTooLarge(
+  rawBody: string,
+): boolean {
+  return (
+    Buffer.byteLength(
+      rawBody,
+      "utf8",
+    ) >
+    LINE_WEBHOOK_MAX_BODY_BYTES
+  );
+}
+
+/**
+ * webhookKeyでクラブ設定を確定してから署名を検証し、
+ * 完全一致した登録コードだけを一度限りで消費する。
+ *
+ * この関数は秘密値を結果や例外へ含めず、ログも出さない。
+ * HTTPレスポンスと安全なログへの変換はRoute Handlerが担当する。
+ */
+export async function handleClubLineWebhook(
+  input: HandleClubLineWebhookInput,
+): Promise<HandleClubLineWebhookResult> {
+  let setting:
+    Awaited<
+      ReturnType<
+        typeof findClubLineSettingForWebhook
+      >
+    >;
+
+  try {
+    setting =
+      await findClubLineSettingForWebhook({
+        webhookKey:
+          input.webhookKey,
+      });
+  } catch {
+    return {
+      status: 503,
+      outcome:
+        "SERVICE_UNAVAILABLE",
+    };
+  }
+
+  if (!setting) {
+    return {
+      status: 404,
+      outcome: "NOT_FOUND",
+    };
+  }
+
+  if (!input.signature) {
+    return {
+      status: 401,
+      outcome:
+        "UNAUTHORIZED",
+    };
+  }
+
+  if (
+    isPayloadTooLarge(
+      input.rawBody,
+    )
+  ) {
+    return {
+      status: 413,
+      outcome:
+        "PAYLOAD_TOO_LARGE",
+    };
+  }
+
+  if (
+    !hasConfiguredValue(
+      setting.lineBotUserId,
+    ) ||
+    !hasConfiguredValue(
+      setting
+        .lineChannelSecretEncrypted,
+    )
+  ) {
+    return {
+      status: 503,
+      outcome:
+        "SERVICE_UNAVAILABLE",
+    };
+  }
+
+  let channelSecret: string;
+
+  try {
+    channelSecret =
+      decryptLineCredential({
+        encryptedValue:
+          setting
+            .lineChannelSecretEncrypted,
+        clubId:
+          setting.clubId,
+        credentialType:
+          "CHANNEL_SECRET",
+      });
+  } catch {
+    return {
+      status: 503,
+      outcome:
+        "SERVICE_UNAVAILABLE",
+    };
+  }
+
+  if (!channelSecret) {
+    return {
+      status: 503,
+      outcome:
+        "SERVICE_UNAVAILABLE",
+    };
+  }
+
+  const isValidSignature =
+    verifyLineWebhookSignature({
+      rawBody:
+        input.rawBody,
+      signature:
+        input.signature,
+      channelSecret,
+    });
+
+  if (!isValidSignature) {
+    return {
+      status: 401,
+      outcome:
+        "UNAUTHORIZED",
+    };
+  }
+
+  const parsed =
+    parseLineWebhookPayload(
+      input.rawBody,
+    );
+
+  if (!parsed.success) {
+    if (
+      parsed.error ===
+      "PAYLOAD_TOO_LARGE"
+    ) {
+      return {
+        status: 413,
+        outcome:
+          "PAYLOAD_TOO_LARGE",
+      };
+    }
+
+    return {
+      status: 400,
+      outcome:
+        "INVALID_REQUEST",
+    };
+  }
+
+  if (
+    parsed.data.destination !==
+    setting.lineBotUserId
+  ) {
+    return {
+      status: 403,
+      outcome: "FORBIDDEN",
+    };
+  }
+
+  if (
+    parsed.data.eventCount === 0
+  ) {
+    return {
+      status: 200,
+      outcome:
+        "VERIFICATION_SUCCEEDED",
+    };
+  }
+
+  const now =
+    input.now ?? new Date();
+
+  let registrationSucceeded =
+    false;
+
+  for (
+    const message of
+    parsed.data.groupTextMessages
+  ) {
+    const registrationCode =
+      parseClubLineRegistrationCode(
+        message.text,
+      );
+
+    if (!registrationCode) {
+      continue;
+    }
+
+    try {
+      const target =
+        await consumeClubLineRegistrationTokenAndUpsertTarget(
+          {
+            clubId:
+              setting.clubId,
+            lineSettingId:
+              setting.id,
+            tokenHash:
+              hashToken(
+                registrationCode,
+              ),
+            lineGroupId:
+              message.groupId,
+            now,
+          },
+        );
+
+      if (target) {
+        registrationSucceeded =
+          true;
+      }
+    } catch {
+      /*
+       * 一時的なDB障害では503を返し、
+       * LINE側の再送で回復できるようにする。
+       * token消費は条件付きtransactionなので再送しても冪等。
+       */
+      return {
+        status: 503,
+        outcome:
+          "SERVICE_UNAVAILABLE",
+      };
+    }
+  }
+
+  return registrationSucceeded
+    ? {
+        status: 200,
+        outcome:
+          "REGISTRATION_SUCCEEDED",
+      }
+    : {
+        status: 200,
+        outcome: "PROCESSED",
+      };
+}
