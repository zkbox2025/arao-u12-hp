+      });
+      expect(repository).toHaveBeenCalledTimes(1); // モック関数参照 / 再試行なしの検証メソッド
+      expect(vi.mocked(console.error).mock.calls[0]).toEqual([ // モック取得・期待値生成・固定ログの比較メソッド
+        "platform_support_operation_failed",
+        {
+          requestId: REQUEST_ID,
