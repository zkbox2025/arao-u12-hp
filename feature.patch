+// src/application/club/invitation/cancel-club-invitation.ts
+
+import "server-only";
+
+import {
+  cancelClubInvitation,
+  type ClubInvitationFailure,
+} from "@/src/infrastructure/prisma/repositories/club-invitation-repository";
+
+export type CancelClubMemberInvitationResult =
+  | ClubInvitationFailure
+  | {
+      outcome: "CANCELLED";
+    }
+  | {
+      outcome: "CANCELLATION_FAILED";
+    };
+
+// サーバーで認可したクラブ・操作者を渡し、Repositoryで再認可して取消する。
+export async function cancelClubMemberInvitation(
+  input: {
+    clubId: string;
+    actorMembershipId: string;
+    invitationId: string;
+  },
+): Promise<CancelClubMemberInvitationResult> {
+  try {
+    return await cancelClubInvitation({
+      clubId: input.clubId,
+      actorMembershipId: input.actorMembershipId,
+      invitationId: input.invitationId,
+    });
+  } catch {
+    // DB原文や個人情報を結果・ログへ残さない。
+    return {
+      outcome: "CANCELLATION_FAILED",
+    };
+  }
+}
