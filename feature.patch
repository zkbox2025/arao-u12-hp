+// domain/club/invitation/acceptance-policy.ts
+// 招待受取人の照合・理由別判定と、秘密を含まない表示用DTO。
+
+import { normalizeEmail } from "@/domain/shared/email";
+import type {
+  ClubInvitation,
+  ClubMembership,
+} from "@/types/prisma";
+
+import {
+  isUsableClubInvitation,
+} from "./invitation-policy";
+
+export type ClubInvitationAcceptanceInvitation = Pick<
+  ClubInvitation,
+  | "clubId"
+  | "tokenHash"
+  | "authUserId"
+  | "email"
+  | "membershipId"
+  | "status"
+  | "acceptedAt"
+  | "expiresAt"
+>;
+
+export type ClubInvitationAcceptanceMembership = Pick<
+  ClubMembership,
+  | "id"
+  | "clubId"
+  | "userId"
+  | "status"
+>;
+
+// Authで検証した現在の本人情報を受け取る。クライアントの自己申告は渡さない。
+export type ClubInvitationAcceptanceUser = {
+  id: string;
+  email: string | null;
+};
+
+export type ClubInvitationAcceptanceViolation =
+  | "INVALID_INVITATION"
+  | "RECIPIENT_MISMATCH"
+  | "INVITATION_EMAIL_MISMATCH"
+  | "INVITATION_ALREADY_ACCEPTED"
+  | "INVITATION_CANCELLED"
+  | "INVITATION_EXPIRED"
+  | "MEMBERSHIP_MISMATCH"
+  | "INVALID_INVITATION_STATE";
+
+export type ClubInvitationAcceptanceEvaluation =
+  | {
+      allowed: true;
+    }
+  | {
+      allowed: false;
+      violation: ClubInvitationAcceptanceViolation;
+    };
+
+// 利用可能時のexpiresAtはISO文字列に変換して表示層へ渡す。
+// DB内部ID・hash・本人emailを含めず、外部処理の失敗も区別する。
+export type ClubInvitationAcceptanceView =
+  | {
+      status: "available";
+      clubName: string;
+      clubSlug: string;
+      expiresAt: string;
+    }
+  | {
+      status: "unavailable";
+      reason: ClubInvitationAcceptanceViolation;
+    }
+  | {
+      status: "error";
+      reason: "PROCESSING_FAILED";
+    };
+
+export type ClubInvitationAcceptanceInput = {
+  invitation: ClubInvitationAcceptanceInvitation | null;
+  membership: ClubInvitationAcceptanceMembership | null;
+  authenticatedUser: ClubInvitationAcceptanceUser | null;
+  clubId: string;
+  tokenHash: string;
+  now: Date;
+};
+
+// 秘密の値やDB情報を付けずに拒否理由だけを返す。
+function reject(
+  violation: ClubInvitationAcceptanceViolation,
+): ClubInvitationAcceptanceEvaluation {
+  return {
+    allowed: false,
+    violation,
+  };
+}
+
+// 本人照合より前に終端状態を開示せず、所属削除後の取消理由も判定する。
+// session検証・hash生成・DBの最新状態取得と書込時の再検査は呼び出し側の責務。
+export function evaluateClubInvitationAcceptance({
+  invitation,
+  membership,
+  authenticatedUser,
+  clubId,
+  tokenHash,
+  now,
+}: ClubInvitationAcceptanceInput): ClubInvitationAcceptanceEvaluation {
+  if (
+    !invitation ||
+    !clubId ||
+    !tokenHash ||
+    invitation.clubId !== clubId ||
+    invitation.tokenHash !== tokenHash
+  ) {
+    return reject("INVALID_INVITATION");
+  }
+
+  if (
+    !authenticatedUser?.id ||
+    !invitation.authUserId ||
+    invitation.authUserId !== authenticatedUser.id
+  ) {
+    return reject("RECIPIENT_MISMATCH");
+  }
+
+  const email = normalizeEmail(authenticatedUser.email ?? "");
+  const invitationEmail = normalizeEmail(invitation.email);
+
+  if (
+    !email ||
+    !invitationEmail ||
+    email !== invitationEmail
+  ) {
+    return reject("INVITATION_EMAIL_MISMATCH");
+  }
+
+  if (
+    invitation.acceptedAt !== null ||
+    invitation.status === "ACCEPTED"
+  ) {
+    return reject("INVITATION_ALREADY_ACCEPTED");
+  }
+
+  if (invitation.status === "CANCELLED") {
+    return reject("INVITATION_CANCELLED");
+  }
+
+  if (
+    !Number.isFinite(now.getTime()) ||
+    !Number.isFinite(invitation.expiresAt.getTime())
+  ) {
+    return reject("INVALID_INVITATION_STATE");
+  }
+
+  if (
+    invitation.status === "EXPIRED" ||
+    invitation.expiresAt.getTime() <= now.getTime()
+  ) {
+    return reject("INVITATION_EXPIRED");
+  }
+
+  if (
+    !membership ||
+    !invitation.membershipId ||
+    membership.id !== invitation.membershipId ||
+    membership.clubId !== clubId ||
+    membership.userId !== authenticatedUser.id
+  ) {
+    return reject("MEMBERSHIP_MISMATCH");
+  }
+
+  if (
+    !isUsableClubInvitation({
+      invitation,
+      membership,
+      now,
+    })
+  ) {
+    return reject(
+      membership.status === "INVITED"
+        ? "INVALID_INVITATION_STATE"
+        : "MEMBERSHIP_MISMATCH",
+    );
+  }
+
+  return {
+    allowed: true,
+  };
+}
