index 0000000000000000000000000000000000000000..bee157ce71b01fc99714ddebac9f3e1074aa88f4
--- /dev/null
+++ b/domain/club/event/event-practice-batch-date-times.ts
@@ -0,0 +1,251 @@
+// domain/club/event/event-practice-batch-date-times.ts
+// 同月の現地カレンダー日を走査し、曜日に合う練習日時をDBなしで生成する。
+
+import {
+  isValidTimeZone, // タイムゾーンが正しく利用できるかを検証する関数
+  utcCandidates, // 指定した現地成分と一致するUTC候補を列挙する関数
+  type LocalDateTime, // クラブ現地の年・月・日・時・分・秒・ミリ秒の型
+} from "@/domain/shared/date-time/club-local-date-time";
+import type {
+  EventUtcDateTimes, // 開始・終了・集合のUTC日時をまとめる型
+} from "./event-date-times";
+import {
+  validateEventPracticeBatchPreviewInput, // プレビュー準備段階の入力値だけを検証・正規化する関数
+} from "./event-practice-batch-form";
+import {
+  EVENT_PRACTICE_BATCH_MAX_COUNT, // 定期練習作成の最大件数31件
+  type EventPracticeBatchCommonInput, // 検証・正規化した定期練習の共通入力値の型
+  type EventPracticeBatchExclusionReason, // 練習イベントを作成できない日時の理由の型
+  type EventPracticeBatchWarning, // 集合時刻が練習開始時刻より後であることを表す警告型
+} from "./event-practice-batch-types";
+
+/**
+ * 終了必須の練習予定が持つUTC日時。DB保存や既存イベントとの一致判定は含めない。
+ */
+export type EventPracticeBatchUtcDateTimes = EventUtcDateTimes & { // 終了必須のUTC日時型 / 開始・終了・集合のUTC日時の型
+  endAt: Date; // 日時型
+};
+
+/**
+ * 現地日を識別子とする生成候補。変換できない日も理由付きで保持し、部分日時は返さない。
+ */
+export type EventPracticeBatchDateTimeCandidate = // 日付と生成日時・除外理由を持つ候補型
+  | {
+      date: string; // 文字列型
+      dates: EventPracticeBatchUtcDateTimes; // 終了必須のUTC日時型
+      exclusionReason: null; // 未設定を表すnull型
+      warnings: readonly EventPracticeBatchWarning[]; // 開始後の集合時刻の警告型
+    }
+  | {
+      date: string; // 文字列型
+      dates: null; // 未設定を表すnull型
+      exclusionReason: EventPracticeBatchExclusionReason; // 日時を作成できない理由の型
+      warnings: readonly EventPracticeBatchWarning[]; // 開始後の集合時刻の警告型
+    };
+
+/**
+ * 空候補・全件除外は件数で区別し、入力不正・timezone不正・上限・予期しない失敗を分ける。
+ */
+export type EventPracticeBatchDateTimeResult = // 候補生成の成功・失敗結果型
+  | {
+      outcome: "READY"; // 値を限定するリテラル型
+      items: readonly EventPracticeBatchDateTimeCandidate[]; // 日付と生成日時・除外理由を持つ候補型
+      candidateCount: number; // 数値型
+      selectableCount: number; // 数値型
+    }
+  | {
+      outcome: "INVALID_INPUT" | "INVALID_TIMEZONE" | "TOO_MANY" | "GENERATION_FAILED"; // 値を限定するリテラル型
+    };
+
+/**
+ * 単一時刻の厳密な解決結果。候補が複数あっても勝手に採用しない。
+ */
+type ResolvedTime = // 単一時刻の解決結果型
+  | {
+      success: true; // 値を限定するリテラル型
+      value: Date; // 日時型
+    }
+  | {
+      success: false; // 値を限定するリテラル型
+      reason: EventPracticeBatchExclusionReason; // 日時を作成できない理由の型
+    };
+
+/**
+ * 検証済みの現地日を曜日計算用のUTCカレンダーへ置く。実際のUTC保存日時ではない。
+ */
+function calendarDate(value: string): Date { // 検証済み日付を曜日計算用のカレンダーへ置く関数 / 文字列型 / 日時型
+  const result = new Date(0); // 日時を生成するコンストラクター
+  result.setUTCFullYear( // 年0〜99の特例なしでUTC年月日を設定するメソッド
+    Number(value.slice(0, 4)), // 値を数値へ変換する関数 / 文字列の指定範囲を得るメソッド
+    Number(value.slice(5, 7)) - 1, // 値を数値へ変換する関数 / 文字列の指定範囲を得るメソッド
+    Number(value.slice(8, 10)), // 値を数値へ変換する関数 / 文字列の指定範囲を得るメソッド
+  );
+  result.setUTCHours(0, 0, 0, 0); // UTCの時分秒ミリ秒を設定するメソッド
+  return result;
+}
+
+/**
+ * カレンダー成分とHH:mmを厳密なUTC候補へ変換し、不存在・曖昧・変換不能を分ける。
+ */
+function resolveTime( // 現地時刻を厳密にUTCへ解決する関数
+  calendar: Date, // 日時型
+  time: string, // 文字列型
+  timeZone: string, // 文字列型
+): ResolvedTime { // 単一時刻の解決結果型
+  try {
+    const parts: LocalDateTime = { // クラブ現地の日時成分の型
+      year: calendar.getUTCFullYear(), // UTCカレンダーの年を得るメソッド
+      month: calendar.getUTCMonth() + 1, // UTCカレンダーの0始まり月を得るメソッド
+      day: calendar.getUTCDate(), // UTCカレンダーの日を得るメソッド
+      hour: Number(time.slice(0, 2)), // 値を数値へ変換する関数 / 文字列の指定範囲を得るメソッド
+      minute: Number(time.slice(3, 5)), // 値を数値へ変換する関数 / 文字列の指定範囲を得るメソッド
+      second: 0,
+      millisecond: 0,
+    };
+    const candidates = utcCandidates(parts, timeZone); // 現地成分と一致するUTC候補を列挙する関数
+    if (candidates.length === 0) {
+      return {
+        success: false,
+        reason: "NONEXISTENT_LOCAL_TIME",
+      };
+    }
+    if (candidates.length > 1) {
+      return {
+        success: false,
+        reason: "AMBIGUOUS_LOCAL_TIME",
+      };
+    }
+    if (!Number.isFinite(candidates[0].getTime())) { // 有限の数値かを確認する関数 / UTCミリ秒値を得るメソッド
+      return {
+        success: false,
+        reason: "INVALID_DATE_TIME",
+      };
+    }
+    return {
+      success: true,
+      value: candidates[0],
+    };
+  } catch {
+    return {
+      success: false,
+      reason: "INVALID_DATE_TIME",
+    };
+  }
+}
+
+/**
+ * 変換途中のUTC値を公開せず、日付と固定の除外理由だけを持つ候補を作る。
+ */
+function excluded( // 固定理由の除外候補を作る関数
+  date: string, // 文字列型
+  reason: EventPracticeBatchExclusionReason, // 日時を作成できない理由の型
+): EventPracticeBatchDateTimeCandidate { // 日付と生成日時・除外理由を持つ候補型
+  return {
+    date,
+    dates: null,
+    exclusionReason: reason,
+    warnings: [],
+  };
+}
+
+/**
+ * 1日の開始・終了・任意集合を生成し、UTCでの終了順序と集合警告を確認する。
+ */
+function generateDay( // 1日分の開始・終了・任意集合を生成する関数
+  calendar: Date, // 日時型
+  input: EventPracticeBatchCommonInput, // 正規化した共通入力型
+  timeZone: string, // 文字列型
+): EventPracticeBatchDateTimeCandidate { // 日付と生成日時・除外理由を持つ候補型
+  const date = calendar.toISOString().slice(0, 10); // 文字列の指定範囲を得るメソッド / UTC ISO文字列へ変換するメソッド
+  const start = resolveTime(calendar, input.startTime, timeZone); // 現地時刻を厳密にUTCへ解決する関数
+  if (!start.success) {
+    return excluded(date, start.reason); // 固定理由の除外候補を作る関数
+  }
+  const end = resolveTime(calendar, input.endTime, timeZone); // 現地時刻を厳密にUTCへ解決する関数
+  if (!end.success) {
+    return excluded(date, end.reason); // 固定理由の除外候補を作る関数
+  }
+  if (end.value.getTime() <= start.value.getTime()) { // UTCミリ秒値を得るメソッド
+    return excluded(date, "INVALID_INTERVAL"); // 固定理由の除外候補を作る関数
+  }
+  let meetingAt: Date | null = null; // 日時型 / 未設定を表すnull型
+  if (input.meetingTime !== null) {
+    const meeting = resolveTime(calendar, input.meetingTime, timeZone); // 現地時刻を厳密にUTCへ解決する関数
+    if (!meeting.success) {
+      return excluded(date, meeting.reason); // 固定理由の除外候補を作る関数
+    }
+    meetingAt = meeting.value;
+  }
+  const warnings: EventPracticeBatchWarning[] = []; // 開始後の集合時刻の警告型
+  if (
+    meetingAt !== null &&
+    meetingAt.getTime() > start.value.getTime() // UTCミリ秒値を得るメソッド
+  ) {
+    warnings.push("MEETING_AFTER_START"); // 配列へ要素を加えるメソッド
+  }
+  return {
+    date,
+    dates: {
+      startAt: start.value,
+      endAt: end.value,
+      meetingAt,
+    },
+    exclusionReason: null,
+    warnings,
+  };
+}
+
+/**
+ * 正規化共通入力とクラブtimezoneから、最大31現地日の曜日候補を日付昇順で生成する。
+ * 不正入力は拒否し、既存一致・初期選択・hash・認証認可・保存は後続へ委ねる。
+ */
+export function generateEventPracticeBatchDateTimes( // 現地曜日候補とUTC日時を生成する関数
+  input: EventPracticeBatchCommonInput, // 正規化した共通入力型
+  timeZone: string, // 文字列型
+): EventPracticeBatchDateTimeResult { // 候補生成の成功・失敗結果型
+  try {
+    const validated = validateEventPracticeBatchPreviewInput(input); // 共通入力を検証・正規化する関数
+    if (!validated.success) {
+      return { outcome: "INVALID_INPUT" };
+    }
+    if (!isValidTimeZone(timeZone)) { // 利用可能なtimezoneを検証する関数
+      return { outcome: "INVALID_TIMEZONE" };
+    }
+    const values = validated.data;
+    const first = calendarDate(values.periodStart); // 検証済み日付を曜日計算用のカレンダーへ置く関数
+    const last = calendarDate(values.periodEnd); // 検証済み日付を曜日計算用のカレンダーへ置く関数
+    // これはUTC上に置いた現地カレンダーの差。現地1日の長さを24時間と仮定しない。
+    const dayCount = (last.getTime() - first.getTime()) / 86400000 + 1; // UTCミリ秒値を得るメソッド
+    if (dayCount > EVENT_PRACTICE_BATCH_MAX_COUNT) {
+      return { outcome: "TOO_MANY" };
+    }
+    const items: EventPracticeBatchDateTimeCandidate[] = []; // 日付と生成日時・除外理由を持つ候補型
+    let selectableCount = 0;
+    for (let offset = 0; offset < dayCount; offset += 1) {
+      const calendar = new Date(first.getTime()); // 日時を生成するコンストラクター / UTCミリ秒値を得るメソッド
+      calendar.setUTCDate(first.getUTCDate() + offset); // UTCカレンダーの日付を設定するメソッド / UTCカレンダーの日を得るメソッド
+      // 曜日は現地カレンダー成分から求め、ホストtimezoneや保存用UTC日付で判定しない。
+      if (!values.weekdays.some( // 条件に合う要素の有無を調べるメソッド
+        /**
+         * 検証済みの選択曜日と、現在の現地カレンダー曜日を照合する。
+         */
+        (weekday) => weekday === calendar.getUTCDay(), // 検証・変換に使うコールバック / UTCカレンダーの曜日番号を得るメソッド
+      )) {
+        continue;
+      }
+      const item = generateDay(calendar, values, timeZone); // 1日分の開始・終了・任意集合を生成する関数
+      items.push(item); // 配列へ要素を加えるメソッド
+      if (item.dates !== null) {
+        selectableCount += 1;
+      }
+    }
+    return {
+      outcome: "READY",
+      items,
+      candidateCount: items.length,
+      selectableCount,
+    };
+  } catch {
+    return { outcome: "GENERATION_FAILED" };
+  }
+}
diff --git a/tests/event-practice-batch-date-times.test.ts b/tests/event-practice-batch-date-times.test.ts
