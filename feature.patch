+  await page.getByLabel("開始時刻（必須）", { exact: true }).fill(options.startTime ?? "00:00"); // 現地開始時刻を選ぶ・入力するメソッド
+  await page.getByLabel("終了時刻（必須・同日）", { exact: true }).fill(options.endTime ?? "01:00"); // 現地終了時刻を選ぶ・入力するメソッド
+  if (options.meeting) {
