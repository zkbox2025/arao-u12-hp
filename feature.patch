+++ b/domain/club/account/child-membership-policy.ts
@@ -0,0 +1,99 @@
+// domain/club/account/child-membership-policy.ts
+// 本人・現在クラブとの対応を確認した後に使う、子どもの所属状態だけの純粋な判定。
+
+import type {
+  ClubMembershipStatus,
+} from "@/types/prisma";
+
+export type ChildMembershipViolation =
+  | "ALREADY_ACTIVE"
+  | "ALREADY_WITHDRAWN"
+  | "MEMBERSHIP_NOT_FOUND"
+  | "STATUS_CHANGE_NOT_ALLOWED"
+  | "INVALID_STATUS";
+
+export type ChildMembershipAdditionEvaluation =
+  | {
+      allowed: true;
+      operation: "CREATE" | "REACTIVATE";
+    }
+  | {
+      allowed: false;
+      reason: ChildMembershipViolation;
+    };
+
+export type ChildMembershipWithdrawalEvaluation =
+  | {
+      allowed: true;
+      operation: "WITHDRAW";
+    }
+  | {
+      allowed: false;
+      reason: ChildMembershipViolation;
+    };
+
+// DB由来でも未知の状態は許可しない。nullだけを未所属の明示値として扱う。
+function isMembershipStatus(value: unknown): value is ClubMembershipStatus {
+  return value === "ACTIVE" ||
+    value === "WITHDRAWN" ||
+    value === "INVITED" ||
+    value === "SUSPENDED";
+}
+
+// 新規所属、WITHDRAWNの再有効化だけを許可し、停止・招待中を自己解除しない。
+export function evaluateChildMembershipAddition(input: {
+  status: unknown;
+}): ChildMembershipAdditionEvaluation {
+  if (input.status === null) {
+    return {
+      allowed: true,
+      operation: "CREATE",
+    };
+  }
+  if (!isMembershipStatus(input.status)) {
+    return {
+      allowed: false,
+      reason: "INVALID_STATUS",
+    };
+  }
+  if (input.status === "WITHDRAWN") {
+    return {
+      allowed: true,
+      operation: "REACTIVATE",
+    };
+  }
+
+  return {
+    allowed: false,
+    reason: input.status === "ACTIVE" ? "ALREADY_ACTIVE" : "STATUS_CHANGE_NOT_ALLOWED",
+  };
+}
+
+// 現在のACTIVE所属だけを外す。Child本体や他クラブ所属の削除は表現しない。
+export function evaluateChildMembershipWithdrawal(input: {
+  status: unknown;
+}): ChildMembershipWithdrawalEvaluation {
+  if (input.status === null) {
+    return {
+      allowed: false,
+      reason: "MEMBERSHIP_NOT_FOUND",
+    };
+  }
+  if (!isMembershipStatus(input.status)) {
+    return {
+      allowed: false,
+      reason: "INVALID_STATUS",
+    };
+  }
+  if (input.status === "ACTIVE") {
+    return {
+      allowed: true,
+      operation: "WITHDRAW",
+    };
+  }
+
+  return {
+    allowed: false,
+    reason: input.status === "WITHDRAWN" ? "ALREADY_WITHDRAWN" : "STATUS_CHANGE_NOT_ALLOWED",
+  };
+}
