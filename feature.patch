+// domain/club/member/member-toast.ts
+// メンバー管理ページのURL識別子を固定メッセージへ変換する
+
+export type ClubMembersToastCode =
+  "member-updated";
+
+export function getClubMembersToastMessage(
+  value:
+    | string
+    | string[]
+    | undefined,
+): string | null {
+  if (
+    value === "member-updated"
+  ) {
+    return "メンバー情報を変更しました。";
+  }
+
+  return null;
+}
