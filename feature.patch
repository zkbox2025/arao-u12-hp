+/// 【追加】前月イベント複製と同一transactionで保存する完了記録。途中状態は保存しない。
+/// 【追加】本文を保存せず、再送時の照合値と完了結果だけを保持する。
+model ClubEventBatchOperation { // 【追加】クラブ単位の一括操作の冪等性・完了結果を保持するモデル
+  id        String   @id @default(uuid()) // 【追加】操作記録IDの文字列型 / UUIDを生成するPrisma関数
+  createdAt DateTime @default(now()) // 【追加】記録日時の型 / 現在時刻を設定するPrisma関数
+
+  clubId String // 【追加】所属クラブIDの文字列型
+  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade) // 【追加】クラブ削除時だけ記録も削除するrelation型
+
+  requestId   String // 【追加】小文字UUID v4の操作識別子の文字列型。SQL CHECKでも検証する
+  operation   String // 【追加】COPY_PREVIOUS_MONTHだけを許す操作種別の文字列型。SQL CHECKで限定する
+  targetMonth String // 【追加】前月を表現できるYYYY-MMの文字列型。SQL CHECKで検証する
+  inputHash   String // 【追加】正規化済み実行入力の小文字SHA-256文字列型。本文は保存しない
+
+  /// 【追加】新規保存時は認可済み実行者を設定し、Membership削除後だけnullの履歴を保持する。
+  executedByMembershipId String? // 【追加】履歴参照解除を許す実行Membership IDのnullable文字列型
+  executedByMembership   ClubMembership? @relation(fields: [executedByMembershipId], references: [id], onDelete: SetNull) // 【追加】実行者削除時に参照IDだけをnullにするrelation型
+
+  createdCount Int // 【追加】完了した作成件数の整数型。SQL CHECKで1〜100件に限定する
+  completedAt  DateTime // 【追加】保存完了日時の必須型。未完了の記録を先に作らない
+
+  @@unique([clubId, requestId]) // 【追加】同じクラブ内の操作識別子を一意にする
+  @@index([executedByMembershipId]) // 【追加】実行者削除時のSetNull対象を検索する索引
+}
