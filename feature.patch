+  ])("不正なattemptCountを送信前に拒否する", async (attemptCount) => {
+    await expect(
+      sendClubInvitationEmail({
+        ...newUserInput(),
+        invitationId: INVITATION_ID,
+        attemptCount,
+      }),
+    ).rejects.toMatchObject({
