@@ -0,0 +1,224 @@
+// app/api/line/webhook/[webhookKey]/route.ts
+// クラブ別LINE Messaging API Webhookの受付口
+
+import "server-only";
+
+import {
+  NextResponse,
+} from "next/server";
+
+import {
+  flushLogs,
+  logError,
+  logInfo,
+  logWarn,
+} from "@/lib/axiom/server";
+
+import {
+  handleClubLineWebhook,
+  type HandleClubLineWebhookResult,
+} from "@/src/application/club/line/handle-club-line-webhook";
+
+export const runtime =
+  "nodejs";
+
+export const dynamic =
+  "force-dynamic";
+
+type ClubLineWebhookRouteContext = {
+  params: Promise<{
+    webhookKey: string;
+  }>;
+};
+
+function writeSafeWebhookLog(
+  result:
+    HandleClubLineWebhookResult,
+): void {
+  /*
+   * outcomeとHTTP statusだけを記録する。
+   * webhookKey、署名、本文、登録コード、tokenHash、
+   * lineGroupId、資格情報はログへ渡さない。
+   */
+  const fields = {
+    outcome:
+      result.outcome,
+    status:
+      result.status,
+  };
+
+  if (result.status === 200) {
+    logInfo(
+      "club_line_webhook_processed",
+      fields,
+    );
+    return;
+  }
+
+  if (result.status >= 500) {
+    logError(
+      "club_line_webhook_unavailable",
+      fields,
+    );
+    return;
+  }
+
+  logWarn(
+    "club_line_webhook_rejected",
+    fields,
+  );
+}
+
+function buildPublicResponse(
+  result:
+    HandleClubLineWebhookResult,
+) {
+  switch (result.status) {
+    case 200:
+      return NextResponse.json(
+        { ok: true },
+        { status: 200 },
+      );
+
+    case 400:
+      return NextResponse.json(
+        {
+          ok: false,
+          message:
+            "Invalid request",
+        },
+        { status: 400 },
+      );
+
+    case 401:
+      return NextResponse.json(
+        {
+          ok: false,
+          message:
+            "Unauthorized",
+        },
+        { status: 401 },
+      );
+
+    case 403:
+      return NextResponse.json(
+        {
+          ok: false,
+          message: "Forbidden",
+        },
+        { status: 403 },
+      );
+
+    case 404:
+      return NextResponse.json(
+        {
+          ok: false,
+          message: "Not found",
+        },
+        { status: 404 },
+      );
+
+    case 413:
+      return NextResponse.json(
+        {
+          ok: false,
+          message:
+            "Payload too large",
+        },
+        { status: 413 },
+      );
+
+    case 503:
+      return NextResponse.json(
+        {
+          ok: false,
+          message:
+            "Service unavailable",
+        },
+        { status: 503 },
+      );
+
+    default: {
+      const exhaustiveCheck:
+        never = result;
+
+      return exhaustiveCheck;
+    }
+  }
+}
+
+export async function POST(
+  request: Request,
+  context:
+    ClubLineWebhookRouteContext,
+) {
+  const {
+    webhookKey,
+  } = await context.params;
+
+  let rawBody: string;
+
+  try {
+    /*
+     * 署名検証に使うため、json()ではなく
+     * 受信した本文を一度だけtext()で読む。
+     */
+    rawBody =
+      await request.text();
+  } catch {
+    logWarn(
+      "club_line_webhook_rejected",
+      {
+        outcome:
+          "INVALID_REQUEST",
+        status: 400,
+      },
+    );
+
+    await flushLogs();
+
+    return NextResponse.json(
+      {
+        ok: false,
+        message:
+          "Invalid request",
+      },
+      { status: 400 },
+    );
+  }
+
+  let result:
+    HandleClubLineWebhookResult;
+
+  try {
+    result =
+      await handleClubLineWebhook({
+        webhookKey,
+        signature:
+          request.headers.get(
+            "x-line-signature",
+          ),
+        rawBody,
+      });
+  } catch {
+    /*
+     * 想定外の例外内容をログへ渡さず、
+     * LINE側が再送できる503へ正規化する。
+     */
+    result = {
+      status: 503,
+      outcome:
+        "SERVICE_UNAVAILABLE",
+    };
+  }
+
+  writeSafeWebhookLog(
+    result,
+  );
+
+  await flushLogs();
+
+  return buildPublicResponse(
+    result,
+  );
+}
