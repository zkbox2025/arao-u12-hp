+// tests/event-practice-batch-form.test.ts
+// DB・Auth・Nextへ接続せず、定期練習入力の信頼境界と限定結果型を検証する。
+
+import {
+  expect,
+  expectTypeOf,
+  it,
+} from "vitest";
+
