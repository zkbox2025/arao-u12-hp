+// src/application/club/account/update-club-account.ts
+// 認可済み本人contextと許可された入力だけをRepositoryへ渡し、内部の更新結果を返す。
+
+import "server-only";
+
+import type {
+  ClubAccessContext,
+} from "@/app/(club-app)/club/club-membership-authorization";
+import {
+  validateAccountNameInput,
+  type AccountNameFormValues,
+} from "@/domain/club/account/account-form";
+import type {
+  ClubAccountMutationResult,
+} from "@/domain/club/account/account-types";
+import {
+  validateChildIdInput,
+  validateChildInput,
+} from "@/domain/club/account/child-form";
+import {
+  updateAccountNameForUser,
+  type ClubAccountReadScope,
+} from "@/src/infrastructure/prisma/repositories/club-account-repository";
+import {
+  addChildToClubForUser,
+  createChildForUser,
+  updateChildForUser,
+  withdrawChildFromClubForUser,
+  type ChildForUserInput,
+  type ChildMembershipForUserInput,
+} from "@/src/infrastructure/prisma/repositories/club-child-repository";
+
+export type ClubChildValues = Pick<ChildForUserInput, "childId" | "name" | "grade">;
+export type ClubChildMembershipValues = Pick<ChildMembershipForUserInput, "childId">;
+
+// Repositoryの固定結果だけを投影し、入力由来のslug・任意のメッセージを返さない。
+async function runAccountMutation(
+  context: ClubAccessContext,
+  operation: (scope: ClubAccountReadScope) => Promise<ClubAccountMutationResult>,
+): Promise<ClubAccountMutationResult> {
+  try {
+    const result = await operation({
+      clubId: context.club.id,
+      actorMembershipId: context.membership.id,
+      userId: context.userId,
+    });
+    switch (result.outcome) {
+      case "UPDATED":
+        return {
+          outcome: "UPDATED",
+          affectedClubSlugs: [...new Set(result.affectedClubSlugs)],
+        };
+      case "NOT_FOUND":
+      case "FORBIDDEN":
+      case "CONFLICT":
+      case "UPDATE_FAILED":
+        return {
+          outcome: result.outcome,
+        };
+      case "RULE_VIOLATION":
+        switch (result.reason) {
+          case "ALREADY_ACTIVE":
+          case "ALREADY_WITHDRAWN":
+          case "MEMBERSHIP_NOT_FOUND":
+          case "STATUS_CHANGE_NOT_ALLOWED":
+          case "INVALID_STATUS":
+            return {
+              outcome: "RULE_VIOLATION",
+              reason: result.reason,
+            };
+        }
+    }
+  } catch {
+    // 例外を自動再試行せず、DomainErrorの原文・causeも公開しない。
+  }
+  return {
+    outcome: "UPDATE_FAILED",
+  };
+}
+
+// 本人氏名だけを渡す。影響クラブはRepositoryが本人の全所属から取得する。
+export async function updateClubAccountName(
+  context: ClubAccessContext,
+  input: AccountNameFormValues,
+): Promise<ClubAccountMutationResult> {
+  const validation = validateAccountNameInput(input);
+  if (!validation.success) {
+    return {
+      outcome: "UPDATE_FAILED",
+    };
+  }
+  return runAccountMutation(context, (scope) => updateAccountNameForUser({
+    ...scope,
+    name: validation.data.name,
+  }));
+}
+
+// 作成・編集に必要な3項目だけを検証し、親・クラブ・状態を入力からコピーしない。
+async function saveClubChild(
+  context: ClubAccessContext,
+  input: ClubChildValues,
+  operation: typeof createChildForUser,
+): Promise<ClubAccountMutationResult> {
+  const validation = validateChildInput(input);
+  const id = validateChildIdInput(input?.childId);
+  if (
+    !validation.success ||
+    !id.success
+  ) {
+    return {
+      outcome: "UPDATE_FAILED",
+    };
+  }
+  return runAccountMutation(context, (scope) => operation({
+    ...scope,
+    childId: id.data.childId,
+    name: validation.data.name,
+    grade: validation.data.grade,
+  }));
+}
+
+// 作成識別子は同じフォームの再送で変えず、現在クラブの初回所属と一体作成する。
+export async function createClubChild(
+  context: ClubAccessContext,
+  input: ClubChildValues,
+): Promise<ClubAccountMutationResult> {
+  return saveClubChild(context, input, createChildForUser);
+}
+
+// グローバルChildを編集し、関連クラブのaccount再検証用slugを内部結果に残す。
+export async function updateClubChild(
+  context: ClubAccessContext,
+  input: ClubChildValues,
+): Promise<ClubAccountMutationResult> {
+  return saveClubChild(context, input, updateChildForUser);
+}
+
+// 所属操作に氏名・学年・親・clubIdを受け渡さず、対象IDだけを検証する。
+async function changeClubChildMembership(
+  context: ClubAccessContext,
+  input: ClubChildMembershipValues,
+  operation: typeof addChildToClubForUser,
+): Promise<ClubAccountMutationResult> {
+  const validation = validateChildIdInput(input?.childId);
+  if (!validation.success) {
+    return {
+      outcome: "UPDATE_FAILED",
+    };
+  }
+  return runAccountMutation(context, (scope) => operation({
+    ...scope,
+    childId: validation.data.childId,
+  }));
+}
+
+// 本人の既存Childを現在クラブへ追加する。状態遷移はRepositoryで再照合する。
+export async function addClubChild(
+  context: ClubAccessContext,
+  input: ClubChildMembershipValues,
+): Promise<ClubAccountMutationResult> {
+  return changeClubChildMembership(context, input, addChildToClubForUser);
+}
+
+// 現在クラブからの解除だけを行い、Child本体や他クラブには変更を広げない。
+export async function withdrawClubChild(
+  context: ClubAccessContext,
+  input: ClubChildMembershipValues,
+): Promise<ClubAccountMutationResult> {
+  return changeClubChildMembership(context, input, withdrawChildFromClubForUser);
+}
