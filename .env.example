// ローカル環境用の.env.ファイルの見本（ギットハブにプッシュ用）

# -----------------------------------------------------------------------------
# アプリケーション共通・データベース設定 (Template)
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase 設定
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# アプリケーション固有設定
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
WEBSITE_ADMIN_USER_IDS=

# メール送信設定 (Resend)
RESEND_API_KEY=
MAIL_FROM=

# セキュリティ・スパム対策
FORM_LOG_HASH_SALT=
CRON_SECRET=

# LINE 通知・連携設定
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_GROUP_ID=
APP_BASE_URL=

# LINE LIFF 設定
NEXT_PUBLIC_LIFF_ID=
LINE_LIFF_URL=
NEXT_PUBLIC_LIFF_DEBUG=

# ローカル開発用シード
SEED_DEV_CLUB_NAME=
SEED_DEV_CLUB_SLUG=
SEED_DEV_CLUB_PLAN=
SEED_DEV_OWNER_AUTH_USER_ID=
SEED_DEV_OWNER_NAME=
SEED_DEV_OWNER_EMAIL=

# LINE連携で使う大切な情報（アクセストークンなど）をデータベースに保存する際、
# ハッカーに盗まれないように暗号化（スクランブル）するための専用の暗号鍵
LINE_CREDENTIAL_ENCRYPTION_KEY=

