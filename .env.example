# .env.example

# =============================================================================
# 全環境で必須
# =============================================================================

# Prisma・PostgreSQL
DATABASE_URL=


# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# アプリケーションURL
# ローカル例: http://localhost:3000
# 本番例: https://example.com
APP_BASE_URL=http://localhost:3000

# 既存HP管理者認可
# カンマ区切りのSupabase Auth UUID
WEBSITE_ADMIN_USER_IDS=

# フォームログのハッシュ化
# openssl rand -base64 32 などで作成する
FORM_LOG_HASH_SALT=

# クラブ別LINE資格情報の暗号化キー
# 必ず32バイトのBase64
# openssl rand -base64 32 で作成する
LINE_CREDENTIAL_ENCRYPTION_KEY=

# =============================================================================
# 本番環境で必須
# =============================================================================

# Vercel Cron共通認証
# openssl rand -base64 32 などで作成する
CRON_SECRET=

# Resend
RESEND_API_KEY=

# 【変更】MAIL_FROMは廃止。メールアドレスだけを設定する
# 例: no-reply@example.com
MAIL_FROM_ADDRESS=

# =============================================================================
# 任意
# =============================================================================

# HP用通知先
ADMIN_EMAIL=

# 既存HP用LINE通知
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_GROUP_ID=

# 既存の単一クラブ用Webhook（移行期間中のみ）
# クラブ運営アプリの新WebhookはDBの暗号化済みSecretを使用する
LINE_CHANNEL_SECRET=

# LIFF
NEXT_PUBLIC_LIFF_ID=
LINE_LIFF_URL=
NEXT_PUBLIC_LIFF_DEBUG=false

# Axiom
AXIOM_TOKEN=
AXIOM_DATASET=

# =============================================================================
# ローカル開発専用
# =============================================================================

SEED_DEV_CLUB_NAME=
SEED_DEV_CLUB_SLUG=
SEED_DEV_CLUB_PLAN=
SEED_DEV_OWNER_AUTH_USER_ID=
SEED_DEV_OWNER_NAME=
SEED_DEV_OWNER_EMAIL=

WEBSITE_ADMIN_SEED_USER_ID=
WEBSITE_ADMIN_SEED_EMAIL=